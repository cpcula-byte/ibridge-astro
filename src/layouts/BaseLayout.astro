---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  locale?: "zh-tw" | "en";
  canonical?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "iBridge Education",
  description = "iBridge Education connects international education, educational research and practical innovation.",
  locale = "zh-tw",
  canonical,
  image = "/favicon.svg",
  noindex = false,
} = Astro.props;

const siteUrl = "https://ibridge.info";
const pathname = Astro.url.pathname;

const isEnglish =
  locale === "en" ||
  pathname === "/en" ||
  pathname.startsWith("/en/");

const htmlLanguage = isEnglish ? "en" : "zh-Hant";

const normalisePath = (path: string) => {
  if (!path) return "/";

  const pathWithoutTrailingSlash =
    path.length > 1 && path.endsWith("/")
      ? path.slice(0, -1)
      : path;

  return pathWithoutTrailingSlash || "/";
};

const currentPath = normalisePath(pathname);

const traditionalChinesePath = isEnglish
  ? normalisePath(currentPath.replace(/^\/en(?=\/|$)/, "") || "/")
  : currentPath;

const englishPath = isEnglish
  ? currentPath
  : currentPath === "/"
    ? "/en"
    : `/en${currentPath}`;

const canonicalUrl =
  canonical ??
  `${siteUrl}${currentPath === "/" ? "/" : currentPath}`;

const traditionalChineseUrl =
  `${siteUrl}${
    traditionalChinesePath === "/"
      ? "/"
      : traditionalChinesePath
  }`;

const englishUrl =
  `${siteUrl}${
    englishPath === "/en"
      ? "/en/"
      : englishPath
  }`;

const socialImageUrl = image.startsWith("http")
  ? image
  : `${siteUrl}${image.startsWith("/") ? image : `/${image}`}`;

const fullTitle =
  title === "iBridge Education"
    ? title
    : `${title} | iBridge Education`;

const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large";
---

<!doctype html>
<html lang={htmlLanguage}>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="robots"
      content={robotsContent}
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="theme-color"
      content="#0b6675"
    />

    <meta
      name="color-scheme"
      content="light"
    />

    <title>{fullTitle}</title>

    <link
      rel="canonical"
      href={canonicalUrl}
    />

    <link
      rel="alternate"
      hreflang="zh-Hant"
      href={traditionalChineseUrl}
    />

    <link
      rel="alternate"
      hreflang="en"
      href={englishUrl}
    />

    <link
      rel="alternate"
      hreflang="x-default"
      href={traditionalChineseUrl}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="manifest"
      href="/site.webmanifest"
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content="iBridge Education"
    />

    <meta
      property="og:title"
      content={fullTitle}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="og:image"
      content={socialImageUrl}
    />

    <meta
      property="og:locale"
      content={isEnglish ? "en_US" : "zh_TW"}
    />

    <meta
      property="og:locale:alternate"
      content={isEnglish ? "zh_TW" : "en_US"}
    />

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={fullTitle}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={socialImageUrl}
    />

    <slot name="head" />
  </head>

  <body>
    <a
      class="skip-link"
      href="#main-content"
    >
      {isEnglish ? "Skip to main content" : "跳至主要內容"}
    </a>

    <Header locale={isEnglish ? "en" : "zh-tw"} />

    <main id="main-content">
      <slot />
    </main>

    <Footer locale={isEnglish ? "en" : "zh-tw"} />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 96px;
  }

  body {
    min-width: 320px;
    margin: 0;
    background: #ffffff;
    color: #102f50;
  }

  main {
    min-height: 60vh;
  }

  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 9999;
    padding: 12px 18px;
    border-radius: 8px;
    background: #ffffff;
    color: #073b62;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 12px 32px rgba(7, 47, 76, 0.2);
    transform: translateY(-160%);
    transition: transform 160ms ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>