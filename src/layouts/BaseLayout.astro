---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
import "../styles/global.css";

interface Props {
  /**
   * 頁面標題。
   *
   * 繁中範例：
   * title="關於我們"
   *
   * 英文範例：
   * title="About Us"
   */
  title?: string;

  /**
   * 頁面描述，用於 Google 搜尋結果及社群分享。
   */
  description?: string;

  /**
   * 頁面語言。
   */
  locale?: "zh-tw" | "en";

  /**
   * 對應的繁中頁面路徑。
   *
   * 例如：
   * 首頁：/
   * 關於我們：/about
   * 資源中心：/resources
   */
  zhPath?: string;

  /**
   * 對應的英文頁面路徑。
   *
   * 例如：
   * 首頁：/en/
   * 關於我們：/en/about
   * 資源中心：/en/resources
   */
  enPath?: string;

  /**
   * 社群分享圖片。
   *
   * 目前可以使用：
   * /favicon.svg
   *
   * 日後可更換為：
   * /images/og-default.png
   */
  image?: string;

  /**
   * 是否禁止搜尋引擎建立索引。
   *
   * 404 頁面應使用：
   * noindex={true}
   */
  noindex?: boolean;

  /**
   * Open Graph 頁面類型。
   */
  type?: "website" | "article";

  /**
   * 文章發布日期。
   * 只用於 type="article"。
   */
  publishedTime?: string;

  /**
   * 文章最後更新日期。
   * 只用於 type="article"。
   */
  modifiedTime?: string;
}

const pathname = Astro.url.pathname;

const pathnameIsEnglish =
  pathname === "/en" ||
  pathname === "/en/" ||
  pathname.startsWith("/en/");

const requestedLocale = Astro.props.locale;

const isEnglish =
  requestedLocale === "en" ||
  (requestedLocale !== "zh-tw" && pathnameIsEnglish);

const resolvedLocale: "zh-tw" | "en" =
  isEnglish ? "en" : "zh-tw";

const defaultTitle = isEnglish
  ? "iBridge Education"
  : "iBridge Education";

const defaultDescription = isEnglish
  ? "iBridge Education connects international education, educational research and practical innovation."
  : "iBridge Education 連結國際教育、教育研究與實務創新，協助學校、教師與學生建立更深入且更具韌性的學習經驗。";

const {
  title = defaultTitle,
  description = defaultDescription,
  zhPath,
  enPath,
  image = "/favicon.svg",
  noindex = false,
  type = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;

const htmlLanguage = isEnglish
  ? "en"
  : "zh-Hant";
---

<!doctype html>

<html lang={htmlLanguage}>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="color-scheme"
      content="light"
    />

    <meta
      name="format-detection"
      content="telephone=no"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="manifest"
      href="/site.webmanifest"
    />

    <SEO
      title={title}
      description={description}
      locale={resolvedLocale}
      zhPath={zhPath}
      enPath={enPath}
      image={image}
      noindex={noindex}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />

    <!--
      個別頁面可以使用 slot="head" 加入額外內容。

      範例：

      <Fragment slot="head">
        <meta name="keywords" content="..." />
      </Fragment>
    -->
    <slot name="head" />
  </head>

  <body>
    <a
      class="skip-link"
      href="#main-content"
    >
      {
        isEnglish
          ? "Skip to main content"
          : "跳至主要內容"
      }
    </a>

    <Header locale={resolvedLocale} />

    <main id="main-content">
      <slot />
    </main>

    <Footer locale={resolvedLocale} />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 96px;
  }

  body {
    min-width: 320px;
    margin: 0;
    background: #ffffff;
    color: #102f50;
  }

  main {
    min-height: 60vh;
  }

  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 9999;
    padding: 12px 18px;
    border: 0;
    border-radius: 8px;
    background: #ffffff;
    color: #073b62;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 12px 32px rgba(7, 47, 76, 0.2);
    transform: translateY(-160%);
    transition: transform 160ms ease;
  }

  .skip-link:focus {
    transform: translateY(0);
    outline: 3px solid #0b6675;
    outline-offset: 3px;
  }
</style>