---
interface Props {
  locale?: "zh-tw" | "en";
}

const {
  locale = "zh-tw",
} = Astro.props;

const isEnglish = locale === "en";

const currentYear = new Date().getFullYear();

const content = isEnglish
  ? {
      brandLabel: "iBridge Education English homepage",
      tagline: "Learning · Research · Innovation",
      description:
        "Connecting international education, curriculum design, educational research and practical innovation to support schools, educators and learners.",
      exploreTitle: "Explore",
      resourcesTitle: "Resources",
      contactTitle: "Contact",
      legalTitle: "Information",
      home: "Home",
      about: "About",
      services: "Services",
      programmes: "Programmes",
      research: "Research",
      resources: "Resources",
      contact: "Contact",
      privacy: "Privacy Policy",
      email: "Email",
      website: "Website",
      serviceArea: "Service Area",
      serviceAreaValue: "Taiwan and international partnerships",
      copyright: `© ${currentYear} iBridge Education. All rights reserved.`,
      languageSwitch: "繁體中文",
      languageSwitchLabel: "切換至繁體中文",
      homePath: "/en/",
      aboutPath: "/en/about/",
      servicesPath: "/en/services/",
      programmesPath: "/en/programmes/",
      researchPath: "/en/research/",
      resourcesPath: "/en/resources/",
      contactPath: "/en/contact/",
      privacyPath: "/en/privacy/",
      languagePath: "/",
    }
  : {
      brandLabel: "iBridge Education 繁體中文首頁",
      tagline: "學習 · 研究 · 創新",
      description:
        "連結國際教育、課程設計、教育研究與實務創新，為學校、教師與學習者提供專業支持。",
      exploreTitle: "探索網站",
      resourcesTitle: "教育內容",
      contactTitle: "聯絡資訊",
      legalTitle: "網站資訊",
      home: "首頁",
      about: "關於我們",
      services: "服務",
      programmes: "課程方案",
      research: "教育研究",
      resources: "教育資源",
      contact: "聯絡我們",
      privacy: "隱私權政策",
      email: "電子郵件",
      website: "網站",
      serviceArea: "服務區域",
      serviceAreaValue: "臺灣及國際合作",
      copyright: `© ${currentYear} iBridge Education。保留所有權利。`,
      languageSwitch: "English",
      languageSwitchLabel: "Switch to English",
      homePath: "/",
      aboutPath: "/about/",
      servicesPath: "/services/",
      programmesPath: "/programmes/",
      researchPath: "/research/",
      resourcesPath: "/resources/",
      contactPath: "/contact/",
      privacyPath: "/privacy/",
      languagePath: "/en/",
    };

const exploreLinks = [
  {
    label: content.home,
    href: content.homePath,
  },
  {
    label: content.about,
    href: content.aboutPath,
  },
  {
    label: content.services,
    href: content.servicesPath,
  },
  {
    label: content.contact,
    href: content.contactPath,
  },
];

const resourceLinks = [
  {
    label: content.programmes,
    href: content.programmesPath,
  },
  {
    label: content.research,
    href: content.researchPath,
  },
  {
    label: content.resources,
    href: content.resourcesPath,
  },
];

const legalLinks = [
  {
    label: content.privacy,
    href: content.privacyPath,
  },
];
---

<footer class="site-footer">
  <div class="footer-accent" aria-hidden="true"></div>

  <div class="footer-main">
    <div class="footer-container footer-grid">
      <section class="footer-brand">
        <a
          class="footer-logo"
          href={content.homePath}
          aria-label={content.brandLabel}
        >
          <span class="footer-logo-main">
            iBridge
          </span>

          <span class="footer-logo-secondary">
            Education
          </span>
        </a>

        <p class="footer-tagline">
          {content.tagline}
        </p>

        <p class="footer-description">
          {content.description}
        </p>

        <a
          class="language-link"
          href={content.languagePath}
          aria-label={content.languageSwitchLabel}
          hreflang={isEnglish ? "zh-Hant" : "en"}
        >
          <span aria-hidden="true">文</span>
          {content.languageSwitch}
        </a>
      </section>

      <nav
        class="footer-column"
        aria-label={content.exploreTitle}
      >
        <h2>
          {content.exploreTitle}
        </h2>

        <ul>
          {
            exploreLinks.map((link) => (
              <li>
                <a href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav
        class="footer-column"
        aria-label={content.resourcesTitle}
      >
        <h2>
          {content.resourcesTitle}
        </h2>

        <ul>
          {
            resourceLinks.map((link) => (
              <li>
                <a href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section class="footer-column footer-contact">
        <h2>
          {content.contactTitle}
        </h2>

        <dl>
          <div>
            <dt>{content.email}</dt>

            <dd>
              <a href="mailto:hello@ibridge.info">
                hello@ibridge.info
              </a>
            </dd>
          </div>

          <div>
            <dt>{content.website}</dt>

            <dd>
              <a href="https://ibridge.info">
                ibridge.info
              </a>
            </dd>
          </div>

          <div>
            <dt>{content.serviceArea}</dt>

            <dd>
              {content.serviceAreaValue}
            </dd>
          </div>
        </dl>
      </section>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-container footer-bottom-inner">
      <p>
        {content.copyright}
      </p>

      <nav
        class="footer-legal"
        aria-label={content.legalTitle}
      >
        <ul>
          {
            legalLinks.map((link) => (
              <li>
                <a href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: #7b1422;
    color: #ffffff;
  }

  .footer-accent {
    width: 100%;
    height: 5px;
    background:
      linear-gradient(
        90deg,
        #c48a2c 0%,
        #c48a2c 18%,
        #a51c30 18%,
        #a51c30 58%,
        #315c6b 58%,
        #315c6b 100%
      );
  }

  .footer-main {
    position: relative;
    padding: 76px 0 66px;
  }

  .footer-main::before {
    position: absolute;
    top: -260px;
    right: -210px;
    width: 520px;
    height: 520px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    content: "";
    pointer-events: none;
  }

  .footer-main::after {
    position: absolute;
    right: 80px;
    bottom: -220px;
    width: 360px;
    height: 360px;
    border: 1px solid rgba(196, 138, 44, 0.15);
    border-radius: 999px;
    content: "";
    pointer-events: none;
  }

  .footer-container {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns:
      minmax(260px, 1.55fr)
      minmax(145px, 0.72fr)
      minmax(145px, 0.72fr)
      minmax(220px, 1fr);
    gap: 56px;
    align-items: start;
  }

  .footer-brand {
    max-width: 430px;
  }

  .footer-logo {
    display: inline-flex;
    flex-direction: column;
    color: #ffffff;
    line-height: 0.9;
    text-decoration: none;
  }

  .footer-logo-main {
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.055em;
  }

  .footer-logo-secondary {
    margin-top: 8px;
    color: #f2c66d;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .footer-tagline {
    margin: 24px 0 0;
    color: #f2c66d;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .footer-description {
    max-width: 420px;
    margin: 20px 0 0;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.96rem;
    line-height: 1.8;
  }

  .language-link {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    gap: 9px;
    margin-top: 28px;
    padding: 0 17px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    color: #ffffff;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background 160ms ease,
      color 160ms ease;
  }

  .language-link span {
    color: #f2c66d;
  }

  .language-link:hover {
    border-color: #c48a2c;
    background: #c48a2c;
    color: #1f2933;
  }

  .language-link:hover span {
    color: #1f2933;
  }

  .footer-column h2 {
    margin: 3px 0 22px;
    color: #f2c66d;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-column ul {
    display: grid;
    gap: 13px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-column li {
    margin: 0;
  }

  .footer-column a {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.94rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-column a:hover {
    color: #ffffff;
  }

  .footer-contact dl {
    display: grid;
    gap: 20px;
    margin: 0;
  }

  .footer-contact dl > div {
    display: grid;
    gap: 5px;
  }

  .footer-contact dt {
    color: #f2c66d;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-contact dd {
    margin: 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .footer-contact dd a {
    overflow-wrap: anywhere;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(70, 9, 19, 0.26);
  }

  .footer-bottom-inner {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .footer-bottom p {
    margin: 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.8rem;
  }

  .footer-legal ul {
    display: flex;
    align-items: center;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-legal a {
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .footer-legal a:hover {
    color: #ffffff;
  }

  @media (max-width: 980px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }

    .footer-contact {
      grid-column: 1 / -1;
    }

    .footer-contact dl {
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
    }
  }

  @media (max-width: 720px) {
    .footer-main {
      padding: 62px 0 52px;
    }

    .footer-container {
      width: min(100% - 30px, 1180px);
    }

    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 46px 30px;
    }

    .footer-brand {
      grid-column: 1 / -1;
      max-width: none;
    }

    .footer-contact {
      grid-column: 1 / -1;
    }

    .footer-contact dl {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .footer-bottom-inner {
      min-height: auto;
      align-items: flex-start;
      flex-direction: column;
      padding-top: 24px;
      padding-bottom: 24px;
    }

    .footer-legal ul {
      flex-wrap: wrap;
      gap: 14px 22px;
    }
  }

  @media (max-width: 460px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-brand,
    .footer-contact {
      grid-column: auto;
    }
  }
</style>