---
interface Props {
  locale?: "zh-tw" | "en";
}

const { locale } = Astro.props;

const pathname = Astro.url.pathname;

const isEnglish =
  locale === "en" ||
  pathname === "/en" ||
  pathname.startsWith("/en/");

const currentYear = new Date().getFullYear();

const footerContent = isEnglish
  ? {
      homeLabel: "iBridge Education English homepage",
      description:
        "Connecting international education, educational research and practical innovation to support schools, teachers and learners.",
      tagline: "Learning · Research · Innovation",

      navigationTitle: "Explore",
      navigation: [
        {
          label: "Home",
          href: "/en/",
        },
        {
          label: "About",
          href: "/en/about",
        },
        {
          label: "Services",
          href: "/en/services",
        },
        {
          label: "Programmes",
          href: "/en/programmes",
        },
        {
          label: "Research",
          href: "/en/research",
        },
        {
          label: "Resources",
          href: "/en/resources",
        },
        {
          label: "Contact",
          href: "/en/contact",
        },
      ],

      resourcesTitle: "Resources",
      resources: [
        {
          label: "Programmes",
          href: "/en/programmes",
        },
        {
          label: "Resource Centre",
          href: "/en/resources",
        },
        {
          label: "Research",
          href: "/en/research",
        },
        {
          label: "Contact Us",
          href: "/en/contact",
        },
      ],

      contactTitle: "Contact",
      emailLabel: "Email",
      websiteLabel: "Website",
      locationLabel: "Service Area",
      location: "Taiwan and international collaboration",

      privacyLabel: "Privacy Notice",
      privacyHref: "/en/contact#privacy",

      languageLabel: "繁體中文",
      languageHref: "/",

      copyright: `© ${currentYear} iBridge Education. All rights reserved.`,
    }
  : {
      homeLabel: "iBridge Education 首頁",
      description:
        "連結國際教育、教育研究與實務創新，協助學校、教師與學生建立面向未來的學習經驗。",
      tagline: "學習 · 研究 · 創新",

      navigationTitle: "網站",
      navigation: [
        {
          label: "首頁",
          href: "/",
        },
        {
          label: "關於我們",
          href: "/about",
        },
        {
          label: "服務",
          href: "/services",
        },
        {
          label: "課程與方案",
          href: "/programmes",
        },
        {
          label: "研究",
          href: "/research",
        },
        {
          label: "資源",
          href: "/resources",
        },
        {
          label: "聯絡我們",
          href: "/contact",
        },
      ],

      resourcesTitle: "資源",
      resources: [
        {
          label: "課程與方案",
          href: "/programmes",
        },
        {
          label: "資源中心",
          href: "/resources",
        },
        {
          label: "教育研究",
          href: "/research",
        },
        {
          label: "聯絡我們",
          href: "/contact",
        },
      ],

      contactTitle: "聯絡方式",
      emailLabel: "電子郵件",
      websiteLabel: "網站",
      locationLabel: "服務地區",
      location: "台灣及國際線上合作",

      privacyLabel: "隱私權說明",
      privacyHref: "/contact#privacy",

      languageLabel: "English",
      languageHref: "/en/",

      copyright: `© ${currentYear} iBridge Education。保留所有權利。`,
    };
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-container">
      <section class="footer-brand">
        <a
          class="footer-logo"
          href={isEnglish ? "/en/" : "/"}
          aria-label={footerContent.homeLabel}
        >
          <span class="footer-logo-mark" aria-hidden="true">iB</span>

          <span class="footer-logo-name">
            iBridge Education
          </span>
        </a>

        <p class="footer-tagline">
          {footerContent.tagline}
        </p>

        <p class="footer-description">
          {footerContent.description}
        </p>
      </section>

      <nav
        class="footer-column"
        aria-label={footerContent.navigationTitle}
      >
        <h2>{footerContent.navigationTitle}</h2>

        <ul>
          {
            footerContent.navigation.map((item) => (
              <li>
                <a href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav
        class="footer-column"
        aria-label={footerContent.resourcesTitle}
      >
        <h2>{footerContent.resourcesTitle}</h2>

        <ul>
          {
            footerContent.resources.map((item) => (
              <li>
                <a href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section class="footer-column footer-contact">
        <h2>{footerContent.contactTitle}</h2>

        <dl>
          <div>
            <dt>{footerContent.emailLabel}</dt>
            <dd>
              <a href="mailto:hello@ibridge.info">
                hello@ibridge.info
              </a>
            </dd>
          </div>

          <div>
            <dt>{footerContent.websiteLabel}</dt>
            <dd>
              <a href="https://ibridge.info">
                ibridge.info
              </a>
            </dd>
          </div>

          <div>
            <dt>{footerContent.locationLabel}</dt>
            <dd>{footerContent.location}</dd>
          </div>
        </dl>
      </section>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-container">
      <p>{footerContent.copyright}</p>

      <nav
        class="footer-bottom-links"
        aria-label={isEnglish ? "Footer information" : "頁尾資訊"}
      >
        <a href={footerContent.privacyHref}>
          {footerContent.privacyLabel}
        </a>

        <a href={footerContent.languageHref}>
          {footerContent.languageLabel}
        </a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background:
      radial-gradient(
        circle at 90% 12%,
        rgba(22, 145, 151, 0.18),
        transparent 28%
      ),
      linear-gradient(
        145deg,
        #071f3b 0%,
        #082d4f 54%,
        #074e63 100%
      );
    color: #ffffff;
  }

  .footer-main {
    padding: 58px 24px 46px;
  }

  .footer-container {
    width: min(1180px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns:
      minmax(260px, 1.55fr)
      minmax(140px, 0.8fr)
      minmax(150px, 0.9fr)
      minmax(220px, 1fr);
    gap: 48px;
  }

  .footer-brand {
    max-width: 430px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    color: #ffffff;
    text-decoration: none;
  }

  .footer-logo-mark {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 14px;
    background: linear-gradient(
      145deg,
      #15547b,
      #07878a
    );
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.17);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .footer-logo-name {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.22rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .footer-tagline {
    margin: 21px 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .footer-description {
    margin: 12px 0 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.91rem;
    line-height: 1.72;
  }

  .footer-column h2 {
    margin: 0 0 21px;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1rem;
    font-weight: 700;
  }

  .footer-column ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-column li + li {
    margin-top: 12px;
  }

  .footer-column a {
    color: rgba(255, 255, 255, 0.71);
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.5;
    transition:
      color 160ms ease,
      opacity 160ms ease;
  }

  .footer-column a:hover,
  .footer-column a:focus-visible {
    color: #ffffff;
  }

  .footer-contact dl {
    margin: 0;
  }

  .footer-contact dl > div + div {
    margin-top: 16px;
  }

  .footer-contact dt {
    margin-bottom: 3px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.75rem;
  }

  .footer-contact dd {
    margin: 0;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.13);
    background: rgba(2, 18, 34, 0.32);
  }

  .footer-bottom-container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 20px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .footer-bottom p {
    margin: 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.76rem;
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 21px;
  }

  .footer-bottom-links a {
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    font-size: 0.76rem;
  }

  .footer-bottom-links a:hover,
  .footer-bottom-links a:focus-visible {
    color: #ffffff;
  }

  @media (max-width: 980px) {
    .footer-container {
      grid-template-columns: repeat(3, 1fr);
    }

    .footer-brand {
      grid-column: 1 / -1;
      max-width: 680px;
    }
  }

  @media (max-width: 720px) {
    .footer-main {
      padding: 50px 22px 40px;
    }

    .footer-container {
      grid-template-columns: 1fr 1fr;
      gap: 38px 28px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-bottom-container {
      width: min(100% - 44px, 1180px);
      flex-direction: column;
      align-items: flex-start;
      gap: 11px;
    }
  }

  @media (max-width: 500px) {
    .footer-container {
      grid-template-columns: 1fr;
    }

    .footer-brand {
      grid-column: auto;
    }

    .footer-bottom-links {
      flex-wrap: wrap;
    }
  }
</style>