---
const currentPath = Astro.url.pathname;

const isEnglish =
  currentPath === "/en" ||
  currentPath === "/en/" ||
  currentPath.startsWith("/en/");

const homeLink = isEnglish ? "/en/" : "/";
const languageLink = isEnglish ? "/" : "/en/";
const languageLabel = isEnglish ? "中" : "EN";

const navigationItems = isEnglish
  ? [
      {
        label: "About Us",
        href: "/en/about/",
      },
      {
        label: "Services",
        href: "/en/services/",
      },
      {
        label: "Programmes",
        href: "/en/programmes/",
      },
      {
        label: "Educational Research",
        href: "/en/research/",
      },
      {
        label: "Educational Resources",
        href: "/en/resources/",
      },
      {
        label: "Contact Us",
        href: "/en/contact/",
      },
    ]
  : [
      {
        label: "關於我們",
        href: "/about/",
      },
      {
        label: "服務",
        href: "/services/",
      },
      {
        label: "課程方案",
        href: "/programmes/",
      },
      {
        label: "教育研究",
        href: "/research/",
      },
      {
        label: "教育資源",
        href: "/resources/",
      },
      {
        label: "聯絡我們",
        href: "/contact/",
      },
    ];

const normalizePath = (path: string) => {
  if (path === "/") return "/";
  return path.endsWith("/") ? path : `${path}/`;
};

const normalizedCurrentPath = normalizePath(currentPath);

const isActiveLink = (href: string) => {
  const normalizedHref = normalizePath(href);

  if (normalizedHref === "/" || normalizedHref === "/en/") {
    return normalizedCurrentPath === normalizedHref;
  }

  return normalizedCurrentPath.startsWith(normalizedHref);
};
---

<header class="site-header" data-site-header>
  <div class="header-container">
    <a
      class="brand-link"
      href={homeLink}
      aria-label={isEnglish ? "iBridge Education home" : "iBridge Education 首頁"}
    >
      <span class="logo-box" aria-hidden="true">
        <span class="logo-letters">iB</span>
      </span>

      <span class="brand-name">
        <span class="brand-ibridge">iBridge</span>
        <span class="brand-education">Education</span>
      </span>
    </a>

    <button
      class="mobile-menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label={isEnglish ? "Open navigation menu" : "開啟導覽選單"}
      data-menu-button
    >
      <svg
        class="menu-icon menu-open-icon"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>

      <svg
        class="menu-icon menu-close-icon"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <div class="navigation-area">
      <nav
        id="primary-navigation"
        class="site-navigation"
        aria-label={isEnglish ? "Main navigation" : "主要導覽"}
        data-navigation
      >
        <ul class="navigation-list">
          {
            navigationItems.map((item) => (
              <li class="navigation-item">
                <a
                  class:list={[
                    "navigation-link",
                    {
                      active: isActiveLink(item.href),
                    },
                  ]}
                  href={item.href}
                  aria-current={isActiveLink(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a
        class="language-switch"
        href={languageLink}
        lang={isEnglish ? "zh-Hant" : "en"}
        hreflang={isEnglish ? "zh-Hant" : "en"}
        aria-label={
          isEnglish
            ? "切換至繁體中文"
            : "Switch to English"
        }
      >
        {languageLabel}
      </a>
    </div>
  </div>
</header>

<script is:inline>
  document.querySelectorAll("[data-site-header]").forEach((header) => {
    const menuButton = header.querySelector("[data-menu-button]");
    const navigationArea = header.querySelector(".navigation-area");

    if (!(menuButton instanceof HTMLButtonElement)) return;
    if (!(navigationArea instanceof HTMLElement)) return;

    const closeMenu = () => {
      header.classList.remove("menu-is-open");
      menuButton.setAttribute("aria-expanded", "false");
      menuButton.setAttribute(
        "aria-label",
        document.documentElement.lang.startsWith("en")
          ? "Open navigation menu"
          : "開啟導覽選單"
      );
    };

    const openMenu = () => {
      header.classList.add("menu-is-open");
      menuButton.setAttribute("aria-expanded", "true");
      menuButton.setAttribute(
        "aria-label",
        document.documentElement.lang.startsWith("en")
          ? "Close navigation menu"
          : "關閉導覽選單"
      );
    };

    menuButton.addEventListener("click", () => {
      const isOpen = menuButton.getAttribute("aria-expanded") === "true";

      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    header.querySelectorAll(".navigation-link").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu();
      }
    });

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Node)) return;

      if (
        header.classList.contains("menu-is-open") &&
        !header.contains(event.target)
      ) {
        closeMenu();
      }
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 960) {
        closeMenu();
      }
    });
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 1000;
    width: 100%;
    background: rgba(247, 241, 227, 0.97);
    border-bottom: 1px solid #e4d7c5;
    box-shadow: 0 4px 18px rgba(31, 41, 51, 0.05);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header-container {
    width: min(100% - 36px, 1440px);
    min-height: 78px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .brand-link {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #1f2933;
    text-decoration: none;
    border-radius: 12px;
  }

  /*
   * Logo 外框
   * 不使用圖片，避免圖片內部透明留白。
   */
  .logo-box {
    width: 44px;
    height: 44px;
    min-width: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 0;
    background: linear-gradient(145deg, #b5203b 0%, #a51c30 52%, #7b1422 100%);
    border: 1px solid rgba(123, 20, 34, 0.4);
    border-radius: 12px;
    box-shadow:
      0 5px 12px rgba(123, 20, 34, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.22);
  }

  /*
   * iB 字樣放大至接近紅色方框邊緣。
   * scale() 會將字樣橫向及縱向放大，消除四周過多留白。
   */
  .logo-letters {
    display: block;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", Times, serif;
    font-size: 33px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -3.8px;
    white-space: nowrap;
    transform: translate(-1px, 1px) scaleX(1.17) scaleY(1.18);
    transform-origin: center;
    text-shadow: 0 1px 1px rgba(70, 5, 18, 0.28);
  }

  .brand-name {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    white-space: nowrap;
    font-size: clamp(16px, 1.25vw, 20px);
    line-height: 1;
  }

  .brand-ibridge {
    color: #315c6b;
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .brand-education {
    color: #1f2933;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .navigation-area {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 24px;
  }

  .site-navigation {
    display: block;
  }

  .navigation-list {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(18px, 2vw, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .navigation-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #17324a;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .navigation-link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 5px;
    left: 0;
    height: 2px;
    background: #a51c30;
    border-radius: 999px;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 160ms ease;
  }

  .navigation-link:hover,
  .navigation-link.active {
    color: #a51c30;
  }

  .navigation-link:hover::after,
  .navigation-link.active::after {
    transform: scaleX(1);
  }

  .language-switch {
    width: 42px;
    height: 42px;
    min-width: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #17324a;
    background: #faf7f0;
    border: 1px solid #d8c6ad;
    border-radius: 50%;
    font-size: 14px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 3px 10px rgba(31, 41, 51, 0.05);
    transition:
      color 160ms ease,
      background-color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .language-switch:hover {
    color: #ffffff;
    background: #a51c30;
    border-color: #a51c30;
    transform: translateY(-1px);
  }

  .mobile-menu-button {
    display: none;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: #17324a;
    background: #faf7f0;
    border: 1px solid #d8c6ad;
    border-radius: 11px;
    cursor: pointer;
  }

  .menu-icon {
    width: 25px;
    height: 25px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .menu-close-icon {
    display: none;
  }

  .brand-link:focus-visible,
  .navigation-link:focus-visible,
  .language-switch:focus-visible,
  .mobile-menu-button:focus-visible {
    outline: 3px solid #c48a2c;
    outline-offset: 4px;
  }

  @media (max-width: 1180px) {
    .header-container {
      gap: 18px;
    }

    .brand-name {
      font-size: 16px;
    }

    .navigation-list {
      gap: 17px;
    }

    .navigation-link {
      font-size: 14px;
    }

    .navigation-area {
      gap: 16px;
    }
  }

  @media (max-width: 960px) {
    .site-header {
      position: sticky;
      top: 0;
    }

    .header-container {
      position: relative;
      width: min(100% - 28px, 1440px);
      min-height: 72px;
    }

    .logo-box {
      width: 42px;
      height: 42px;
      min-width: 42px;
      border-radius: 11px;
    }

    .logo-letters {
      font-size: 32px;
    }

    .mobile-menu-button {
      display: inline-flex;
      margin-left: auto;
    }

    .navigation-area {
      position: absolute;
      top: calc(100% + 1px);
      right: -14px;
      left: -14px;
      display: none;
      align-items: stretch;
      padding: 18px 20px 22px;
      background: #f7f1e3;
      border-top: 1px solid #e4d7c5;
      border-bottom: 1px solid #e4d7c5;
      box-shadow: 0 18px 30px rgba(31, 41, 51, 0.13);
    }

    .menu-is-open .navigation-area {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .menu-is-open .menu-open-icon {
      display: none;
    }

    .menu-is-open .menu-close-icon {
      display: block;
    }

    .site-navigation {
      width: 100%;
    }

    .navigation-list {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 7px;
    }

    .navigation-link {
      width: 100%;
      min-height: 48px;
      justify-content: center;
      padding: 9px 12px;
      background: #faf7f0;
      border: 1px solid #e4d7c5;
      border-radius: 9px;
      font-size: 15px;
      text-align: center;
    }

    .navigation-link::after {
      display: none;
    }

    .navigation-link:hover,
    .navigation-link.active {
      color: #ffffff;
      background: #a51c30;
      border-color: #a51c30;
    }

    .language-switch {
      width: 100%;
      height: 46px;
      border-radius: 9px;
    }
  }

  @media (max-width: 540px) {
    .header-container {
      width: min(100% - 22px, 1440px);
      min-height: 68px;
    }

    .brand-link {
      gap: 9px;
    }

    .logo-box {
      width: 40px;
      height: 40px;
      min-width: 40px;
      border-radius: 10px;
    }

    .logo-letters {
      font-size: 30px;
      letter-spacing: -3.5px;
    }

    .brand-name {
      font-size: 15px;
    }

    .navigation-area {
      right: -11px;
      left: -11px;
    }

    .navigation-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 380px) {
    .brand-education {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navigation-link,
    .navigation-link::after,
    .language-switch {
      transition: none;
    }
  }
</style>
