---
import EditorialHero from "./EditorialHero.astro";
interface Props { eyebrow: string; title: string; accent?: string; copy: string; }
const { eyebrow, title, accent = "", copy } = Astro.props;
const route = Astro.url.pathname.replace(/^\/en\//, "/");
const art = ["/services/", "/about/"].includes(route) ? "bridge" : route === "/contact/" ? "books" : "none";
---
<EditorialHero {eyebrow} {title} {accent} {copy} {art} cta={route === "/services/"} />
