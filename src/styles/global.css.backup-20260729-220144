:root {
  --primary: #a51c30;
  --primary-dark: #6f1020;
  --cream: #f7f1e3;
  --ivory: #faf7f0;
  --white: #ffffff;
  --text: #18212b;
  --text-soft: #34414d;
  --teal: #234f5d;
  --gold: #ad741d;
  --sand: #d7c7b1;
  --dark: #18212b;
  --dark-soft: #fff7eb;
  --max: 1180px;
  --radius-sm: 12px;
  --radius-md: 22px;
  --radius-lg: 34px;
  --shadow: 0 18px 55px rgba(24, 33, 43, 0.13);
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  scroll-behavior: smooth;
  scroll-padding-top: 92px;
  background: var(--cream);
}

body {
  min-width: 320px;
  min-height: 100vh;
  margin: 0;
  overflow-x: hidden;
  background: var(--cream);
  color: var(--text);
  font-family:
    Inter,
    ui-sans-serif,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    "PingFang TC",
    "Noto Sans TC",
    "Microsoft JhengHei",
    Arial,
    sans-serif;
  font-size: 17px;
  font-weight: 400;
  line-height: 1.72;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body.menu-open {
  overflow: hidden;
}

main {
  min-height: 60vh;
}

img,
picture,
svg,
video,
canvas {
  display: block;
  max-width: 100%;
}

img {
  height: auto;
}

a {
  color: inherit;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.18em;
}

a:hover {
  color: var(--primary-dark);
}

button,
input,
select,
textarea {
  color: inherit;
  font: inherit;
}

button {
  cursor: pointer;
}

:focus-visible {
  outline: 3px solid rgba(165, 28, 48, 0.48);
  outline-offset: 3px;
}

::selection {
  background: rgba(165, 28, 48, 0.24);
  color: var(--text);
}

h1,
h2,
h3,
h4,
strong,
b {
  color: var(--text);
  font-weight: 750;
}

h1,
h2,
h3,
h4,
p {
  margin-top: 0;
}

h1 {
  font-size: clamp(3rem, 7vw, 6.4rem);
  line-height: 0.96;
  letter-spacing: -0.06em;
}

h2 {
  font-size: clamp(2.25rem, 4.7vw, 4.45rem);
  line-height: 1.04;
  letter-spacing: -0.045em;
}

h3 {
  font-size: clamp(1.35rem, 2.1vw, 1.85rem);
  line-height: 1.22;
  letter-spacing: -0.025em;
}

p,
li,
dd,
dt,
figcaption,
label {
  color: var(--text-soft);
}

.container {
  width: min(var(--max), calc(100% - 48px));
  margin-inline: auto;
}

.section {
  padding: 104px 0;
}

.section-ivory {
  background: var(--ivory);
}

.section-white {
  background: var(--white);
}

.section-dark {
  background: var(--primary-dark);
  color: var(--white);
}

.section-dark h2,
.section-dark h3,
.section-dark strong {
  color: var(--white);
}

.section-dark p,
.section-dark li {
  color: var(--dark-soft);
}

.skip-link {
  position: fixed;
  top: -80px;
  left: 16px;
  z-index: 1000;
  padding: 12px 18px;
  border-radius: 10px;
  background: var(--white);
  color: var(--primary-dark);
}

.skip-link:focus {
  top: 16px;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1px solid var(--sand);
  background: rgba(247, 241, 227, 0.97);
  backdrop-filter: blur(16px);
}

.navbar {
  min-height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: var(--text);
  font-weight: 800;
  letter-spacing: -0.02em;
  text-decoration: none;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border-radius: 14px;
  background: var(--primary);
  color: var(--white);
  box-shadow: 0 8px 22px rgba(165, 28, 48, 0.22);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 25px;
}

.nav-links a {
  color: var(--text);
  font-size: 0.94rem;
  font-weight: 750;
  text-decoration: none;
}

.nav-links a:hover,
.nav-links a[aria-current="page"] {
  color: var(--primary-dark);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.lang-link,
.menu-button {
  display: inline-grid;
  min-width: 44px;
  min-height: 44px;
  place-items: center;
  border: 1px solid var(--sand);
  border-radius: 999px;
  background: var(--ivory);
  color: var(--text);
  font-weight: 800;
  text-decoration: none;
}

.menu-button {
  display: none;
}

.button {
  display: inline-flex;
  min-height: 52px;
  align-items: center;
  justify-content: center;
  padding: 0 25px;
  border: 1px solid transparent;
  border-radius: 999px;
  font-weight: 800;
  line-height: 1;
  text-decoration: none;
  transition:
    transform 160ms ease,
    background 160ms ease,
    color 160ms ease,
    border-color 160ms ease,
    box-shadow 160ms ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button-primary {
  background: var(--primary);
  color: var(--white);
  box-shadow: 0 9px 24px rgba(165, 28, 48, 0.2);
}

.button-primary:hover {
  background: var(--primary-dark);
  color: var(--white);
}

.button-secondary {
  border-color: var(--primary-dark);
  background: var(--white);
  color: var(--primary-dark);
}

.button-secondary:hover {
  background: var(--primary-dark);
  color: var(--white);
}

.button-light {
  border-color: var(--white);
  background: var(--white);
  color: var(--primary-dark);
}

.button-light:hover {
  border-color: var(--gold);
  background: var(--gold);
  color: var(--text);
}

.text-link {
  color: var(--primary-dark);
  font-weight: 800;
}

.eyebrow {
  margin-bottom: 16px;
  color: var(--primary-dark);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.eyebrow-light {
  color: #ffe0a8;
}

.lead {
  max-width: 760px;
  color: var(--text-soft);
  font-size: clamp(1.08rem, 1.5vw, 1.24rem);
  line-height: 1.76;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 34px;
}

/* Approved image-first bilingual homepage hero. */
.visual-hero {
  padding: 50px 0 82px;
  background:
    radial-gradient(circle at 92% 8%, rgba(173, 116, 29, 0.17), transparent 31%),
    linear-gradient(135deg, var(--cream), var(--ivory));
}

.visual-hero-container {
  display: grid;
  gap: 28px;
}

.visual-hero-picture {
  overflow: hidden;
  border: 1px solid var(--sand);
  border-radius: var(--radius-lg);
  background: var(--ivory);
  box-shadow: var(--shadow);
}

.visual-hero-picture img {
  width: 100%;
  aspect-ratio: 1672 / 941;
  object-fit: cover;
  object-position: center;
}

.visual-hero-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14px;
}

.page-hero {
  position: relative;
  overflow: hidden;
  padding: 96px 0 86px;
  background:
    radial-gradient(circle at 88% 10%, rgba(173, 116, 29, 0.18), transparent 27%),
    linear-gradient(135deg, var(--cream), var(--ivory));
}

.page-hero::after {
  content: "";
  position: absolute;
  right: -130px;
  bottom: -210px;
  width: 360px;
  height: 360px;
  border: 1px solid rgba(165, 28, 48, 0.22);
  border-radius: 50%;
}

.page-hero-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 70px;
  align-items: end;
}

.page-hero h1 {
  font-size: clamp(3rem, 6.2vw, 5.7rem);
}

.page-hero h1 span {
  color: var(--primary);
}

.page-hero-copy {
  padding-bottom: 8px;
}

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 36px;
  margin-bottom: 44px;
}

.section-heading > div {
  max-width: 820px;
}

.section-heading h2 {
  margin-bottom: 0;
}

.grid-2,
.grid-3,
.grid-4 {
  display: grid;
  gap: 24px;
}

.grid-2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.grid-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.grid-4 {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.card {
  padding: 32px;
  border: 1px solid var(--sand);
  border-radius: var(--radius-md);
  background: var(--ivory);
  box-shadow: 0 10px 30px rgba(24, 33, 43, 0.07);
}

.card h3 {
  margin-bottom: 14px;
}

.card p:last-child {
  margin-bottom: 0;
}

.card-number {
  display: block;
  margin-bottom: 34px;
  color: var(--primary-dark);
  font-weight: 800;
  letter-spacing: 0.12em;
}

.card ul {
  margin: 20px 0 0;
  padding-left: 20px;
}

.card li + li {
  margin-top: 7px;
}

.dark-card {
  border-color: rgba(255, 255, 255, 0.26);
  background: rgba(255, 255, 255, 0.11);
  box-shadow: none;
}

.dark-card h3,
.dark-card .card-number {
  color: var(--white);
}

.dark-card p,
.dark-card li {
  color: var(--dark-soft);
}

.split {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: 72px;
  align-items: start;
}

.prose {
  max-width: 780px;
}

.prose p + p {
  margin-top: 20px;
}

.list-panel {
  border-top: 1px solid var(--sand);
}

.list-row {
  display: grid;
  grid-template-columns: 62px 1fr;
  gap: 20px;
  padding: 23px 0;
  border-bottom: 1px solid var(--sand);
}

.list-row span {
  color: var(--primary-dark);
  font-weight: 800;
}

.list-row strong {
  font-size: 1.06rem;
}

.research-summary-card {
  background: var(--ivory);
}

.cta-wrap {
  padding: 24px 0 104px;
}

.cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 54px;
  padding: 58px 62px;
  border-radius: var(--radius-lg);
  background: linear-gradient(120deg, var(--primary-dark), var(--primary));
}

.cta > div {
  max-width: 800px;
}

.cta h2 {
  margin-bottom: 18px;
  color: var(--white);
}

.cta p {
  margin-bottom: 0;
  color: var(--dark-soft);
}

.site-footer {
  padding: 72px 0 34px;
  background: var(--dark);
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.25fr 0.75fr 0.75fr 0.9fr;
  gap: 44px;
}

.footer-brand {
  max-width: 420px;
}

.site-footer h2,
.site-footer h3,
.site-footer strong {
  color: var(--white);
}

.site-footer p,
.site-footer a,
.site-footer li {
  color: #f4f6f8;
}

.site-footer a:hover {
  color: #ffe0a8;
}

.footer-links {
  margin: 0;
  padding: 0;
  list-style: none;
}

.footer-links li + li {
  margin-top: 8px;
}

.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-top: 54px;
  padding-top: 24px;
  border-top: 1px solid rgba(255, 255, 255, 0.24);
}

.footer-bottom p {
  margin: 0;
  font-size: 0.9rem;
}

.contact-grid {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 56px;
}

.contact-details {
  display: grid;
  gap: 16px;
}

.contact-detail {
  padding: 22px;
  border: 1px solid var(--sand);
  border-radius: 16px;
  background: var(--ivory);
}

.contact-detail small {
  display: block;
  margin-bottom: 4px;
  color: var(--primary-dark);
  font-weight: 800;
}

form {
  display: grid;
  gap: 18px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

label {
  display: block;
  margin-bottom: 7px;
  color: var(--text);
  font-weight: 750;
}

input,
select,
textarea {
  width: 100%;
  border: 1px solid #bca98f;
  border-radius: 12px;
  background: var(--white);
  color: var(--text);
}

input,
select {
  min-height: 52px;
  padding: 0 14px;
}

textarea {
  min-height: 170px;
  padding: 14px;
  resize: vertical;
}

input::placeholder,
textarea::placeholder {
  color: #53616e;
  opacity: 1;
}

.form-note {
  margin: 0;
  color: var(--text-soft);
  font-size: 0.9rem;
}

.legal {
  max-width: 860px;
}

.legal h2 {
  margin-top: 46px;
  font-size: clamp(1.75rem, 3vw, 2.5rem);
}

.legal h3 {
  margin-top: 30px;
}

@media (max-width: 1000px) {
  .nav-links {
    position: fixed;
    inset: 83px 0 auto;
    display: none;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 18px 24px 28px;
    border-bottom: 1px solid var(--sand);
    background: var(--cream);
    box-shadow: 0 18px 35px rgba(24, 33, 43, 0.15);
  }

  .nav-links.open {
    display: flex;
  }

  .nav-links a {
    padding: 13px 2px;
  }

  .menu-button {
    display: inline-grid;
  }

  .page-hero-grid,
  .split,
  .contact-grid {
    grid-template-columns: 1fr;
  }

  .grid-4 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .grid-3 {
    grid-template-columns: 1fr;
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }

  .cta {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 680px) {
  body {
    font-size: 16px;
  }

  .container {
    width: min(var(--max), calc(100% - 30px));
  }

  .navbar {
    min-height: 74px;
  }

  .nav-links {
    top: 75px;
  }

  .brand span:last-child {
    display: none;
  }

  .section {
    padding: 76px 0;
  }

  .visual-hero {
    padding: 28px 0 60px;
  }

  .visual-hero-container {
    gap: 22px;
  }

  .visual-hero-picture {
    border-radius: 22px;
  }

  .visual-hero-picture img {
    aspect-ratio: 1672 / 941;
  }

  .visual-hero-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .visual-hero-actions .button {
    width: 100%;
  }

  .page-hero {
    padding: 72px 0 66px;
  }

  .page-hero h1 {
    font-size: clamp(2.75rem, 14vw, 4.4rem);
  }

  .section-heading {
    align-items: flex-start;
    flex-direction: column;
    margin-bottom: 32px;
  }

  .grid-2,
  .grid-4,
  .form-row {
    grid-template-columns: 1fr;
  }

  .card {
    padding: 27px 24px;
  }

  .cta-wrap {
    padding-bottom: 76px;
  }

  .cta {
    padding: 38px 25px;
  }

  .footer-grid {
    grid-template-columns: 1fr;
  }

  .footer-bottom {
    align-items: flex-start;
    flex-direction: column;
  }
}
