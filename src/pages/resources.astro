---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Cta from "../components/Cta.astro";
const resources = [
  ["MYP", "MYP 教學資源", "單元規劃、探究、評量、語言支援與跨年級垂直銜接資源。"],
  ["DP", "DP 教學資源", "支援學科知識、概念理解、學術寫作與評量準備的課程材料。"],
  ["TOK", "知識論資源", "以提問、證據、觀點、方法與倫理為核心的教學活動與評量支援。"],
  ["ELA", "英語與學術寫作", "適用於不同語言階段的閱讀、寫作、口說、聆聽與語言發展材料。"],
  ["AI", "人工智慧教育", "聚焦安全、倫理、學習目的、教師判斷與實際課堂應用。"],
  ["WELL", "學習與韌性", "結合自我調節、反思、動機、學習習慣與學生福祉的實務資源。"]
];
---
<BaseLayout title="教育資源" description="探索 iBridge Education 的 MYP、DP、TOK、英語、人工智慧教育與學生學習資源。" locale="zh-Hant" zhPath="/resources/" enPath="/en/resources/">
  <PageHero eyebrow="教育資源" title="清楚、可使用、" accent="可持續更新的專業內容。" copy="資源中心將依課程階段、學科、技能、資源類型與語言提供清楚分類，協助教師快速找到可直接使用或調整的材料。" />
  <section class="section section-white"><div class="container">
    <div class="section-heading"><div><p class="eyebrow">資源分類</p><h2>從課程架構到教室實踐</h2></div></div>
    <div class="grid-3">{resources.map(([code,title,copy]) => <article class="card"><span class="card-number">{code}</span><h3>{title}</h3><p>{copy}</p><p><strong>資源陸續上線中</strong></p></article>)}</div>
  </div></section>
  <section class="section section-ivory"><div class="container split"><div><p class="eyebrow">資源原則</p><h2>不是單純堆放檔案，而是建立可理解的學習路徑。</h2></div><div class="list-panel">
    {[["01","清楚標示適用年級、課程階段與語言程度"],["02","提供學習目標、教師說明與學生任務"],["03","標示檔案格式、頁數、更新日期與使用方式"],["04","保留可調整空間，回應不同學校與學生需求"]].map(([n,t]) => <div class="list-row"><span>{n}</span><strong>{t}</strong></div>)}
  </div></div></section>
  <Cta eyebrow="資源合作" title="共同開發可信、清楚且可實施的教育內容。" copy="歡迎討論教材、課程出版、雙語資源、教師工具與教育內容合作。" label="聯絡 iBridge" href="/contact/" />
</BaseLayout>
