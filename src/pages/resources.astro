---
import BaseLayout from "../layouts/BaseLayout.astro";

const resourceCategories = [
  {
    number: "01",
    title: "課程與單元設計",
    englishTitle: "Curriculum and Unit Design",
    description:
      "提供課程地圖、單元規劃、探究流程、概念發展與垂直銜接相關資源。",
    resources: [
      "課程地圖範本",
      "單元規劃架構",
      "概念與探究設計工具",
      "學習目標對齊檢核表",
    ],
    status: "持續更新",
  },
  {
    number: "02",
    title: "教學與學習策略",
    englishTitle: "Teaching and Learning",
    description:
      "支援探究式學習、差異化教學、學術語言、合作學習與課堂參與。",
    resources: [
      "探究活動範例",
      "差異化教學工具",
      "課堂討論架構",
      "學習策略指引",
    ],
    status: "持續更新",
  },
  {
    number: "03",
    title: "評量與回饋",
    englishTitle: "Assessment and Feedback",
    description:
      "協助教師設計有效評量、成功標準、回饋流程與學生自我評估活動。",
    resources: [
      "形成性評量工具",
      "成功標準範本",
      "學生自評與互評表",
      "回饋設計檢核表",
    ],
    status: "持續更新",
  },
  {
    number: "04",
    title: "英語與學術寫作",
    englishTitle: "English and Academic Writing",
    description:
      "提供文本分析、文章結構、論證寫作、語言發展與雙語學習資源。",
    resources: [
      "段落與文章架構",
      "論證寫作工具",
      "文本類型指引",
      "英語詞彙與語言活動",
    ],
    status: "重點發展",
  },
  {
    number: "05",
    title: "學生學習與韌性",
    englishTitle: "Learning and Resilience",
    description:
      "支援後設認知、自我調節、情緒管理、學習習慣與學生心理韌性。",
    resources: [
      "學習反思工具",
      "目標設定活動",
      "壓力調節資源",
      "自我管理檢核表",
    ],
    status: "研究整合",
  },
  {
    number: "06",
    title: "人工智慧教育",
    englishTitle: "Artificial Intelligence in Education",
    description:
      "提供教師 AI 素養、課程整合、學術誠信與負責任使用人工智慧的實務資源。",
    resources: [
      "教師 AI 使用指引",
      "AI 課程規劃範例",
      "學術誠信討論工具",
      "AI 使用政策範本",
    ],
    status: "持續發展",
  },
];

const featuredResources = [
  {
    type: "課程設計",
    title: "國際課程單元規劃檢核表",
    description:
      "協助教師檢查學習目標、探究活動、形成性評量與總結性評量是否彼此對齊。",
    format: "PDF",
    access: "免費資源",
    href: "#coming-soon",
  },
  {
    type: "學術寫作",
    title: "論證寫作規劃工具",
    description:
      "引導學生建立主張、證據、推理、反方觀點與回應的完整論證結構。",
    format: "PDF",
    access: "免費資源",
    href: "#coming-soon",
  },
  {
    type: "學生學習",
    title: "自我調節學習反思表",
    description:
      "協助學生設定目標、選擇策略、監控進度並反思下一步的改善方向。",
    format: "PDF",
    access: "免費資源",
    href: "#coming-soon",
  },
];

const accessSteps = [
  {
    number: "01",
    title: "選擇資源領域",
    description:
      "依據課程、教學、評量、語言、學生學習或人工智慧主題瀏覽資源。",
  },
  {
    number: "02",
    title: "查看使用說明",
    description:
      "每份資源將標示適合對象、使用目的、檔案格式與建議使用方式。",
  },
  {
    number: "03",
    title: "下載或線上閱讀",
    description:
      "公開資源可直接下載；部分完整課程將提供線上閱讀或分單元存取。",
  },
  {
    number: "04",
    title: "依情境調整",
    description:
      "教師可根據學生程度、學校課程與教學時間修改資源內容。",
  },
];

const principles = [
  "實務導向",
  "研究支持",
  "清楚易用",
  "可依情境調整",
  "繁中與英文支援",
  "持續修訂與更新",
];
---

<BaseLayout
  title="資源中心"
  description="探索 iBridge Education 的課程設計、教學策略、評量、學術寫作、學生學習與人工智慧教育資源。"
  locale="zh-tw"
  zhPath="/resources"
  enPath="/en/resources"
  pageType="CollectionPage"
  breadcrumbs={[
    {
      name: "首頁",
      path: "/",
    },
    {
      name: "資源中心",
      path: "/resources",
    },
  ]}
>
  <section class="page-hero">
    <div class="hero-decoration" aria-hidden="true">
      <span class="hero-circle hero-circle-one"></span>
      <span class="hero-circle hero-circle-two"></span>
      <span class="hero-line"></span>
    </div>

    <div class="container hero-grid">
      <div>
        <p class="eyebrow">資源中心</p>

        <h1>
          將研究、課程與教學經驗，
          <span>轉化為可以直接使用的教育資源。</span>
        </h1>
      </div>

      <div class="hero-copy">
        <p>
          iBridge Education 資源中心提供課程規劃、教學活動、
          評量工具、學術寫作與學生學習相關材料。
        </p>

        <p>
          資源將以繁中與英文逐步發布，並依據教師回饋與教育研究持續更新。
        </p>

        <a class="hero-button" href="#resource-library">
          瀏覽資源
        </a>
      </div>
    </div>
  </section>

  <section class="introduction-section">
    <div class="container introduction-grid">
      <div>
        <p class="section-label">資源定位</p>

        <h2>
          不只是檔案下載，
          而是能夠支持實際教學的工具。
        </h2>
      </div>

      <div class="introduction-copy">
        <p>
          教育資源只有在教師能理解、調整並有效使用時，
          才能真正改善學生學習。
        </p>

        <p>
          因此，每份資源將盡量提供使用目的、適合對象、
          建議流程與可調整方式，而不只是單獨提供工作紙或範本。
        </p>
      </div>
    </div>
  </section>

  <section
    id="resource-library"
    class="categories-section"
  >
    <div class="container">
      <div class="section-heading">
        <p class="section-label">資源分類</p>

        <h2>
          六個主要資源領域。
        </h2>
      </div>

      <div class="category-grid">
        {
          resourceCategories.map((category) => (
            <article class="category-card">
              <div class="category-header">
                <span class="category-number">
                  {category.number}
                </span>

                <div>
                  <p class="category-english">
                    {category.englishTitle}
                  </p>

                  <h3>{category.title}</h3>
                </div>
              </div>

              <p class="category-description">
                {category.description}
              </p>

              <ul>
                {
                  category.resources.map((resource) => (
                    <li>{resource}</li>
                  ))
                }
              </ul>

              <div class="category-footer">
                <span class="status-badge">
                  {category.status}
                </span>

                <a href="#coming-soon">
                  查看資源
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="featured-section">
    <div class="container">
      <div class="featured-heading">
        <div>
          <p class="section-label">精選資源</p>

          <h2>
            即將發布的實務工具。
          </h2>
        </div>

        <p>
          以下資源將於資源中心陸續提供。
          正式發布後，按鈕將連結至下載或線上閱讀頁面。
        </p>
      </div>

      <div class="featured-grid">
        {
          featuredResources.map((resource, index) => (
            <article class="resource-card">
              <div class="resource-top">
                <span class="resource-index">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <span class="resource-type">
                  {resource.type}
                </span>
              </div>

              <h3>{resource.title}</h3>

              <p>{resource.description}</p>

              <div class="resource-meta">
                <span>{resource.format}</span>
                <span>{resource.access}</span>
              </div>

              <a href={resource.href}>
                即將推出
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="access-section">
    <div class="container access-grid">
      <div class="access-intro">
        <p class="section-label light-label">
          使用方式
        </p>

        <h2>
          找到資源後，
          依據自己的教學情境調整。
        </h2>

        <p>
          資源不是固定腳本。教師應考量學生程度、
          語言背景、課程目標與可用時間後再使用。
        </p>
      </div>

      <ol class="access-list">
        {
          accessSteps.map((step) => (
            <li>
              <span>{step.number}</span>

              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="principles-section">
    <div class="container principles-card">
      <div>
        <p class="section-label">資源原則</p>

        <h2>
          所有資源遵循一致的設計標準。
        </h2>

        <p>
          隨著資源庫擴充，我們將維持清楚分類、
          實用說明、版本管理與雙語支援。
        </p>
      </div>

      <div class="principles-list">
        {
          principles.map((principle, index) => (
            <div>
              <span>
                {String(index + 1).padStart(2, "0")}
              </span>

              <strong>{principle}</strong>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="coming-soon"
    class="notice-section"
  >
    <div class="container notice-card">
      <div>
        <p class="eyebrow notice-eyebrow">
          資源庫建置中
        </p>

        <h2>
          第一批免費教育資源正在整理與校對。
        </h2>

        <p>
          資源發布後，將提供清楚分類、檔案說明、
          適用年級、語言版本與更新日期。
        </p>
      </div>

      <a href="/contact">
        詢問資源合作
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .page-hero {
    position: relative;
    overflow: hidden;
    padding: 112px 0 104px;
    background:
      radial-gradient(
        circle at 88% 14%,
        rgba(196, 138, 44, 0.1),
        transparent 28%
      ),
      linear-gradient(
        125deg,
        #f7f1e3 0%,
        #faf7f0 100%
      );
  }

  .hero-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-circle {
    position: absolute;
    border: 1px solid rgba(165, 28, 48, 0.16);
    border-radius: 999px;
  }

  .hero-circle-one {
    width: 520px;
    height: 520px;
    top: -270px;
    right: -90px;
  }

  .hero-circle-two {
    width: 260px;
    height: 260px;
    right: 240px;
    bottom: -175px;
  }

  .hero-line {
    position: absolute;
    top: 58%;
    right: -120px;
    width: 700px;
    height: 1px;
    background: rgba(165, 28, 48, 0.16);
    transform: rotate(-16deg);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 90px;
    align-items: end;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 18px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    color: #1f2933;
    font-family:
      "Neue Helvetica",
      "Helvetica Neue",
      Helvetica,
      Arial,
      "PingFang TC",
      sans-serif;
    font-weight: 700;
    letter-spacing: -0.045em;
  }

  h1 {
    font-size: clamp(3.1rem, 6.2vw, 5.7rem);
    line-height: 0.99;
  }

  h1 span {
    display: block;
    margin-top: 14px;
    color: #a51c30;
  }

  .hero-copy {
    display: grid;
    gap: 20px;
  }

  .hero-copy p,
  .introduction-copy p,
  .featured-heading > p,
  .access-intro > p,
  .principles-card > div:first-child > p,
  .notice-card p {
    margin: 0;
    color: #52606d;
    font-size: 1.03rem;
    line-height: 1.85;
  }

  .hero-button {
    display: inline-flex;
    width: fit-content;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    padding: 0 24px;
    border-radius: 999px;
    background: #a51c30;
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
  }

  .hero-button:hover {
    background: #7b1422;
    color: #ffffff;
  }

  .introduction-section,
  .categories-section,
  .featured-section,
  .access-section,
  .principles-section {
    padding: 104px 0;
  }

  .introduction-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 90px;
  }

  .introduction-grid h2,
  .section-heading h2,
  .featured-heading h2,
  .access-intro h2,
  .principles-card h2,
  .notice-card h2 {
    font-size: clamp(2.35rem, 4vw, 4.1rem);
    line-height: 1.08;
  }

  .introduction-copy {
    display: grid;
    gap: 24px;
    padding-top: 34px;
  }

  .categories-section {
    background: #f7f1e3;
  }

  .section-heading {
    max-width: 900px;
    margin-bottom: 50px;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .category-card {
    padding: 34px;
    border: 1px solid #e4d7c5;
    border-radius: 22px;
    background: #faf7f0;
    box-shadow: 0 12px 36px rgba(31, 41, 51, 0.05);
  }

  .category-header {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: 18px;
  }

  .category-number {
    padding-top: 7px;
    color: #a51c30;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .category-english {
    margin: 0 0 7px;
    color: #315c6b;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .category-card h3 {
    margin: 0;
    color: #1f2933;
    font-size: 1.65rem;
    line-height: 1.2;
  }

  .category-description {
    margin: 25px 0;
    color: #52606d;
    line-height: 1.78;
  }

  .category-card ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 18px;
    margin: 0;
    padding: 23px 0;
    border-top: 1px solid #e4d7c5;
    border-bottom: 1px solid #e4d7c5;
    list-style: none;
  }

  .category-card li {
    position: relative;
    padding-left: 16px;
    color: #52606d;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .category-card li::before {
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: #a51c30;
    content: "";
  }

  .category-footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: center;
    padding-top: 22px;
  }

  .status-badge {
    display: inline-flex;
    padding: 6px 11px;
    border: 1px solid rgba(196, 138, 44, 0.35);
    border-radius: 999px;
    background: rgba(196, 138, 44, 0.1);
    color: #805916;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .category-footer a {
    color: #315c6b;
    font-weight: 700;
    text-decoration: none;
  }

  .category-footer a:hover {
    color: #a51c30;
  }

  .featured-section {
    background: #faf7f0;
  }

  .featured-heading {
    display: grid;
    grid-template-columns: 1fr 0.75fr;
    gap: 70px;
    align-items: end;
    margin-bottom: 48px;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .resource-card {
    display: flex;
    min-height: 360px;
    flex-direction: column;
    padding: 30px;
    border: 1px solid #e4d7c5;
    border-radius: 20px;
    background: #f7f1e3;
  }

  .resource-top {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: center;
  }

  .resource-index {
    color: #a51c30;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .resource-type {
    color: #315c6b;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .resource-card h3 {
    margin: 46px 0 18px;
    color: #1f2933;
    font-size: 1.5rem;
    line-height: 1.25;
  }

  .resource-card > p {
    margin: 0;
    color: #52606d;
    line-height: 1.75;
  }

  .resource-meta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 28px;
  }

  .resource-meta span {
    display: inline-flex;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(49, 92, 107, 0.09);
    color: #315c6b;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .resource-card > a {
    display: inline-flex;
    width: fit-content;
    margin-top: 22px;
    color: #a51c30;
    font-weight: 700;
    text-decoration: none;
  }

  .access-section {
    background:
      linear-gradient(
        120deg,
        #7b1422 0%,
        #56101a 100%
      );
  }

  .access-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 86px;
  }

  .light-label {
    color: #f2c66d;
  }

  .access-intro h2 {
    color: #ffffff;
  }

  .access-intro > p {
    margin-top: 26px;
    color: rgba(255, 255, 255, 0.76);
  }

  .access-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .access-list li {
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 18px;
    padding: 23px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .access-list li:first-child {
    border-top: 0;
  }

  .access-list li > span {
    color: #f2c66d;
    font-size: 0.73rem;
    font-weight: 700;
  }

  .access-list h3 {
    margin: 0 0 8px;
    color: #ffffff;
    font-size: 1.12rem;
  }

  .access-list p {
    margin: 0;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.7;
  }

  .principles-section {
    background: #f7f1e3;
  }

  .principles-card {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 76px;
    padding: 62px;
    border: 1px solid #e4d7c5;
    border-radius: 28px;
    background: #faf7f0;
  }

  .principles-card > div:first-child > p {
    margin-top: 25px;
  }

  .principles-list {
