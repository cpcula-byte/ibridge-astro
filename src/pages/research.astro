---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Cta from "../components/Cta.astro";
const areas = [
  ["01","正向心理學與學生福祉","探討優勢、希望、感恩、韌性與學習環境如何支持學生福祉與參與。"],
  ["02","教育神經科學","將神經可塑性、壓力生理、注意力、記憶與情緒調節轉化為負責任的教育應用。"],
  ["03","自我調節學習與後設認知","研究學生如何規劃、監控、調整並反思自己的學習。"],
  ["04","人工智慧教育應用","關注生成式 AI、教師工作流程、回饋、評量、學術誠信與 AI 素養。"],
  ["05","國際課程與評量設計","研究課程連貫性、概念導向學習、垂直銜接與評量品質。"],
  ["06","方案評估與學校改進","使用量化與質性資料檢視教育方案是否可行、有效及具長期價值。"]
];
---
<BaseLayout title="教育研究" description="探索 iBridge Education 在正向心理學、教育神經科學、自我調節學習、人工智慧與課程設計方面的研究方向。" locale="zh-Hant" zhPath="/research/" enPath="/en/research/">
  <PageHero eyebrow="教育研究" title="讓研究成為可理解、" accent="可實施且可持續改善的專業資源。" copy="我們關注研究如何在真實學校情境中產生價值，而不是只停留在理論或術語。" />
  <section class="section section-white"><div class="container split"><div><p class="eyebrow">研究立場</p><h2>嚴謹證據與專業判斷必須共同工作。</h2></div><div class="prose"><p>教育研究可以提供方向、解釋與可能性，但不能脫離學生、教師、課程與組織脈絡。</p><p>我們重視研究問題的清楚度、資料工具的適切性、倫理與隱私，以及結果是否能轉化為可行改善。</p></div></div></section>
  <section class="section section-ivory"><div class="container"><div class="section-heading"><div><p class="eyebrow">研究方向</p><h2>連結學習科學、課程設計與學校改進。</h2></div></div><div class="grid-3">{areas.map(([n,t,d])=><article class="card"><span class="card-number">{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div></div></section>
  <section class="section section-dark"><div class="container"><div class="section-heading"><div><p class="eyebrow eyebrow-light">研究流程</p><h2>從問題到證據，再回到實務。</h2></div></div><div class="grid-4">{[["01","界定問題","釐清研究目的、對象、情境與成功標準。"],["02","設計方法","選擇適切的量化、質性或混合方法。"],["03","蒐集與分析資料","重視倫理、隱私、可信度與透明度。"],["04","轉化與改善","將結果轉化為課程、工具、建議與後續評估。"]].map(([n,t,d])=><article class="card dark-card"><span class="card-number">{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div></div></section>
  <Cta eyebrow="研究合作" title="討論教育研究、方案評估或資料工具設計。" copy="請提供研究問題、參與者、現有資料、時間範圍與預期成果。" label="聯絡 iBridge" href="/contact/" />
</BaseLayout>
