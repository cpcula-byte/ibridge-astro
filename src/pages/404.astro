---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found"
  description="The requested page could not be found."
  locale="zh-tw"
  noindex={true}
>
  <section class="error-page">
    <div class="error-background" aria-hidden="true">
      <span class="shape shape-one"></span>
      <span class="shape shape-two"></span>
      <span class="shape shape-three"></span>
    </div>

    <div class="error-container">
      <div class="error-code" aria-hidden="true">404</div>

      <!-- 繁體中文內容 -->
      <div class="language-content" data-language="zh">
        <p class="eyebrow">找不到頁面</p>

        <h1>這個頁面不存在或已經移動</h1>

        <p class="description">
          你輸入的網址可能不正確，或該頁面已經被重新命名、移動或移除。
          請返回首頁，或前往資源中心繼續瀏覽。
        </p>

        <div class="button-group">
          <a class="primary-button" href="/">
            返回首頁
          </a>

          <a class="secondary-button" href="/resources">
            查看資源
          </a>

          <a class="text-button" href="/contact">
            聯絡我們
          </a>
        </div>

        <p class="language-option">
          Looking for the English website?
          <a href="/en/">Go to English</a>
        </p>
      </div>

      <!-- English content -->
      <div
        class="language-content"
        data-language="en"
        hidden
      >
        <p class="eyebrow">Page not found</p>

        <h1>This page does not exist or has moved</h1>

        <p class="description">
          The address may be incorrect, or the page may have been renamed,
          moved or removed. Return to the homepage or continue browsing our
          educational resources.
        </p>

        <div class="button-group">
          <a class="primary-button" href="/en/">
            Return Home
          </a>

          <a class="secondary-button" href="/en/resources">
            Explore Resources
          </a>

          <a class="text-button" href="/en/contact">
            Contact Us
          </a>
        </div>

        <p class="language-option">
          需要繁體中文版？
          <a href="/">前往繁中首頁</a>
        </p>
      </div>

      <div class="help-panel">
        <div class="help-icon" aria-hidden="true">iB</div>

        <div>
          <strong data-help-zh>
            仍然找不到需要的內容？
          </strong>

          <strong data-help-en hidden>
            Still cannot find what you need?
          </strong>

          <p data-help-zh>
            請寄信至
            <a href="mailto:hello@ibridge.info">
              hello@ibridge.info
            </a>
          </p>

          <p data-help-en hidden>
            Email us at
            <a href="mailto:hello@ibridge.info">
              hello@ibridge.info
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const isEnglish =
        window.location.pathname === "/en" ||
        window.location.pathname.startsWith("/en/");

      const chineseContent =
        document.querySelector('[data-language="zh"]');

      const englishContent =
        document.querySelector('[data-language="en"]');

      const chineseHelpTitle =
        document.querySelector("[data-help-zh]");

      const englishHelpTitle =
        document.querySelector("[data-help-en]");

      const chineseHelpText =
        document.querySelector("p[data-help-zh]");

      const englishHelpText =
        document.querySelector("p[data-help-en]");

      if (isEnglish) {
        if (chineseContent) chineseContent.hidden = true;
        if (englishContent) englishContent.hidden = false;

        if (chineseHelpTitle) chineseHelpTitle.hidden = true;
        if (englishHelpTitle) englishHelpTitle.hidden = false;

        if (chineseHelpText) chineseHelpText.hidden = true;
        if (englishHelpText) englishHelpText.hidden = false;

        document.documentElement.lang = "en";
        document.title = "Page Not Found | iBridge Education";
      } else {
        if (chineseContent) chineseContent.hidden = false;
        if (englishContent) englishContent.hidden = true;

        if (chineseHelpTitle) chineseHelpTitle.hidden = false;
        if (englishHelpTitle) englishHelpTitle.hidden = true;

        if (chineseHelpText) chineseHelpText.hidden = false;
        if (englishHelpText) englishHelpText.hidden = true;

        document.documentElement.lang = "zh-Hant";
        document.title = "找不到頁面 | iBridge Education";
      }
    })();
  </script>
</BaseLayout>

<style>
  .error-page {
    position: relative;
    min-height: calc(100vh - 160px);
    padding: 110px 24px 120px;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 12% 18%,
        rgba(22, 141, 145, 0.13),
        transparent 30%
      ),
      radial-gradient(
        circle at 88% 82%,
        rgba(31, 93, 160, 0.12),
        transparent 28%
      ),
      linear-gradient(
        145deg,
        #f7fbfd 0%,
        #eef7fb 52%,
        #f8fbf9 100%
      );
  }

  .error-background {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .shape {
    position: absolute;
    display: block;
    border-radius: 34%;
    filter: blur(1px);
  }

  .shape-one {
    top: 12%;
    left: 7%;
    width: 110px;
    height: 110px;
    background: rgba(11, 122, 130, 0.1);
    transform: rotate(18deg);
  }

  .shape-two {
    right: 8%;
    bottom: 12%;
    width: 150px;
    height: 150px;
    border: 28px solid rgba(25, 87, 150, 0.08);
    border-radius: 50%;
  }

  .shape-three {
    top: 24%;
    right: 15%;
    width: 72px;
    height: 72px;
    background: rgba(220, 180, 100, 0.16);
    transform: rotate(32deg);
  }

  .error-container {
    position: relative;
    z-index: 1;
    width: min(820px, 100%);
    margin: 0 auto;
    padding: 64px 64px 54px;
    border: 1px solid rgba(14, 74, 105, 0.12);
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.88);
    box-shadow:
      0 30px 80px rgba(18, 66, 96, 0.12),
      0 10px 30px rgba(18, 66, 96, 0.06);
    backdrop-filter: blur(16px);
    text-align: center;
  }

  .error-code {
    margin-bottom: 10px;
    background: linear-gradient(
      120deg,
      #0b416c,
      #0b8589
    );
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(5rem, 15vw, 9rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .eyebrow {
    margin: 28px 0 12px;
    color: #087c82;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 690px;
    margin: 0 auto;
    color: #0a355b;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .description {
    max-width: 650px;
    margin: 24px auto 0;
    color: #567086;
    font-size: 1rem;
    line-height: 1.8;
  }

  .button-group {
    margin-top: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .primary-button,
  .secondary-button,
  .text-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      background 160ms ease;
  }

  .primary-button {
    padding: 0 25px;
    background: linear-gradient(
      120deg,
      #135a92,
      #07848a
    );
    color: #ffffff;
    box-shadow: 0 12px 26px rgba(9, 94, 124, 0.2);
  }

  .secondary-button {
    padding: 0 25px;
    border: 1px solid rgba(10, 68, 105, 0.2);
    background: #ffffff;
    color: #0a426b;
  }

  .text-button {
    padding: 0 15px;
    color: #0a6777;
  }

  .primary-button:hover,
  .primary-button:focus-visible,
  .secondary-button:hover,
  .secondary-button:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(9, 73, 104, 0.17);
  }

  .language-option {
    margin: 26px 0 0;
    color: #7890a1;
    font-size: 0.84rem;
  }

  .language-option a {
    color: #08777d;
    font-weight: 700;
    text-decoration: none;
  }

  .help-panel {
    margin-top: 42px;
    padding: 20px 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    border-radius: 18px;
    background: #f2f8fa;
    text-align: left;
  }

  .help-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 13px;
    background: linear-gradient(
      145deg,
      #124c75,
      #088287
    );
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .help-panel strong {
    display: block;
    color: #153f60;
    font-size: 0.9rem;
  }

  .help-panel p {
    margin: 4px 0 0;
    color: #6d8496;
    font-size: 0.82rem;
  }

  .help-panel a {
    color: #08787e;
    font-weight: 700;
    text-decoration: none;
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 720px) {
    .error-page {
      padding: 75px 20px 90px;
    }

    .error-container {
      padding: 48px 25px 38px;
      border-radius: 25px;
    }

    .button-group {
      flex-direction: column;
      align-items: stretch;
    }

    .primary-button,
    .secondary-button,
    .text-button {
      width: 100%;
    }

    .help-panel {
      align-items: flex-start;
    }
  }

  @media (max-width: 420px) {
    .error-code {
      font-size: 5.4rem;
    }

    .description {
      font-size: 0.94rem;
    }
  }
</style>