---
import BaseLayout from "../layouts/BaseLayout.astro";

const services = [
  {
    number: "01",
    title: "課程與教學設計",
    description:
      "依據學校脈絡、學生需求與國際教育框架，設計具連貫性、挑戰性與實用性的課程。",
    link: "/services",
  },
  {
    number: "02",
    title: "教師專業發展",
    description:
      "透過工作坊、顧問支持與共同規劃，協助教師將研究、科技與教學實務有效整合。",
    link: "/services",
  },
  {
    number: "03",
    title: "教育研究與創新",
    description:
      "將教育研究、神經科學、正向心理學與人工智慧轉化為可實施的教育方案。",
    link: "/research",
  },
];

const principles = [
  {
    title: "以學習者為核心",
    description:
      "從學生的學習經驗、發展階段、語言能力與實際需求出發，而非只從課程文件出發。",
  },
  {
    title: "以研究支持實務",
    description:
      "將可信的教育研究轉化為清楚、可操作且能在真實學校情境中實施的方法。",
  },
  {
    title: "重視長期能力",
    description:
      "不只處理短期成果，也重視思考、溝通、自我管理、韌性與獨立學習能力。",
  },
  {
    title: "建立可持續系統",
    description:
      "協助學校與教師建立可以延續、調整及擴展的課程與專業學習架構。",
  },
];

const programmes = [
  "國際課程規劃與檢視",
  "MYP 與 DP 垂直銜接",
  "英語與學術寫作課程",
  "教師培訓與教學工作坊",
  "人工智慧教育應用",
  "學生學習與韌性方案",
];
---

<BaseLayout
  title="iBridge Education"
  description="iBridge Education 連結國際教育、課程設計、應用研究與實務創新，為學校、教師與學習者提供專業支持。"
  locale="zh-tw"
  zhPath="/"
  enPath="/en/"
  pageType="WebPage"
  breadcrumbs={[
    {
      name: "首頁",
      path: "/",
    },
  ]}
>
  <section class="visual-hero" aria-labelledby="home-hero-title">
    <div class="container visual-hero-container">
      <h1 id="home-hero-title" class="sr-only">
        iBridge Education：連結學習、研究與創新
      </h1>

      <picture class="visual-hero-picture">
        <img
          src="/images/home/hero-zh-2026.png"
          alt="iBridge Education：連結學習、研究與創新。國際教育、課程設計與教師專業發展。"
          width="1792"
          height="1024"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      <div class="visual-hero-actions" aria-label="首頁主要操作">
        <a class="button button-primary" href="/contact/">
          預約教育諮詢
        </a>

        <a class="button button-secondary" href="/about/">
          了解 iBridge
        </a>
      </div>
    </div>
  </section>

<!-- ===== IBRIDGE AUDIENCE PATHWAYS START ===== -->
<section
  class="audience-pathways"
  aria-labelledby="audience-pathways-title"
>
  <div class="container audience-pathways-container">
    <header class="audience-pathways-header">
      <p class="audience-pathways-eyebrow">
        探索 iBridge
      </p>

      <h2 id="audience-pathways-title">
        找到適合您的教育資源與專業支援
      </h2>

      <p class="audience-pathways-introduction">
        依照您的角色，快速瀏覽相關的 IB 教學資源、課程設計、
        專業發展與教育支援。
      </p>
    </header>

    <div class="audience-pathways-grid">
      <article class="audience-pathway-card">
        <div class="audience-pathway-number" aria-hidden="true">
          01
        </div>

        <div class="audience-pathway-icon" aria-hidden="true">
          <svg
            viewBox="0 0 48 48"
            role="img"
            focusable="false"
          >
            <path
              d="M8 10.5h13c3.3 0 6 2.7 6 6v21H14c-3.3 0-6-2.7-6-6v-21Z"
            />
            <path
              d="M40 10.5H27c-3.3 0-6 2.7-6 6v21h13c3.3 0 6-2.7 6-6v-21Z"
            />
            <path d="M24 16v22" />
          </svg>
        </div>

        <h3>IB 教師</h3>

        <p>
          探索課堂活動、單元規劃、評量工具、學術寫作及
          MYP／DP 教學資源。
        </p>

        <a
          class="audience-pathway-link"
          href="/resources/"
          aria-label="瀏覽適合 IB 教師的教育資源"
        >
          瀏覽教師資源
          <span aria-hidden="true">→</span>
        </a>
      </article>

      <article class="audience-pathway-card">
        <div class="audience-pathway-number" aria-hidden="true">
          02
        </div>

        <div class="audience-pathway-icon" aria-hidden="true">
          <svg
            viewBox="0 0 48 48"
            role="img"
            focusable="false"
          >
            <circle cx="24" cy="12" r="5" />
            <circle cx="12" cy="32" r="5" />
            <circle cx="36" cy="32" r="5" />
            <path d="M24 17v7" />
            <path d="M16.5 28 22 24" />
            <path d="M31.5 28 26 24" />
            <path d="M17 32h14" />
          </svg>
        </div>

        <h3>IB 協調員</h3>

        <p>
          建立課程一致性、垂直銜接、校本課程地圖、
          評量標準及教師合作架構。
        </p>

        <a
          class="audience-pathway-link"
          href="/programmes/"
          aria-label="瀏覽適合 IB 協調員的課程方案"
        >
          探索課程方案
          <span aria-hidden="true">→</span>
        </a>
      </article>

      <article class="audience-pathway-card">
        <div class="audience-pathway-number" aria-hidden="true">
          03
        </div>

        <div class="audience-pathway-icon" aria-hidden="true">
          <svg
            viewBox="0 0 48 48"
            role="img"
            focusable="false"
          >
            <path d="M8 39h32" />
            <path d="M12 39V19h24v20" />
            <path d="M9 19 24 9l15 10" />
            <path d="M19 39V27h10v12" />
          </svg>
        </div>

        <h3>學校領導者</h3>

        <p>
          規劃學校課程發展、教師培訓、教育研究、
          長期策略及專業顧問合作。
        </p>

        <a
          class="audience-pathway-link"
          href="/services/"
          aria-label="瀏覽適合學校領導者的專業服務"
        >
          查看專業服務
          <span aria-hidden="true">→</span>
        </a>
      </article>

      <article class="audience-pathway-card">
        <div class="audience-pathway-number" aria-hidden="true">
          04
        </div>

        <div class="audience-pathway-icon" aria-hidden="true">
          <svg
            viewBox="0 0 48 48"
            role="img"
            focusable="false"
          >
            <circle cx="18" cy="16" r="6" />
            <circle cx="33" cy="19" r="5" />
            <path d="M7 39c0-7 4.9-12 11-12s11 5 11 12" />
            <path d="M27 30c1.6-2 3.7-3 6-3 5 0 9 4.3 9 10" />
          </svg>
        </div>

        <h3>學生與家長</h3>

        <p>
          了解學術寫作、學習策略、自我管理、
          心理韌性及個人化教育支援。
        </p>

        <a
          class="audience-pathway-link"
          href="/contact/"
          aria-label="聯絡 iBridge Education 了解學生與家長支援"
        >
          了解支援方式
          <span aria-hidden="true">→</span>
        </a>
      </article>
    </div>
  </div>
</section>
<!-- ===== IBRIDGE AUDIENCE PATHWAYS END ===== -->

<!-- ===== IBRIDGE TRUST EVIDENCE START ===== -->
<section
  class="trust-evidence"
  aria-labelledby="trust-evidence-title"
>
  <div class="container trust-evidence-container">
    <div class="trust-evidence-introduction">
      <div class="trust-evidence-copy">
        <p class="trust-evidence-eyebrow">
          專業與可信度
        </p>

        <h2 id="trust-evidence-title">
          以 IB 實務、課程設計與教育研究支持學校發展
        </h2>

        <p class="trust-evidence-description">
          iBridge Education 結合 IB 教學、課程領導、評量實務與
          教育研究，協助教師與學校建立清楚、連貫且可持續發展的
          學習架構。
        </p>

        <div
          class="trust-evidence-actions"
          aria-label="了解 iBridge Education 的專業背景"
        >
          <a
            class="trust-evidence-primary-link"
            href="/about/"
          >
            認識 iBridge
            <span aria-hidden="true">→</span>
          </a>

          <a
            class="trust-evidence-secondary-link"
            href="/research/"
          >
            查看教育研究
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <aside
        class="trust-evidence-statement"
        aria-label="iBridge Education 專業聲明"
      >
        <div class="trust-evidence-quote-mark" aria-hidden="true">
          “
        </div>

        <blockquote>
          將研究轉化為實際可用的課程、評量與教師專業發展方案。
        </blockquote>

        <p>
          Research-informed educational design for real school contexts.
        </p>
      </aside>
    </div>

    <div class="trust-evidence-grid">
      <article class="trust-evidence-card">
        <div class="trust-evidence-icon" aria-hidden="true">
          <svg
            viewBox="0 0 48 48"
            role="img"
            focusable="false"
          >
            <path d="M8 12h32v24H8z" />
            <path d="M16 12v24" />
            <path d="M24 12v24" />
            <path d="M32 12v24" />
            <path d="M8 20h32" />
            <path d="M8 28h32" />
          </svg>
        </div>

        <p class="trust-evidence-value">
          3,000+
        </p>

        <h3>
          頁課程與教學資源
        </h3>

        <p>
          已發展涵蓋 MYP Language Acquisition 等課程領域的
          系統化教材與課程內容。
        </p>
      </article>

      <article class="trust-evidence-card">
        <div class="trust-evidence-icon" aria-hidden="true">
          <svg
            viewBox="0 0 48 48"
            role="img"
            focusable="false"
          >
            <circle cx="24" cy="24" r="16" />
            <path d="M8 24h32" />
            <path d="M24 8c5 5 8 10 8 16s-3 11-8 16" />
            <path d="M24 8c-5 5-8 10-8 16s3 11 8 16" />
          </svg>
        </div>

        <p class="trust-evidence-value">
          MYP＋DP
        </p>

        <h3>
          IB 課程專業
        </h3>

        <p>
          支援課程規劃、評量設計、垂直銜接、學術寫作與
          教師專業發展。
        </p>
      </article>

      <article class="trust-evidence-card">
        <div class="trust-evidence-icon" aria-hidden="true">
          <svg
            viewBox="0 0 48 48"
            role="img"
            focusable="false"
          >
            <path d="M9 11h13c3 0 5 2 5 5v21H14c-3 0-5-2-5-5V11Z" />
            <path d="M39 11H26c-3 0-5 2-5 5v21h13c3 0 5-2 5-5V11Z" />
            <path d="M15 18h6" />
            <path d="M15 24h6" />
            <path d="M27 18h6" />
            <path d="M27 24h6" />
          </svg>
        </div>

        <p class="trust-evidence-value">
          中＋英
        </p>

        <h3>
          雙語教育支援
        </h3>

        <p>
          提供繁體中文與英文內容，協助學校、教師、學生與
          家長跨語言理解與使用教育資源。
        </p>
      </article>

      <article class="trust-evidence-card">
        <div class="trust-evidence-icon" aria-hidden="true">
          <svg
            viewBox="0 0 48 48"
            role="img"
            focusable="false"
          >
            <path d="M12 38V25" />
            <path d="M24 38V17" />
            <path d="M36 38V10" />
            <path d="M8 38h32" />
            <path d="m11 20 10-6 8 3 10-9" />
          </svg>
        </div>

        <p class="trust-evidence-value">
          Research
        </p>

        <h3>
          研究導向設計
        </h3>

        <p>
          以教育研究、正向心理學、神經科學與自我調節學習
          支持課程與教學設計。
        </p>
      </article>
    </div>

    <p class="trust-evidence-disclaimer">
      iBridge Education 為獨立教育平台，並非國際文憑組織
      International Baccalaureate Organization 的官方機構，
      亦未獲其認可、贊助或背書。
    </p>
  </div>
</section>
<!-- ===== IBRIDGE TRUST EVIDENCE END ===== -->


  <section class="intro-section">
    <div class="container intro-grid">
      <div>
        <p class="section-label">我們的定位</p>

        <h2>
          教育理念必須能夠
          <span>轉化為真實的學習經驗。</span>
        </h2>
      </div>

      <div class="intro-copy">
        <p>
          iBridge Education 位於教育研究與學校實務之間。我們協助教育工作者
          釐清目標、建立課程架構、設計學習經驗，並評估方案是否真正回應學生需求。
        </p>

        <p>
          我們重視嚴謹性，但不讓教育工作被複雜術語限制。每一項合作都以清楚、
          可操作、可持續及符合學校脈絡為原則。
        </p>
      </div>
    </div>
  </section>

  <section class="services-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-label">專業服務</p>
          <h2>從策略規劃到教室實踐</h2>
        </div>

        <a class="text-link" href="/services">
          查看所有服務
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="service-grid">
        {
          services.map((service) => (
            <article class="service-card">
              <div class="service-number">{service.number}</div>

              <h3>{service.title}</h3>

              <p>{service.description}</p>

              <a href={service.link}>
                深入了解
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="principles-section">
    <div class="container principles-layout">
      <div class="principles-intro">
        <p class="section-label light-label">我們的原則</p>

        <h2>知性、穩健，並以長期發展為核心。</h2>

        <p>
          教育創新不應只追求新穎，而應建立在清楚目標、可信證據、
          專業判斷與真實學習需求之上。
        </p>

        <a class="button button-light" href="/about">
          閱讀我們的理念
        </a>
      </div>

      <div class="principles-grid">
        {
          principles.map((principle, index) => (
            <article class="principle-card">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{principle.title}</h3>
              <p>{principle.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="programmes-section">
    <div class="container programmes-grid">
      <div class="programme-copy">
        <p class="section-label">合作方向</p>

        <h2>依據學校與學習者需求，建立合適的教育方案。</h2>

        <p>
          iBridge Education 提供彈性的合作方式，可從單次工作坊、
          課程檢視與顧問諮詢，延伸至長期課程發展與研究合作。
        </p>

        <a class="button button-primary" href="/programmes">
          查看課程與方案
        </a>
      </div>

      <div class="programme-list">
        {
          programmes.map((programme, index) => (
            <div class="programme-item">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{programme}</strong>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="research-section">
    <div class="container research-card">
      <div class="research-number">R</div>

      <div class="research-content">
        <p class="section-label">研究與實務</p>

        <h2>讓教育研究成為可理解、可應用的專業資源。</h2>

        <p>
          我們關注正向心理學、教育神經科學、自我調節學習、
          人工智慧教育應用、國際課程設計與學生福祉，
          並重視研究如何在真實學校情境中產生價值。
        </p>

        <a class="text-link" href="/research">
          探索研究方向
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-card">
      <div>
        <p class="eyebrow cta-eyebrow">開始對話</p>

        <h2>共同建立更深入、更具韌性的學習經驗。</h2>

        <p>
          歡迎與我們討論課程設計、教師專業發展、人工智慧整合、
          教育研究、學校顧問或學生學習方案。
        </p>
      </div>

      <a class="button button-white" href="/contact">
        聯絡 iBridge
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  :global(body) {
    overflow-x: hidden;
  }

  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding: 112px 0 104px;
    background:
      linear-gradient(120deg, #f6fbfa 0%, #edf8f6 54%, #e6f4f3 100%);
  }

  .hero-background {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-circle {
    position: absolute;
    display: block;
    border: 1px solid rgba(11, 102, 117, 0.18);
    border-radius: 999px;
  }

  .hero-circle-one {
    width: 520px;
    height: 520px;
    top: -230px;
    right: -110px;
  }

  .hero-circle-two {
    width: 350px;
    height: 350px;
    right: 160px;
    bottom: -245px;
  }

  .hero-line {
    position: absolute;
    width: 660px;
    height: 1px;
    right: -100px;
    top: 54%;
    background: rgba(11, 102, 117, 0.2);
    transform: rotate(-18deg);
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(300px, 0.55fr);
    gap: 76px;
    align-items: center;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 18px;
    color: #0b6675;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 830px;
    margin: 0;
    color: #0a355b;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 6.2vw, 5.65rem);
    font-weight: 600;
    line-height: 0.99;
    letter-spacing: -0.045em;
  }

  .hero h1 span {
    display: block;
    margin-top: 14px;
    color: #0b6675;
  }

  .hero-description {
    max-width: 710px;
    margin: 34px 0 0;
    color: #49677e;
    font-size: 1.08rem;
    line-height: 1.85;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 38px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 24px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-weight: 750;
    line-height: 1;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background 180ms ease,
      color 180ms ease,
      border-color 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: #0a4d70;
    color: #ffffff;
  }

  .button-primary:hover {
    background: #083e5b;
  }

  .button-secondary {
