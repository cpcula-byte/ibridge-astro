---
import BaseLayout from "../layouts/BaseLayout.astro";

const services = [
  {
    number: "01",
    title: "課程與教學設計",
    description:
      "依據學校脈絡、學生需求與國際教育框架，設計具連貫性、挑戰性與實用性的課程。",
    link: "/services",
  },
  {
    number: "02",
    title: "教師專業發展",
    description:
      "透過工作坊、顧問支持與共同規劃，協助教師將研究、科技與教學實務有效整合。",
    link: "/services",
  },
  {
    number: "03",
    title: "教育研究與創新",
    description:
      "將教育研究、神經科學、正向心理學與人工智慧轉化為可實施的教育方案。",
    link: "/research",
  },
];

const principles = [
  {
    title: "以學習者為核心",
    description:
      "從學生的學習經驗、發展階段、語言能力與實際需求出發，而非只從課程文件出發。",
  },
  {
    title: "以研究支持實務",
    description:
      "將可信的教育研究轉化為清楚、可操作且能在真實學校情境中實施的方法。",
  },
  {
    title: "重視長期能力",
    description:
      "不只處理短期成果，也重視思考、溝通、自我管理、韌性與獨立學習能力。",
  },
  {
    title: "建立可持續系統",
    description:
      "協助學校與教師建立可以延續、調整及擴展的課程與專業學習架構。",
  },
];

const programmes = [
  "國際課程規劃與檢視",
  "MYP 與 DP 垂直銜接",
  "英語與學術寫作課程",
  "教師培訓與教學工作坊",
  "人工智慧教育應用",
  "學生學習與韌性方案",
];
---

<BaseLayout
  title="iBridge Education"
  description="iBridge Education 連結國際教育、教育研究與實務創新，提供課程設計、教師專業發展、教育研究、人工智慧整合與學生學習方案。"
  locale="zh-tw"
  zhPath="/"
  enPath="/en/"
  pageType="WebPage"
  breadcrumbs={[
    {
      name: "首頁",
      path: "/",
    },
  ]}
>
  <section class="hero">
    <div class="hero-background" aria-hidden="true">
      <span class="hero-circle hero-circle-one"></span>
      <span class="hero-circle hero-circle-two"></span>
      <span class="hero-line"></span>
    </div>

    <div class="container hero-container">
      <div class="hero-content">
        <p class="eyebrow">國際教育・研究・創新</p>

        <h1>
          連結學習、研究與創新，
          <span>建立更深度且更具韌性的教育經驗。</span>
        </h1>

        <p class="hero-description">
          iBridge Education 協助學校、教師與學生，將國際課程、
          教育研究、人工智慧與教學實務轉化為清楚、可行且具長期影響力的教育方案。
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="/contact">
            預約教育諮詢
          </a>

          <a class="button button-secondary" href="/about">
            了解 iBridge
          </a>
        </div>
      </div>

      <aside class="hero-panel" aria-label="iBridge Education 服務重點">
        <p class="panel-label">我們所連結的領域</p>

        <ul>
          <li>
            <span>01</span>
            <strong>課程與教學設計</strong>
          </li>
          <li>
            <span>02</span>
            <strong>教師專業發展</strong>
          </li>
          <li>
            <span>03</span>
            <strong>教育研究與創新</strong>
          </li>
          <li>
            <span>04</span>
            <strong>人工智慧教育應用</strong>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="intro-section">
    <div class="container intro-grid">
      <div>
        <p class="section-label">我們的定位</p>

        <h2>
          教育理念必須能夠
          <span>轉化為真實的學習經驗。</span>
        </h2>
      </div>

      <div class="intro-copy">
        <p>
          iBridge Education 位於教育研究與學校實務之間。我們協助教育工作者
          釐清目標、建立課程架構、設計學習經驗，並評估方案是否真正回應學生需求。
        </p>

        <p>
          我們重視嚴謹性，但不讓教育工作被複雜術語限制。每一項合作都以清楚、
          可操作、可持續及符合學校脈絡為原則。
        </p>
      </div>
    </div>
  </section>

  <section class="services-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-label">專業服務</p>
          <h2>從策略規劃到教室實踐</h2>
        </div>

        <a class="text-link" href="/services">
          查看所有服務
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="service-grid">
        {
          services.map((service) => (
            <article class="service-card">
              <div class="service-number">{service.number}</div>

              <h3>{service.title}</h3>

              <p>{service.description}</p>

              <a href={service.link}>
                深入了解
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="principles-section">
    <div class="container principles-layout">
      <div class="principles-intro">
        <p class="section-label light-label">我們的原則</p>

        <h2>知性、穩健，並以長期發展為核心。</h2>

        <p>
          教育創新不應只追求新穎，而應建立在清楚目標、可信證據、
          專業判斷與真實學習需求之上。
        </p>

        <a class="button button-light" href="/about">
          閱讀我們的理念
        </a>
      </div>

      <div class="principles-grid">
        {
          principles.map((principle, index) => (
            <article class="principle-card">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{principle.title}</h3>
              <p>{principle.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="programmes-section">
    <div class="container programmes-grid">
      <div class="programme-copy">
        <p class="section-label">合作方向</p>

        <h2>依據學校與學習者需求，建立合適的教育方案。</h2>

        <p>
          iBridge Education 提供彈性的合作方式，可從單次工作坊、
          課程檢視與顧問諮詢，延伸至長期課程發展與研究合作。
        </p>

        <a class="button button-primary" href="/programmes">
          查看課程與方案
        </a>
      </div>

      <div class="programme-list">
        {
          programmes.map((programme, index) => (
            <div class="programme-item">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{programme}</strong>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="research-section">
    <div class="container research-card">
      <div class="research-number">R</div>

      <div class="research-content">
        <p class="section-label">研究與實務</p>

        <h2>讓教育研究成為可理解、可應用的專業資源。</h2>

        <p>
          我們關注正向心理學、教育神經科學、自我調節學習、
          人工智慧教育應用、國際課程設計與學生福祉，
          並重視研究如何在真實學校情境中產生價值。
        </p>

        <a class="text-link" href="/research">
          探索研究方向
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-card">
      <div>
        <p class="eyebrow cta-eyebrow">開始對話</p>

        <h2>共同建立更深入、更具韌性的學習經驗。</h2>

        <p>
          歡迎與我們討論課程設計、教師專業發展、人工智慧整合、
          教育研究、學校顧問或學生學習方案。
        </p>
      </div>

      <a class="button button-white" href="/contact">
        聯絡 iBridge
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  :global(body) {
    overflow-x: hidden;
  }

  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding: 112px 0 104px;
    background:
      linear-gradient(120deg, #f6fbfa 0%, #edf8f6 54%, #e6f4f3 100%);
  }

  .hero-background {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-circle {
    position: absolute;
    display: block;
    border: 1px solid rgba(11, 102, 117, 0.18);
    border-radius: 999px;
  }

  .hero-circle-one {
    width: 520px;
    height: 520px;
    top: -230px;
    right: -110px;
  }

  .hero-circle-two {
    width: 350px;
    height: 350px;
    right: 160px;
    bottom: -245px;
  }

  .hero-line {
    position: absolute;
    width: 660px;
    height: 1px;
    right: -100px;
    top: 54%;
    background: rgba(11, 102, 117, 0.2);
    transform: rotate(-18deg);
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(300px, 0.55fr);
    gap: 76px;
    align-items: center;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 18px;
    color: #0b6675;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 830px;
    margin: 0;
    color: #0a355b;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 6.2vw, 5.65rem);
    font-weight: 600;
    line-height: 0.99;
    letter-spacing: -0.045em;
  }

  .hero h1 span {
    display: block;
    margin-top: 14px;
    color: #0b6675;
  }

  .hero-description {
    max-width: 710px;
    margin: 34px 0 0;
    color: #49677e;
    font-size: 1.08rem;
    line-height: 1.85;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 38px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 24px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-weight: 750;
    line-height: 1;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background 180ms ease,
      color 180ms ease,
      border-color 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: #0a4d70;
    color: #ffffff;
  }

  .button-primary:hover {
    background: #083e5b;
  }

  .button-secondary {
    border-color: rgba(10, 53, 91, 0.22);
    background: rgba(255, 255, 255, 0.64);
    color: #0a355b;
  }

  .button-secondary:hover {
    border-color: #0b6675;
    background: #ffffff;
  }

  .hero-panel {
    padding: 30px;
    border: 1px solid rgba(10, 53, 91, 0.1);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.76);
    box-shadow: 0 24px 70px rgba(10, 53, 91, 0.1);
    backdrop-filter: blur(10px);
  }

  .panel-label {
    margin: 0 0 22px;
    color: #668095;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.13em;
  }

  .hero-panel ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-panel li {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 14px;
    align-items: center;
    padding: 18px 0;
    border-top: 1px solid rgba(10, 53, 91, 0.1);
  }

  .hero-panel li:first-child {
    border-top: 0;
  }

  .hero-panel span {
    color: #0b6675;
    font-size: 0.74rem;
    font-weight: 800;
  }

  .hero-panel strong {
    color: #183f61;
    font-size: 0.98rem;
  }

  .intro-section,
  .services-section,
  .programmes-section,
  .research-section {
    padding: 104px 0;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 100px;
    align-items: start;
  }

  .intro-grid h2,
  .section-heading h2,
  .principles-intro h2,
  .programme-copy h2,
  .research-content h2,
  .cta-card h2 {
    margin: 0;
    color: #0a355b;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.35rem, 4vw, 4.25rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .intro-grid h2 span {
    display: block;
    color: #0b6675;
  }

  .intro-copy {
    display: grid;
    gap: 24px;
    padding-top: 34px;
  }

  .intro-copy p,
  .principles-intro > p,
  .programme-copy > p,
  .research-content > p,
  .cta-card p {
    margin: 0;
    color: #577084;
    font-size: 1.03rem;
    line-height: 1.85;
  }

  .services-section {
    background: #f7fafb;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    align-items: end;
    margin-bottom: 48px;
  }

  .section-heading h2 {
    font-size: clamp(2.3rem, 3.7vw, 3.8rem);
  }

  .text-link {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    color: #0a4d70;
    font-weight: 800;
    text-decoration: none;
  }

  .text-link:hover {
    color: #0b6675;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .service-card {
    display: flex;
    min-height: 330px;
    flex-direction: column;
    padding: 32px;
    border: 1px solid rgba(10, 53, 91, 0.1);
    border-radius: 20px;
    background: #ffffff;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .service-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 24px 55px rgba(10, 53, 91, 0.1);
  }

  .service-number {
    margin-bottom: 54px;
    color: #0b6675;
    font-size: 0.76rem;
    font-weight: 800;
  }

  .service-card h3 {
    margin: 0;
    color: #123d5f;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.65rem;
  }

  .service-card p {
    margin: 18px 0 30px;
    color: #62798b;
    line-height: 1.75;
  }

  .service-card a {
    display: inline-flex;
    gap: 8px;
    margin-top: auto;
    color: #0a4d70;
    font-weight: 800;
    text-decoration: none;
  }

  .principles-section {
    padding: 110px 0;
    background: #082d50;
  }

  .principles-layout {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 86px;
    align-items: start;
  }

  .light-label {
    color: #7ed1ca;
  }

  .principles-intro h2 {
    color: #ffffff;
    font-size: clamp(2.4rem, 4vw, 4.15rem);
  }

  .principles-intro > p {
    margin-top: 26px;
    color: #c2d0dc;
  }

  .button-light {
    margin-top: 34px;
    border-color: rgba(255, 255, 255, 0.36);
    color: #ffffff;
  }

  .button-light:hover {
    background: #ffffff;
    color: #082d50;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .principle-card {
    padding: 26px;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.045);
  }

  .principle-card > span {
    color: #6fc5c0;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .principle-card h3 {
    margin: 24px 0 12px;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.35rem;
  }

  .principle-card p {
    margin: 0;
    color: #bdcbd6;
    line-height: 1.7;
  }

  .programmes-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 90px;
    align-items: center;
  }

  .programme-copy h2 {
    font-size: clamp(2.35rem, 3.8vw, 4rem);
  }

  .programme-copy > p {
    margin-top: 26px;
  }

  .programme-copy .button {
    margin-top: 34px;
  }

  .programme-list {
    border-top: 1px solid rgba(10, 53, 91, 0.14);
  }

  .programme-item {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid rgba(10, 53, 91, 0.14);
  }

  .programme-item span {
    color: #0b6675;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .programme-item strong {
    color: #173f60;
    font-size: 1.02rem;
  }

  .research-section {
    padding-top: 20px;
  }

  .research-card {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 58px;
    padding: 66px;
    border-radius: 28px;
    background:
      linear-gradient(135deg, #edf8f6 0%, #f8fbfc 100%);
  }

  .research-number {
    color: rgba(11, 102, 117, 0.17);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 9rem;
    line-height: 0.8;
  }

  .research-content h2 {
    max-width: 790px;
    font-size: clamp(2.2rem, 3.5vw, 3.7rem);
  }

  .research-content > p {
    max-width: 780px;
    margin-top: 24px;
  }

  .research-content .text-link {
    margin-top: 26px;
  }

  .cta-section {
    padding: 20px 0 100px;
  }

  .cta-card {
    display: flex;
    justify-content: space-between;
    gap: 60px;
    align-items: center;
    padding: 58px 62px;
    border-radius: 26px;
    background:
      linear-gradient(115deg, #0a355b 0%, #0b6675 68%, #18828d 100%);
  }

  .cta-card > div {
    max-width: 760px;
  }

  .cta-eyebrow {
    color: #a8e4df;
  }

  .cta-card h2 {
    color: #ffffff;
    font-size: clamp(2.2rem, 3.8vw, 3.9rem);
  }

  .cta-card p {
    margin-top: 22px;
    color: #d3e2e7;
  }

  .button-white {
    flex: 0 0 auto;
    background: #ffffff;
    color: #0a355b;
  }

  .button-white:hover {
    background: #eaf7f5;
  }

  @media (max-width: 980px) {
    .hero-container,
    .intro-grid,
    .principles-layout,
    .programmes-grid {
      grid-template-columns: 1fr;
      gap: 54px;
    }

    .hero-panel {
      max-width: 620px;
    }

    .service-grid {
      grid-template-columns: 1fr;
    }

    .service-card {
      min-height: auto;
    }

    .service-number {
      margin-bottom: 30px;
    }

    .research-card {
      grid-template-columns: 1fr;
    }

    .research-number {
      font-size: 5.5rem;
    }

    .cta-card {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 680px) {
    .container {
      width: min(100% - 30px, 1180px);
    }

    .hero {
      padding: 82px 0 76px;
    }

    .hero h1 {
      font-size: clamp(2.65rem, 14vw, 4.2rem);
    }

    .intro-section,
    .services-section,
    .programmes-section,
    .research-section {
      padding: 76px 0;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .principles-grid {
      grid-template-columns: 1fr;
    }

    .research-card,
    .cta-card {
      padding: 34px 26px;
    }

    .cta-section {
      padding-bottom: 74px;
    }
  }
</style>