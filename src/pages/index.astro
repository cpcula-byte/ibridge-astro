---
import BaseLayout from "../layouts/BaseLayout.astro";
import Cta from "../components/Cta.astro";

const services = [
  [
    "01",
    "課程與教學設計",
    "依據學校脈絡、學生需求與國際教育框架，建立連貫、具挑戰性且可實施的課程。",
    "/services/",
  ],
  [
    "02",
    "教師專業發展",
    "透過工作坊、共同規劃與顧問支持，連結研究、科技與教室實務。",
    "/services/",
  ],
  [
    "03",
    "教育研究與創新",
    "將教育神經科學、正向心理學與人工智慧轉化為可使用的教育方案。",
    "/research/",
  ],
];

const principles = [
  ["01", "以學習者為核心", "從學生的發展階段、語言能力與真實學習需求出發。"],
  ["02", "以研究支持實務", "將可信證據轉化為教師與學校可操作的方法。"],
  ["03", "重視長期能力", "同時發展思考、溝通、自我管理、韌性與獨立學習。"],
  ["04", "建立可持續系統", "設計能延續、調整與擴展的課程及專業學習架構。"],
];

const programmes = [
  "國際課程規劃與檢視",
  "MYP 與 DP 垂直銜接",
  "英語與學術寫作課程",
  "教師培訓與教學工作坊",
  "人工智慧教育應用",
  "學生學習與韌性方案",
];
---

<BaseLayout
  title="iBridge Education"
  description="iBridge Education 連結國際教育、課程設計、應用研究與實務創新，為學校、教師與學習者提供專業支持。"
  locale="zh-Hant"
  zhPath="/"
  enPath="/en/"
>
  <section class="visual-hero" aria-labelledby="home-hero-title">
    <div class="container visual-hero-container">
      <h1 id="home-hero-title" class="sr-only">
        iBridge Education：連結學習、研究與創新
      </h1>

      <picture class="visual-hero-picture">
        <source
          srcset="/images/home/hero-zh-2026.webp?v=20260729-approved-01"
          type="image/webp"
        />
        <img
          src="/images/home/hero-zh-2026.png?v=20260729-approved-01"
          alt="iBridge Education：連結學習，啟發未來。"
          width="1672"
          height="941"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      <div class="visual-hero-actions" aria-label="首頁主要操作">
        <a class="button button-primary" href="/contact/">
          預約教育諮詢
        </a>

        <a class="button button-secondary" href="/about/">
          了解 iBridge
        </a>
      </div>
    </div>
  </section>

  <section class="section section-ivory">
    <div class="container split">
      <div>
        <p class="eyebrow">我們的定位</p>
        <h2>教育理念必須轉化為真實的學習經驗。</h2>
      </div>

      <div class="prose">
        <p>
          iBridge Education 位於教育研究與學校實務之間。我們協助教育工作者釐清目標、
          建立課程架構、設計學習經驗，並評估方案是否真正回應學生需求。
        </p>
        <p>
          我們重視嚴謹性，但不讓教育工作被複雜術語限制。每一項合作都以清楚、
          可操作、可持續及符合學校脈絡為原則。
        </p>
      </div>
    </div>
  </section>

  <section class="section section-white">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">專業服務</p>
          <h2>從策略規劃到教室實踐</h2>
        </div>
        <a class="text-link" href="/services/">查看所有服務 →</a>
      </div>

      <div class="grid-3">
        {
          services.map(([number, title, description, link]) => (
            <article class="card">
              <span class="card-number">{number}</span>
              <h3>{title}</h3>
              <p>{description}</p>
              <a class="text-link" href={link}>深入了解 ↗</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow eyebrow-light">我們的原則</p>
          <h2>知性、穩健，並以長期發展為核心。</h2>
        </div>
      </div>

      <div class="grid-4">
        {
          principles.map(([number, title, description]) => (
            <article class="card dark-card">
              <span class="card-number">{number}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-ivory">
    <div class="container split">
      <div>
        <p class="eyebrow">合作方向</p>
        <h2>依據學校與學習者需求，建立合適方案。</h2>
        <p>
          合作可從單次工作坊、課程檢視與顧問諮詢，延伸至長期課程發展、
          教師學習與研究合作。
        </p>
        <a class="button button-primary" href="/programmes/">查看課程與方案</a>
      </div>

      <div class="list-panel">
        {
          programmes.map((item, index) => (
            <div class="list-row">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{item}</strong>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-white">
    <div class="container card research-summary-card">
      <p class="eyebrow">研究與實務</p>
      <h2>讓教育研究成為可理解、可應用的專業資源。</h2>
      <p class="lead">
        我們關注正向心理學、教育神經科學、自我調節學習、人工智慧教育應用、
        國際課程設計與學生福祉，並重視研究如何在真實學校情境中產生價值。
      </p>
      <a class="text-link" href="/research/">探索研究方向 →</a>
    </div>
  </section>

  <Cta
    eyebrow="開始對話"
    title="共同建立更深入、更具韌性的學習經驗。"
    copy="歡迎討論課程設計、教師專業發展、人工智慧整合、教育研究、學校顧問或學生學習方案。"
    label="聯絡 iBridge"
    href="/contact/"
  />
</BaseLayout>
