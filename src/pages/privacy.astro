---
import BaseLayout from "../layouts/BaseLayout.astro";

const lastUpdated = "2026 年 7 月 26 日";

const policySections = [
  {
    number: "01",
    id: "information-collected",
    title: "我們收集的資訊",
    paragraphs: [
      "當您使用 iBridge Education 網站、聯絡表單或電子郵件與我們聯絡時，我們可能收集您主動提供的基本資料。",
      "這些資料可能包括姓名、電子郵件地址、學校或組織名稱、職務、合作需求、預計參與對象、預計時間，以及您在訊息中提供的其他內容。",
    ],
    items: [
      "姓名與電子郵件地址",
      "學校、教育機構或組織名稱",
      "職務或專業角色",
      "課程、研究、培訓或資源需求",
      "您主動提供的其他相關資訊",
    ],
  },
  {
    number: "02",
    id: "information-use",
    title: "資訊使用方式",
    paragraphs: [
      "我們只會在提供網站服務、回覆詢問與評估合作需求所需的合理範圍內使用您提供的資料。",
    ],
    items: [
      "回覆聯絡表單或電子郵件詢問",
      "評估課程、研究、培訓或教育資源合作",
      "安排會議或後續溝通",
      "改善網站內容、資源與使用體驗",
      "維護網站安全並防止垃圾訊息或濫用",
      "遵守適用的法律或行政要求",
    ],
  },
  {
    number: "03",
    id: "formspree",
    title: "聯絡表單與 Formspree",
    paragraphs: [
      "iBridge Education 使用 Formspree 處理網站聯絡表單。當您送出表單時，資料會透過 Formspree 系統傳送，並可能儲存在其服務中。",
      "Formspree 是獨立的第三方服務提供者，其資料處理亦受 Formspree 自身的隱私權政策與服務條款規範。",
      "請勿透過聯絡表單傳送學生姓名、身分證件號碼、健康資料、個人成績、特殊教育資料、財務資料或其他不必要的敏感資訊。",
    ],
    items: [],
  },
  {
    number: "04",
    id: "technical-data",
    title: "Cookie 與技術資料",
    paragraphs: [
      "本網站可能使用必要的技術資料、快取、伺服器記錄與安全功能，以維持網站正常運作、改善效能及防止惡意流量。",
      "技術資料可能包括瀏覽器類型、裝置類型、請求時間、概略地區、來源頁面、IP 位址與伺服器記錄。",
      "目前網站不以建立個人廣告檔案為目的使用這些資料。未來若加入分析、廣告或其他非必要 Cookie，本政策將視需要更新。",
    ],
    items: [],
  },
  {
    number: "05",
    id: "cloudflare",
    title: "Cloudflare 與網站託管",
    paragraphs: [
      "本網站使用 Cloudflare Pages、DNS、安全與內容傳遞服務。",
      "Cloudflare 可能依服務運作需要處理網路請求、安全記錄及其他技術資訊。Cloudflare 的資料處理方式受其自身政策與適用條款規範。",
    ],
    items: [],
  },
  {
    number: "06",
    id: "sharing",
    title: "資訊分享與揭露",
    paragraphs: [
      "我們不會出售您的個人資料。",
      "在提供網站及處理詢問所必要的情況下，有限的資料可能由 Formspree、Cloudflare、電子郵件服務或網站維護工具處理。",
      "我們也可能在法律要求、保障網站安全、調查濫用行為或保護合法權益時揭露必要資訊。",
    ],
    items: [],
  },
  {
    number: "07",
    id: "retention",
    title: "資料保存",
    paragraphs: [
      "我們只會在處理詢問、維持合作紀錄、履行行政需求或遵守法律義務所需的期間內保存資料。",
      "不再需要的資料將依合理方式刪除、匿名化或停止使用。",
      "第三方服務的資料保存期間可能依其自身系統與政策而有所不同。",
    ],
    items: [],
  },
  {
    number: "08",
    id: "security",
    title: "資料安全",
    paragraphs: [
      "我們採取合理的技術與行政措施保護網站與收到的資訊，包括 HTTPS、Cloudflare 安全功能、帳戶權限管理及必要的存取限制。",
      "然而，任何網路傳輸或電子儲存方式都無法保證絕對安全，因此請勿透過網站傳送不必要的敏感資料。",
    ],
    items: [],
  },
  {
    number: "09",
    id: "students",
    title: "兒童與學生資料",
    paragraphs: [
      "本網站主要面向教師、學校、教育工作者、研究者與教育機構，而不是設計供兒童自行提交個人資料。",
      "未成年人不應在缺乏家長、監護人、教師或學校適當指導的情況下透過本網站提交個人資料。",
      "學校或教育工作者在初步詢問中，不應提供可識別個別學生的資料。",
    ],
    items: [],
  },
  {
    number: "10",
    id: "rights",
    title: "您的資料權利",
    paragraphs: [
      "視您所在地適用法律而定，您可能有權要求查詢、更正、限制使用或刪除我們持有的個人資料。",
      "您也可以要求我們說明資料用途，或撤回先前提供的同意。部分資料可能因法律、行政或安全理由需要繼續保存。",
    ],
    items: [],
  },
  {
    number: "11",
    id: "external-links",
    title: "外部連結",
    paragraphs: [
      "本網站可能連結至第三方網站、教育平台、下載服務或其他外部資源。",
      "外部網站由各自的營運者負責，其隱私、安全與內容政策不受本政策控制。使用外部網站前，請閱讀其相關政策。",
    ],
    items: [],
  },
  {
    number: "12",
    id: "updates",
    title: "政策更新",
    paragraphs: [
      "我們可能因網站功能、服務供應商、法律要求或資料處理方式改變而更新本隱私權政策。",
      "更新後的版本將發布於本頁，並標示最近更新日期。",
    ],
    items: [],
  },
];

const quickLinks = [
  {
    href: "#information-collected",
    label: "收集的資訊",
  },
  {
    href: "#information-use",
    label: "資訊用途",
  },
  {
    href: "#formspree",
    label: "Formspree",
  },
  {
    href: "#technical-data",
    label: "技術資料",
  },
  {
    href: "#sharing",
    label: "資訊分享",
  },
  {
    href: "#rights",
    label: "您的權利",
  },
];
---

<BaseLayout
  title="隱私權政策"
  description="了解 iBridge Education 如何收集、使用、保存與保護網站訪客及聯絡表單使用者提供的資訊。"
  locale="zh-tw"
>
  <section class="page-hero">
    <div class="hero-decoration" aria-hidden="true">
      <span class="hero-circle hero-circle-one"></span>
      <span class="hero-circle hero-circle-two"></span>
      <span class="hero-line"></span>
    </div>

    <div class="container hero-grid">
      <div>
        <p class="eyebrow">隱私權政策</p>

        <h1>
          清楚說明我們如何處理
          <span>網站與聯絡表單資料。</span>
        </h1>
      </div>

      <div class="hero-copy">
        <p>
          本政策說明 iBridge Education 收集哪些資訊、
          為何使用這些資訊，以及您可以如何聯絡我們提出資料相關要求。
        </p>

        <div class="updated-card">
          <span>最近更新</span>
          <strong>{lastUpdated}</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="summary-section">
    <div class="container summary-grid">
      <div>
        <p class="section-label">政策摘要</p>

        <h2>
          我們只收集提供服務與回覆詢問所需的資訊。
        </h2>
      </div>

      <div class="summary-card">
        <p>
          iBridge Education 不出售個人資料，也不要求訪客透過聯絡表單
          提供學生資料、健康資訊、成績或其他敏感內容。
        </p>

        <p>
          聯絡表單由 Formspree 處理；網站託管、DNS、
          安全及內容傳遞服務由 Cloudflare 提供。
        </p>
      </div>
    </div>
  </section>

  <section class="policy-section">
    <div class="container policy-layout">
      <aside class="policy-sidebar">
        <div class="navigation-card">
          <p class="navigation-title">快速導覽</p>

          <nav aria-label="隱私權政策章節">
            <ul>
              {
                quickLinks.map((link) => (
                  <li>
                    <a href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        <div class="contact-card">
          <p>資料相關詢問</p>

          <a href="mailto:hello@ibridge.info">
            hello@ibridge.info
          </a>
        </div>
      </aside>

      <div class="policy-content">
        {
          policySections.map((section) => (
            <article
              id={section.id}
              class="policy-item"
            >
              <div class="policy-number">
                {section.number}
              </div>

              <div class="policy-text">
                <h2>{section.title}</h2>

                {
                  section.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))
                }

                {
                  section.items.length > 0 && (
                    <ul>
                      {
                        section.items.map((item) => (
                          <li>{item}</li>
                        ))
                      }
                    </ul>
                  )
                }
              </div>
            </article>
          ))
        }

        <article
          id="contact-information"
          class="policy-item"
        >
          <div class="policy-number">
            13
          </div>

          <div class="policy-text">
            <h2>聯絡方式</h2>

            <p>
              對本隱私權政策、資料使用方式或個人資料要求有任何問題，
              請透過以下方式聯絡：
            </p>

            <dl class="contact-details">
              <div>
                <dt>組織</dt>
                <dd>iBridge Education</dd>
              </div>

              <div>
                <dt>電子郵件</dt>
                <dd>
                  <a href="mailto:hello@ibridge.info">
                    hello@ibridge.info
                  </a>
                </dd>
              </div>

              <div>
                <dt>網站</dt>
                <dd>
                  <a href="https://ibridge.info">
                    ibridge.info
                  </a>
                </dd>
              </div>
            </dl>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="notice-section">
    <div class="container notice-card">
      <div>
        <p class="section-label light-label">
          重要提醒
        </p>

        <h2>
          請勿透過網站傳送學生或其他人士的敏感個人資料。
        </h2>

        <p>
          初步合作詢問只需提供一般聯絡資料與需求說明。
          需要交換其他資料時，我們會先確認合適且安全的處理方式。
        </p>
      </div>

      <a href="/contact">
        聯絡我們
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .page-hero {
    position: relative;
    overflow: hidden;
    padding: 112px 0 104px;
    background:
      radial-gradient(
        circle at 88% 14%,
        rgba(196, 138, 44, 0.12),
        transparent 28%
      ),
      linear-gradient(
        125deg,
        #f7f1e3 0%,
        #faf7f0 100%
      );
  }

  .hero-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-circle {
    position: absolute;
    border: 1px solid rgba(165, 28, 48, 0.16);
    border-radius: 999px;
  }

  .hero-circle-one {
    top: -270px;
    right: -90px;
    width: 520px;
    height: 520px;
  }

  .hero-circle-two {
    right: 240px;
    bottom: -175px;
    width: 260px;
    height: 260px;
  }

  .hero-line {
    position: absolute;
    top: 58%;
    right: -120px;
    width: 700px;
    height: 1px;
    background: rgba(165, 28, 48, 0.16);
    transform: rotate(-16deg);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 90px;
    align-items: end;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 18px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    color: #1f2933;
    font-family:
      "Helvetica Neue",
      Helvetica,
      Arial,
      "PingFang TC",
      sans-serif;
    font-weight: 700;
    letter-spacing: -0.045em;
  }

  h1 {
    font-size: clamp(3.1rem, 6.2vw, 5.7rem);
    line-height: 0.99;
  }

  h1 span {
    display: block;
    margin-top: 14px;
    color: #a51c30;
  }

  .hero-copy {
    display: grid;
    gap: 28px;
  }

  .hero-copy > p,
  .summary-card p,
  .policy-text p,
  .notice-card p {
    margin: 0;
    color: #52606d;
    font-size: 1.03rem;
    line-height: 1.85;
  }

  .updated-card {
    display: grid;
    gap: 5px;
    width: fit-content;
    padding: 18px 22px;
    border: 1px solid #e4d7c5;
    border-radius: 14px;
    background: #faf7f0;
  }

  .updated-card span {
    color: #315c6b;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .updated-card strong {
    color: #1f2933;
  }

  .summary-section,
  .policy-section {
    padding: 104px 0;
  }

  .summary-section {
    background: #faf7f0;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 80px;
    align-items: start;
  }

  .summary-grid h2,
  .notice-card h2 {
    font-size: clamp(2.35rem, 4vw, 4.1rem);
    line-height: 1.08;
  }

  .summary-card {
    display: grid;
    gap: 22px;
    padding: 36px;
    border: 1px solid #e4d7c5;
    border-radius: 22px;
    background: #f7f1e3;
  }

  .policy-section {
    background: #f7f1e3;
  }

  .policy-layout {
    display: grid;
    grid-template-columns: 270px 1fr;
    gap: 72px;
    align-items: start;
  }

  .policy-sidebar {
    position: sticky;
    top: 116px;
    display: grid;
    gap: 18px;
  }

  .navigation-card,
  .contact-card {
    border: 1px solid #e4d7c5;
    border-radius: 18px;
    background: #faf7f0;
  }

  .navigation-card {
    padding: 26px;
  }

  .navigation-title,
  .contact-card p {
    margin: 0 0 16px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .navigation-card ul {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .navigation-card a {
    display: block;
    padding: 9px 0;
    color: #315c6b;
    font-size: 0.94rem;
    font-weight: 700;
    text-decoration: none;
  }

  .navigation-card a:hover {
    color: #a51c30;
  }

  .contact-card {
    padding: 24px;
  }

  .contact-card a {
    color: #315c6b;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .policy-content {
    border-top: 1px solid #e4d7c5;
  }

  .policy-item {
    display: grid;
    grid-template-columns: 62px 1fr;
    gap: 26px;
    padding: 48px 0;
    border-bottom: 1px solid #e4d7c5;
    scroll-margin-top: 112px;
  }

  .policy-number {
    padding-top: 8px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .policy-text h2 {
    margin-bottom: 23px;
    font-size: clamp(1.65rem, 3vw, 2.45rem);
    line-height: 1.15;
  }

  .policy-text p + p {
    margin-top: 17px;
  }

  .policy-text ul {
    display: grid;
    gap: 11px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .policy-text li {
    position: relative;
    padding-left: 20px;
    color: #52606d;
    line-height: 1.7;
  }

  .policy-text li::before {
    position: absolute;
    top: 0.68em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #c48a2c;
    content: "";
  }

  .contact-details {
    margin: 28px 0 0;
    border-top: 1px solid #e4d7c5;
  }

  .contact-details > div {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 20px;
    padding: 17px 0;
    border-bottom: 1px solid #e4d7c5;
  }

  .contact-details dt {
    color: #a51c30;
    font-weight: 700;
  }

  .contact-details dd {
    margin: 0;
    color: #1f2933;
  }

  .contact-details a {
    color: #315c6b;
    font-weight: 700;
  }

  .notice-section {
    padding: 20px 0 100px;
    background: #f7f1e3;
  }

  .notice-card {
    display: flex;
    justify-content: space-between;
    gap: 60px;
    align-items: center;
    padding: 58px 62px;
    border-radius: 26px;
    background:
      linear-gradient(
        115deg,
        #7b1422 0%,
        #a51c30 72%,
        #a51c30 100%
      );
  }

  .notice-card > div {
    max-width: 820px;
  }

  .light-label {
    color: #f2c66d;
  }

  .notice-card h2 {
    color: #ffffff;
  }

  .notice-card p {
    margin-top: 22px;
    color: rgba(255, 255, 255, 0.82);
  }

  .notice-card > a {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    padding: 0 25px;
    border-radius: 999px;
    background: #ffffff;
    color: #7b1422;
    font-weight: 700;
    text-decoration: none;
  }

  .notice-card > a:hover {
    background: #c48a2c;
    color: #1f2933;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .summary-grid,
    .policy-layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .policy-sidebar {
      position: static;
      grid-template-columns: 1fr 1fr;
    }

    .notice-card {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 720px) {
    .container {
      width: min(100% - 30px, 1180px);
    }

    .page-hero {
      padding: 82px 0 74px;
    }

    h1 {
      font-size: clamp(2.7rem, 14vw, 4.2rem);
    }

    .summary-section,
    .policy-section {
      padding: 76px 0;
    }

    .policy-sidebar {
      grid-template-columns: 1fr;
    }

    .summary-card,
    .navigation-card,
    .contact-card {
      padding: 25px;
    }

    .policy-item {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 38px 0;
    }

    .contact-details > div {
      grid-template-columns: 1fr;
      gap: 7px;
    }

    .notice-card {
      padding: 38px 25px;
    }

    .notice-section {
      padding-bottom: 74px;
    }
  }
</style>