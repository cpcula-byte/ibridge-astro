---
import BaseLayout from "../layouts/BaseLayout.astro";

const lastUpdated = "2026 年 7 月 26 日";

const termsSections = [
  {
    number: "01",
    id: "acceptance",
    title: "接受本使用條款",
    paragraphs: [
      "歡迎使用 iBridge Education 網站。當您瀏覽、下載或使用本網站提供的內容與功能時，即表示您同意遵守本使用條款。",
      "若您不同意本使用條款，請停止使用本網站及相關資源。",
      "本條款適用於網站訪客、教師、學校人員、研究者、教育機構及其他使用者。",
    ],
    items: [],
  },
  {
    number: "02",
    id: "website-purpose",
    title: "網站目的",
    paragraphs: [
      "iBridge Education 提供與國際教育、課程設計、教師專業學習、教育研究、人工智慧教育應用及教育資源相關的資訊。",
      "網站內容主要用於教育、專業發展、研究交流及一般資訊用途。",
      "除非另有明確書面說明，網站內容不構成法律、醫療、心理、財務或其他受規範專業服務。",
    ],
    items: [],
  },
  {
    number: "03",
    id: "educational-information",
    title: "教育資訊與專業判斷",
    paragraphs: [
      "網站所提供的課程、教學、評量、研究與人工智慧相關內容，可能需要依學校政策、學生需求、年齡、語言程度及所在地規定進行調整。",
      "使用者應運用適當的專業判斷，確認內容是否適合特定課程、學生或教育情境。",
      "iBridge Education 不保證任何單一資源、教學策略或方案必然產生特定學習成果。",
    ],
    items: [],
  },
  {
    number: "04",
    id: "permitted-use",
    title: "允許的使用方式",
    paragraphs: [
      "除個別資源另有授權說明外，您可以為個人學習、非商業教學、校內專業發展及合理研究用途瀏覽網站內容。",
      "下載資源時，您必須遵守檔案頁面、下載頁面、授權標示或相關文件中的使用條件。",
    ],
    items: [
      "個人學習與備課",
      "一般非商業課堂教學",
      "校內教師專業學習",
      "合理的教育研究與引用",
      "依個別資源授權條件允許的其他用途",
    ],
  },
  {
    number: "05",
    id: "restricted-use",
    title: "禁止的使用方式",
    paragraphs: [
      "除非已取得明確書面許可，您不得以侵犯權利、破壞網站或不當利用內容的方式使用本網站。",
    ],
    items: [
      "大量複製、重新發布、轉售或商業化網站內容",
      "移除著作權、來源、商標或授權標示",
      "冒充 iBridge Education、學校、教師或其他人士",
      "以自動化工具大量擷取、下載或干擾網站",
      "上傳惡意程式、垃圾訊息或有害內容",
      "試圖繞過網站安全、權限或存取限制",
      "將內容用於非法、歧視、傷害或誤導用途",
    ],
  },
  {
    number: "06",
    id: "intellectual-property",
    title: "智慧財產權",
    paragraphs: [
      "除另有標示外，本網站的原創文字、設計、圖像、版面、品牌名稱、標誌、課程結構及其他原創內容，屬於 iBridge Education 或相關權利人所有。",
      "網站可包含第三方資料、商標、引用、連結或依授權使用的內容。此類內容仍屬其原權利人所有。",
      "本網站的存在並不表示將任何著作權、商標權或其他智慧財產權轉讓給使用者。",
    ],
    items: [],
  },
  {
    number: "07",
    id: "resources",
    title: "教材、下載與教育資源",
    paragraphs: [
      "個別教材、PDF、工作紙、簡報、課程單元或下載資源可能附有特定授權、使用範圍、署名要求或禁止事項。",
      "當個別資源的使用條件與本條款不同時，以該資源頁面或檔案中列明的條件為準。",
      "除非另有授權，不得將免費教育資源重新包裝、出售、放置於付費會員區或作為商業產品的一部分。",
    ],
    items: [],
  },
  {
    number: "08",
    id: "user-submissions",
    title: "使用者提交的內容",
    paragraphs: [
      "當您透過聯絡表單或電子郵件提交訊息時，您確認該內容為真實、合法且不侵犯他人權利。",
      "請勿提交學生姓名、身分證件資料、健康資訊、個人成績、特殊教育資料或其他不必要的敏感資訊。",
      "您仍保留自己原始內容的權利，但授權我們在處理詢問、回覆聯絡及評估合作需求所需範圍內使用該內容。",
    ],
    items: [],
  },
  {
    number: "09",
    id: "third-party-services",
    title: "第三方服務",
    paragraphs: [
      "本網站可能使用或連結至 Cloudflare、Formspree、GitHub、Google、社群媒體、教育平台或其他第三方服務。",
      "第三方服務由其各自營運者管理，並受其自身條款、隱私政策與技術限制規範。",
      "iBridge Education 不控制第三方網站，也不對其內容、可用性、安全性或資料處理方式作出保證。",
    ],
    items: [],
  },
  {
    number: "10",
    id: "external-links",
    title: "外部連結",
    paragraphs: [
      "網站中的外部連結僅為提供參考或便利，不表示 iBridge Education 認可、控制或保證該網站的內容。",
      "使用者應自行判斷外部網站、下載檔案、產品與服務是否適合及安全。",
    ],
    items: [],
  },
  {
    number: "11",
    id: "availability",
    title: "網站可用性與變更",
    paragraphs: [
      "我們會盡合理努力維持網站正常運作，但不保證網站永遠不中斷、無錯誤或所有內容永久可用。",
      "我們可以隨時修改、更新、限制、移動或移除網站內容、功能與資源。",
      "部分內容可能因維護、技術問題、授權變更、安全事件或第三方服務中斷而暫時無法使用。",
    ],
    items: [],
  },
  {
    number: "12",
    id: "accuracy",
    title: "內容準確性",
    paragraphs: [
      "我們會合理檢查網站資訊，但教育規範、課程要求、技術工具、服務條款及外部資源可能隨時間改變。",
      "使用者在依賴重要資訊前，應確認發布日期、適用地區、學校政策及相關官方來源。",
      "發現錯誤時，歡迎透過聯絡頁通知我們。",
    ],
    items: [],
  },
  {
    number: "13",
    id: "disclaimer",
    title: "免責聲明",
    paragraphs: [
      "本網站及其內容依目前可用狀態提供。在法律允許的最大範圍內，我們不就網站完全無錯誤、不中斷或適合所有特定用途作出明示或默示保證。",
      "使用網站內容、下載資源或採用教學建議的風險由使用者自行承擔。",
    ],
    items: [],
  },
  {
    number: "14",
    id: "liability",
    title: "責任限制",
    paragraphs: [
      "在適用法律允許的範圍內，iBridge Education 不對因使用或無法使用網站、依賴網站內容、第三方服務或下載資源而產生的間接、附帶或衍生損失負責。",
      "本條款不排除或限制依適用法律不得排除或限制的責任。",
    ],
    items: [],
  },
  {
    number: "15",
    id: "privacy",
    title: "隱私與資料保護",
    paragraphs: [
      "我們如何處理網站與聯絡表單資料，另於隱私權政策中說明。",
      "使用本網站前，請一併閱讀隱私權政策。",
    ],
    items: [],
  },
  {
    number: "16",
    id: "termination",
    title: "限制或終止使用",
    paragraphs: [
      "若使用者違反本條款、侵害他人權利、危害網站安全或以不當方式使用資源，我們可以限制或終止其存取權限。",
      "限制或終止存取不影響我們依法可採取的其他措施。",
    ],
    items: [],
  },
  {
    number: "17",
    id: "changes",
    title: "條款更新",
    paragraphs: [
      "我們可能因網站功能、服務、法律要求或營運方式改變而更新本使用條款。",
      "更新後的版本會發布於本頁並標示最近更新日期。",
      "在更新後繼續使用網站，即表示您接受修訂後的條款。",
    ],
    items: [],
  },
  {
    number: "18",
    id: "governing-principles",
    title: "適用原則",
    paragraphs: [
      "本條款應依網站營運所在地及相關服務適用的法律原則解釋。",
      "若本條款任何部分被認定無效或無法執行，其餘部分仍繼續有效。",
      "發生爭議時，雙方應先以合理、誠信及直接溝通方式尋求解決。",
    ],
    items: [],
  },
];

const quickLinks = [
  {
    href: "#acceptance",
    label: "接受條款",
  },
  {
    href: "#permitted-use",
    label: "允許使用",
  },
  {
    href: "#restricted-use",
    label: "禁止使用",
  },
  {
    href: "#intellectual-property",
    label: "智慧財產權",
  },
  {
    href: "#resources",
    label: "教材與下載",
  },
  {
    href: "#disclaimer",
    label: "免責聲明",
  },
];
---

<BaseLayout
  title="使用條款"
  description="閱讀 iBridge Education 網站、教育內容、下載資源、聯絡表單及第三方服務的使用條款。"
  locale="zh-tw"
>
  <section class="page-hero">
    <div class="hero-decoration" aria-hidden="true">
      <span class="hero-circle hero-circle-one"></span>
      <span class="hero-circle hero-circle-two"></span>
      <span class="hero-line"></span>
    </div>

    <div class="container hero-grid">
      <div>
        <p class="eyebrow">使用條款</p>

        <h1>
          使用網站、內容與教育資源前，
          <span>請先了解適用條件。</span>
        </h1>
      </div>

      <div class="hero-copy">
        <p>
          本條款說明您可以如何使用 iBridge Education 網站、
          教育內容、下載資源、聯絡功能及第三方連結。
        </p>

        <div class="updated-card">
          <span>最近更新</span>
          <strong>{lastUpdated}</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="summary-section">
    <div class="container summary-grid">
      <div>
        <p class="section-label">條款摘要</p>

        <h2>
          教育內容可依授權合理使用，但不得未經許可轉售或大量重新發布。
        </h2>
      </div>

      <div class="summary-card">
        <p>
          本網站主要提供教育資訊、專業交流與一般非商業資源。
          個別下載資源可能附有額外授權條件。
        </p>

        <p>
          使用者必須尊重智慧財產權、隱私、安全規則及第三方服務條款。
        </p>
      </div>
    </div>
  </section>

  <section class="terms-section">
    <div class="container terms-layout">
      <aside class="terms-sidebar">
        <div class="navigation-card">
          <p class="navigation-title">快速導覽</p>

          <nav aria-label="使用條款章節">
            <ul>
              {
                quickLinks.map((link) => (
                  <li>
                    <a href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        <div class="related-card">
          <p>相關政策</p>

          <a href="/privacy/">
            隱私權政策
          </a>
        </div>
      </aside>

      <div class="terms-content">
        {
          termsSections.map((section) => (
            <article
              id={section.id}
              class="terms-item"
            >
              <div class="terms-number">
                {section.number}
              </div>

              <div class="terms-text">
                <h2>{section.title}</h2>

                {
                  section.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))
                }

                {
                  section.items.length > 0 && (
                    <ul>
                      {
                        section.items.map((item) => (
                          <li>{item}</li>
                        ))
                      }
                    </ul>
                  )
                }
              </div>
            </article>
          ))
        }

        <article
          id="contact-information"
          class="terms-item"
        >
          <div class="terms-number">
            19
          </div>

          <div class="terms-text">
            <h2>聯絡方式</h2>

            <p>
              對本使用條款、資源授權或網站使用方式有疑問，
              請透過以下方式聯絡：
            </p>

            <dl class="contact-details">
              <div>
                <dt>組織</dt>
                <dd>iBridge Education</dd>
              </div>

              <div>
                <dt>電子郵件</dt>
                <dd>
                  <a href="mailto:hello@ibridge.info">
                    hello@ibridge.info
                  </a>
                </dd>
              </div>

              <div>
                <dt>網站</dt>
                <dd>
                  <a href="https://ibridge.info">
                    ibridge.info
                  </a>
                </dd>
              </div>
            </dl>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="notice-section">
    <div class="container notice-card">
      <div>
        <p class="section-label light-label">
          教育資源提醒
        </p>

        <h2>
          下載或分享資源前，請確認個別檔案的授權與使用條件。
        </h2>

        <p>
          需要校級授權、出版合作、商業使用或大量部署時，
          請先聯絡 iBridge Education。
        </p>
      </div>

      <a href="/contact/">
        聯絡我們
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .page-hero {
    position: relative;
    overflow: hidden;
    padding: 112px 0 104px;
    background:
      radial-gradient(
        circle at 88% 14%,
        rgba(196, 138, 44, 0.12),
        transparent 28%
      ),
      linear-gradient(
        125deg,
        #f7f1e3 0%,
        #faf7f0 100%
      );
  }

  .hero-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-circle {
    position: absolute;
    border: 1px solid rgba(165, 28, 48, 0.16);
    border-radius: 999px;
  }

  .hero-circle-one {
    top: -270px;
    right: -90px;
    width: 520px;
    height: 520px;
  }

  .hero-circle-two {
    right: 240px;
    bottom: -175px;
    width: 260px;
    height: 260px;
  }

  .hero-line {
    position: absolute;
    top: 58%;
    right: -120px;
    width: 700px;
    height: 1px;
    background: rgba(165, 28, 48, 0.16);
    transform: rotate(-16deg);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 90px;
    align-items: end;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 18px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    color: #1f2933;
    font-family:
      "Helvetica Neue",
      Helvetica,
      Arial,
      "PingFang TC",
      sans-serif;
    font-weight: 700;
    letter-spacing: -0.045em;
  }

  h1 {
    font-size: clamp(3.1rem, 6.2vw, 5.7rem);
    line-height: 0.99;
  }

  h1 span {
    display: block;
    margin-top: 14px;
    color: #a51c30;
  }

  .hero-copy {
    display: grid;
    gap: 28px;
  }

  .hero-copy > p,
  .summary-card p,
  .terms-text p,
  .notice-card p {
    margin: 0;
    color: #52606d;
    font-size: 1.03rem;
    line-height: 1.85;
  }

  .updated-card {
    display: grid;
    gap: 5px;
    width: fit-content;
    padding: 18px 22px;
    border: 1px solid #e4d7c5;
    border-radius: 14px;
    background: #faf7f0;
  }

  .updated-card span {
    color: #315c6b;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .updated-card strong {
    color: #1f2933;
  }

  .summary-section,
  .terms-section {
    padding: 104px 0;
  }

  .summary-section {
    background: #faf7f0;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 80px;
    align-items: start;
  }

  .summary-grid h2,
  .notice-card h2 {
    font-size: clamp(2.35rem, 4vw, 4.1rem);
    line-height: 1.08;
  }

  .summary-card {
    display: grid;
    gap: 22px;
    padding: 36px;
    border: 1px solid #e4d7c5;
    border-radius: 22px;
    background: #f7f1e3;
  }

  .terms-section {
    background: #f7f1e3;
  }

  .terms-layout {
    display: grid;
    grid-template-columns: 270px 1fr;
    gap: 72px;
    align-items: start;
  }

  .terms-sidebar {
    position: sticky;
    top: 116px;
    display: grid;
    gap: 18px;
  }

  .navigation-card,
  .related-card {
    border: 1px solid #e4d7c5;
    border-radius: 18px;
    background: #faf7f0;
  }

  .navigation-card {
    padding: 26px;
  }

  .navigation-title,
  .related-card p {
    margin: 0 0 16px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .navigation-card ul {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .navigation-card a {
    display: block;
    padding: 9px 0;
    color: #315c6b;
    font-size: 0.94rem;
    font-weight: 700;
    text-decoration: none;
  }

  .navigation-card a:hover {
    color: #a51c30;
  }

  .related-card {
    padding: 24px;
  }

  .related-card a {
    color: #315c6b;
    font-weight: 700;
    text-decoration: none;
  }

  .related-card a:hover {
    color: #a51c30;
  }

  .terms-content {
    border-top: 1px solid #e4d7c5;
  }

  .terms-item {
    display: grid;
    grid-template-columns: 62px 1fr;
    gap: 26px;
    padding: 48px 0;
    border-bottom: 1px solid #e4d7c5;
    scroll-margin-top: 112px;
  }

  .terms-number {
    padding-top: 8px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .terms-text h2 {
    margin-bottom: 23px;
    font-size: clamp(1.65rem, 3vw, 2.45rem);
    line-height: 1.15;
  }

  .terms-text p + p {
    margin-top: 17px;
  }

  .terms-text ul {
    display: grid;
    gap: 11px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
