---
import BaseLayout from "../layouts/BaseLayout.astro";

const lastUpdated = "2026 年 7 月 26 日";

const commitments = [
  {
    number: "01",
    title: "清楚且一致的導覽",
    text:
      "我們致力於使用清楚的頁面結構、標題、導覽連結與一致的版面，協助使用者理解網站內容並在不同頁面之間移動。",
  },
  {
    number: "02",
    title: "鍵盤操作",
    text:
      "網站的重要導覽、連結、按鈕與表單應能透過鍵盤操作。網站亦提供跳至主要內容的連結，協助鍵盤與螢幕閱讀器使用者略過重複導覽。",
  },
  {
    number: "03",
    title: "文字與色彩",
    text:
      "我們使用具備合理對比度的文字與背景，並避免只以顏色傳達重要資訊。文字大小與版面也會配合桌面、平板及手機螢幕調整。",
  },
  {
    number: "04",
    title: "語意化結構",
    text:
      "網站使用標題、段落、清單、導覽區域、主要內容區域及頁尾等語意化 HTML 結構，協助輔助科技理解頁面內容。",
  },
  {
    number: "05",
    title: "圖片與視覺內容",
    text:
      "具資訊用途的圖片應提供適當替代文字。純裝飾性圖像則盡可能不干擾螢幕閱讀器的使用。",
  },
  {
    number: "06",
    title: "表單與錯誤提示",
    text:
      "聯絡表單應使用清楚的欄位標籤、必填提示及可理解的錯誤訊息，使使用者能順利完成並送出資料。",
  },
];

const knownLimitations = [
  "部分第三方服務或嵌入內容的無障礙程度可能由其服務提供者控制。",
  "部分較舊的 PDF、教材或下載檔案可能尚未完全符合所有無障礙要求。",
  "自動產生或由外部來源提供的內容，可能需要額外人工檢查與修正。",
  "不同瀏覽器、裝置與輔助科技的呈現方式可能有所差異。",
];

const feedbackItems = [
  "無法使用鍵盤存取某個功能",
  "螢幕閱讀器無法理解某段內容",
  "文字、按鈕或連結的對比度不足",
  "圖片缺少替代文字",
  "表單標籤或錯誤提示不清楚",
  "PDF 或下載資源難以閱讀或操作",
];
---

<BaseLayout
  title="無障礙聲明"
  description="了解 iBridge Education 如何改善網站的鍵盤操作、語意結構、色彩對比、表單、圖片與教育資源無障礙體驗。"
  locale="zh-tw"
>
  <section class="page-hero">
    <div class="hero-decoration" aria-hidden="true">
      <span class="hero-circle hero-circle-one"></span>
      <span class="hero-circle hero-circle-two"></span>
      <span class="hero-line"></span>
    </div>

    <div class="container hero-grid">
      <div>
        <p class="eyebrow">無障礙聲明</p>

        <h1>
          讓教育資訊與資源
          <span>更容易被每一位使用者取得。</span>
        </h1>
      </div>

      <div class="hero-copy">
        <p>
          iBridge Education 致力於改善網站的可存取性，
          並持續檢查導覽、文字、圖片、表單及下載資源。
        </p>

        <div class="updated-card">
          <span>最近更新</span>
          <strong>{lastUpdated}</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="intro-section">
    <div class="container intro-grid">
      <div>
        <p class="section-label">我們的目標</p>

        <h2>
          建立清楚、穩定並能配合不同使用方式的教育網站。
        </h2>
      </div>

      <div class="intro-card">
        <p>
          我們希望教師、學生、家長、研究者及教育機構，
          無論使用滑鼠、鍵盤、觸控裝置或輔助科技，
          都能理解並使用網站的重要內容。
        </p>

        <p>
          無障礙改善是一項持續進行的工作。
          網站功能與資源更新時，我們也會持續檢查並修正問題。
        </p>
      </div>
    </div>
  </section>

  <section class="commitment-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-label">網站設計原則</p>

        <h2>
          我們目前採用的無障礙措施
        </h2>
      </div>

      <div class="commitment-grid">
        {
          commitments.map((commitment) => (
            <article class="commitment-card">
              <span>{commitment.number}</span>

              <h3>{commitment.title}</h3>

              <p>{commitment.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="standards-section">
    <div class="container standards-grid">
      <div class="standards-copy">
        <p class="section-label">參考標準</p>

        <h2>
          我們以通用的網頁無障礙原則作為改善方向。
        </h2>

        <p>
          網站設計與更新會參考可感知、可操作、可理解及穩健等原則，
          並盡可能改善鍵盤使用、螢幕閱讀器支援、內容結構及視覺對比。
        </p>

        <p>
          此聲明並不表示網站目前已在所有頁面、
          所有瀏覽器及所有輔助科技中達到完全一致的結果。
        </p>
      </div>

      <div class="principle-list">
        <article>
          <span aria-hidden="true">01</span>
          <div>
            <h3>可感知</h3>
            <p>內容應能以文字、視覺或輔助科技可理解的方式呈現。</p>
          </div>
        </article>

        <article>
          <span aria-hidden="true">02</span>
          <div>
            <h3>可操作</h3>
            <p>導覽、表單與互動功能應盡可能支援鍵盤及不同輸入方式。</p>
          </div>
        </article>

        <article>
          <span aria-hidden="true">03</span>
          <div>
            <h3>可理解</h3>
            <p>文字、導覽、欄位標籤與錯誤訊息應保持清楚且一致。</p>
          </div>
        </article>

        <article>
          <span aria-hidden="true">04</span>
          <div>
            <h3>穩健</h3>
            <p>網站應使用標準化結構，提升不同瀏覽器與輔助科技的相容性。</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="limitations-section">
    <div class="container limitations-grid">
      <div>
        <p class="section-label">目前限制</p>

        <h2>
          部分內容仍可能需要進一步改善。
        </h2>
      </div>

      <div class="limitations-card">
        <ul>
          {
            knownLimitations.map((item) => (
              <li>{item}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="feedback-section">
    <div class="container feedback-grid">
      <div class="feedback-copy">
        <p class="section-label light-label">回報問題</p>

        <h2>
          發現無障礙問題時，請提供頁面與問題說明。
        </h2>

        <p>
          我們會檢查合理且具體的回報，並依問題影響、
          技術限制及資源狀況安排改善。
        </p>

        <a href="/contact/">
          聯絡我們
        </a>
      </div>

      <div class="feedback-card">
        <h3>可以回報的問題</h3>

        <ul>
          {
            feedbackItems.map((item) => (
              <li>{item}</li>
            ))
          }
        </ul>

        <div class="contact-details">
          <span>電子郵件</span>

          <a href="mailto:hello@ibridge.info">
            hello@ibridge.info
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .page-hero {
    position: relative;
    overflow: hidden;
    padding: 112px 0 104px;
    background:
      radial-gradient(
        circle at 88% 14%,
        rgba(196, 138, 44, 0.12),
        transparent 28%
      ),
      linear-gradient(
        125deg,
        #f7f1e3 0%,
        #faf7f0 100%
      );
  }

  .hero-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-circle {
    position: absolute;
    border: 1px solid rgba(165, 28, 48, 0.16);
    border-radius: 999px;
  }

  .hero-circle-one {
    top: -270px;
    right: -90px;
    width: 520px;
    height: 520px;
  }

  .hero-circle-two {
    right: 240px;
    bottom: -175px;
    width: 260px;
    height: 260px;
  }

  .hero-line {
    position: absolute;
    top: 58%;
    right: -120px;
    width: 700px;
    height: 1px;
    background: rgba(165, 28, 48, 0.16);
    transform: rotate(-16deg);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 90px;
    align-items: end;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 18px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    color: #1f2933;
    font-family:
      "Helvetica Neue",
      Helvetica,
      Arial,
      "PingFang TC",
      sans-serif;
    font-weight: 700;
  }

  h1,
  h2 {
    letter-spacing: -0.045em;
  }

  h1 {
    font-size: clamp(3.1rem, 6.2vw, 5.7rem);
    line-height: 0.99;
  }

  h1 span {
    display: block;
    margin-top: 14px;
    color: #a51c30;
  }

  .hero-copy {
    display: grid;
    gap: 28px;
  }

  .hero-copy > p,
  .intro-card p,
  .commitment-card p,
  .standards-copy > p,
  .principle-list p,
  .feedback-copy > p {
    margin: 0;
    color: #52606d;
    font-size: 1.02rem;
    line-height: 1.82;
  }

  .updated-card {
    display: grid;
    gap: 5px;
    width: fit-content;
    padding: 18px 22px;
    border: 1px solid #e4d7c5;
    border-radius: 14px;
    background: #faf7f0;
  }

  .updated-card span {
    color: #315c6b;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .updated-card strong {
    color: #1f2933;
  }

  .intro-section,
  .commitment-section,
  .standards-section,
  .limitations-section,
  .feedback-section {
    padding: 104px 0;
  }

  .intro-section,
  .standards-section {
    background: #faf7f0;
  }

  .commitment-section,
  .limitations-section {
    background: #f7f1e3;
  }

  .intro-grid,
  .limitations-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 80px;
    align-items: start;
  }

  .intro-grid h2,
  .section-heading h2,
  .standards-copy h2,
  .limitations-grid h2,
  .feedback-copy h2 {
    font-size: clamp(2.35rem, 4vw, 4.1rem);
    line-height: 1.08;
  }

  .intro-card {
    display: grid;
    gap: 22px;
    padding: 36px;
    border: 1px solid #e4d7c5;
    border-radius: 22px;
    background: #f7f1e3;
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 54px;
  }

  .commitment-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .commitment-card {
    min-height: 290px;
    padding: 30px;
    border: 1px solid #e4d7c5;
    border-radius: 20px;
    background: #faf7f0;
  }

  .commitment-card > span {
    display: block;
    margin-bottom: 42px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .commitment-card h3 {
    margin-bottom: 16px;
    font-size: 1.3rem;
  }

  .commitment-card p {
    font-size: 0.96rem;
  }

  .standards-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 84px;
    align-items: start;
  }

  .standards-copy {
    display: grid;
    gap: 22px;
  }

  .standards-copy .section-label {
    margin-bottom: -4px;
  }

  .principle-list {
    border-top: 1px solid #e4d7c5;
  }

  .principle-list article {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 22px;
    padding: 27px 0;
    border-bottom: 1px solid #e4d7c5;
  }

  .principle-list article > span {
    padding-top: 4px;
    color: #a51c30;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .principle-list h3 {
    margin-bottom: 8px;
    font-size: 1.25rem;
  }

  .principle-list p {
    font-size: 0.95rem;
  }

  .limitations-card {
    padding: 36px;
    border: 1px solid #e4d7c5;
    border-radius: 22px;
    background: #faf7f0;
  }

  .limitations-card ul,
  .feedback-card ul {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .limitations-card li,
  .feedback-card li {
    position: relative;
    padding-left: 24px;
    color: #52606d;
    line-height: 1.75;
  }

  .limitations-card li::before,
  .feedback-card li::before {
    position: absolute;
    top: 0.65em;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #c48a2c;
    content: "";
  }

  .feedback-section {
    background:
      linear-gradient(
        115deg,
        #7b1422 0%,
        #a51c30 72%,
        #b72e42 100%
      );
  }

  .feedback-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 72px;
    align-items: center;
  }

  .light-label {
    color: #f2c66d;
  }

  .feedback-copy h2 {
    color: #ffffff;
  }

  .feedback-copy > p {
    margin-top: 24px;
    color: rgba(255, 255, 255, 0.8);
  }

  .feedback-copy > a {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    margin-top: 30px;
    padding: 0 26px;
    border-radius: 999px;
    background: #ffffff;
    color: #7b1422;
    font-weight: 700;
    text-decoration: none;
  }

  .feedback-copy > a:hover {
    background: #c48a2c;
    color: #1f2933;
  }

  .feedback-card {
    padding: 36px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.96);
  }

  .feedback-card h3 {
    margin-bottom: 24px;
    font-size: 1.35rem;
  }

  .feedback-card li {
    font-size: 0.95rem;
  }

  .contact-details {
    display: grid;
    gap: 6px;
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid #e4d7c5;
  }

  .contact-details span {
    color: #a51c30;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .contact-details a {
    color: #315c6b;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .intro-grid,
    .standards-grid,
    .limitations-grid,
    .feedback-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .commitment-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 720px) {
    .container {
      width: min(100% - 30px, 1180px);
    }

    .page-hero {
      padding: 82px 0 74px;
    }

    h1 {
      font-size: clamp(2.7rem, 14vw, 4.2rem);
    }

    .intro-section,
    .commitment-section,
    .standards-section,
    .limitations-section,
    .feedback-section {
      padding: 76px 0;
    }

    .commitment-grid {
      grid-template-columns: 1fr;
    }

    .commitment-card,
    .intro-card,
    .limitations-card,
    .feedback-card {
      padding: 26px;
    }

    .commitment-card {
      min-height: auto;
    }
  }
</style>