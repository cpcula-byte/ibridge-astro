---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/ContactForm.astro";
import "../styles/contact.css";
---

<BaseLayout
  title="聯絡我們"
  description="聯絡 iBridge Education，洽詢課程設計、教師專業發展、教育研究、人工智慧教育、教育資源或學校合作。"
  locale="zh-Hant"
  zhPath="/contact/"
  enPath="/en/contact/"
>
  <PageHero
    eyebrow="聯絡我們"
    title="從清楚說明需求開始，"
    accent="建立合適的合作方式。"
    copy="請提供目前需求、參與對象、預期成果與大致時間範圍。我們將依內容安排書面回覆或進一步討論。"
  />

  <ContactForm lang="zh" />
</BaseLayout>
