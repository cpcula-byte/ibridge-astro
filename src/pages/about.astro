---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Cta from "../components/Cta.astro";
const principles = [
  ["01","清楚勝過複雜","將研究、課程架構與教育理念轉化為教師、學生與學校可以理解及實施的行動。"],
  ["02","脈絡決定方法","沒有單一方法適用所有學校；方案必須回應真實的學生、教師與組織情境。"],
  ["03","證據支持判斷","研究提供方向，但專業判斷、實務經驗與持續評估同樣重要。"],
  ["04","發展重於短期成果","教育的價值也在於建立思考、韌性、獨立性與長期學習能力。"]
];
const fields = ["國際課程與單元設計","教師專業發展","英語與學術寫作","正向心理學與學生福祉","教育神經科學","人工智慧教育應用","自我調節與後設認知","學校課程與方案評估"];
---
<BaseLayout title="關於我們" description="了解 iBridge Education 如何連結國際教育、研究與學校實務。" locale="zh-Hant" zhPath="/about/" enPath="/en/about/">
  <PageHero eyebrow="關於 iBridge Education" title="在研究與實務之間，" accent="建立真正有意義的連結。" copy="iBridge Education 致力於將國際教育、教育研究與實務創新轉化為清楚、可行且具長期價值的學習經驗。" />
  <section class="section section-white"><div class="container split"><div><p class="eyebrow">我們的使命</p><h2>讓教育研究進入課程、教室與學生的真實經驗。</h2></div><div class="prose"><p>許多教育理念具有價值，但若缺乏清楚架構、實施方式與持續支持，就難以在真實學校環境中產生長期影響。</p><p>iBridge Education 協助教育工作者在理論與實務之間建立橋樑，將複雜內容轉化為可理解、可調整及可持續的教育方案。</p></div></div></section>
  <section class="section section-ivory"><div class="container"><div class="section-heading"><div><p class="eyebrow">我們的原則</p><h2>穩健的教育創新，始於清楚的價值與判斷。</h2></div></div><div class="grid-4">{principles.map(([n,t,d]) => <article class="card"><span class="card-number">{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div></div></section>
  <section class="section section-dark"><div class="container split"><div><p class="eyebrow eyebrow-light">專業領域</p><h2>跨領域，但始終以學習品質為核心。</h2><p>不同領域不是各自獨立，而是共同影響學生如何理解、參與及持續學習。</p></div><div class="list-panel">{fields.map((item,i)=><div class="list-row"><span>{String(i+1).padStart(2,"0")}</span><strong style="color:white">{item}</strong></div>)}</div></div></section>
  <section class="section section-white"><div class="container"><div class="section-heading"><div><p class="eyebrow">合作方式</p><h2>先理解情境，再設計方案。</h2></div></div><div class="grid-4">{[["01","理解需求","釐清學校、教師、學生與課程目前面對的問題。"],["02","建立方向","設定清楚目標、成功標準與可行步驟。"],["03","共同設計","發展課程、工具、專業學習或研究方案。"],["04","評估與調整","根據結果、回饋與證據持續改善。"]].map(([n,t,d])=><article class="card"><span class="card-number">{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div></div></section>
  <Cta eyebrow="開始對話" title="討論您的學校、課程或教育計畫。" copy="說明目前需求、參與對象、預期成果與大致時程，我們將協助整理下一步。" label="聯絡 iBridge" href="/contact/" />
</BaseLayout>
