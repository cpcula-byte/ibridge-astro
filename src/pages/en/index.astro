---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeHero from "../../components/HomeHero.astro";
import Cta from "../../components/Cta.astro";

const services = [
  [
    "01",
    "Curriculum and Learning Design",
    "Coherent and practical curriculum design shaped by school context, learner needs and international education frameworks.",
    "/en/services/",
  ],
  [
    "02",
    "Professional Development",
    "Workshops, collaborative planning and consultancy connecting research, technology and classroom practice.",
    "/en/services/",
  ],
  [
    "03",
    "Educational Research and Innovation",
    "Turning educational neuroscience, positive psychology and artificial intelligence into usable programmes.",
    "/en/research/",
  ],
];

const principles = [
  ["01", "Learner-centred", "We begin with developmental stage, language profile and authentic learning needs."],
  ["02", "Research-informed", "Credible evidence is translated into practical methods for educators and schools."],
  ["03", "Long-term development", "We value thinking, communication, self-management, resilience and independent learning."],
  ["04", "Sustainable systems", "We build curriculum and professional-learning structures that can continue, adapt and grow."],
];

const programmes = [
  "International curriculum planning and review",
  "MYP and DP vertical alignment",
  "English and academic writing programmes",
  "Teacher training and professional workshops",
  "Artificial intelligence in education",
  "Student learning and resilience programmes",
];
---

<BaseLayout
  title="iBridge Education"
  description="iBridge Education connects international education, curriculum design, applied research and practical innovation for schools, educators and learners."
  locale="en"
  zhPath="/"
  enPath="/en/"
>
  <div class="ib-home">
  <HomeHero isEn />



  <section class="section section-white home-services">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Professional services</p>
          <h2>From strategic planning to classroom practice</h2>
        </div>
        <a class="text-link" href="/en/services/">Explore all services →</a>
      </div>

      <div class="grid-3">
        {
          services.map(([number, title, description, link]) => (
            <article class="card">
              <svg class="home-service-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" aria-hidden="true">
                {number === "01" ? <><path d="M24 12C18 7 10 6 4 8v31c7-2 14-1 20 4 6-5 13-6 20-4V8c-6-2-14-1-20 4Z"/><path d="M24 12v31M8 12v23c5-1 10 0 13 2M40 12v23c-5-1-10 0-13 2"/></> : number === "02" ? <><circle cx="24" cy="13" r="6"/><circle cx="9" cy="18" r="4"/><circle cx="39" cy="18" r="4"/><path d="M13 40v-7a11 11 0 0 1 22 0v7M3 38v-6a6 6 0 0 1 8-6M45 38v-6a6 6 0 0 0-8-6"/></> : <><path d="M6 28h7v16H6zM20 17h7v27h-7zM34 4h7v40h-7z"/></>}
              </svg>
              <h3>{title}</h3>
              <p>{description}</p>
              <a class="text-link" href={link}>Learn more ↗</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-ivory home-position">
    <div class="container split">
      <div>
        <p class="eyebrow">Our position</p>
        <h2>Educational ideas must become meaningful learning experiences.</h2>
      </div>

      <div class="prose">
        <p>
          iBridge Education works between educational research and school practice.
          We help educators clarify objectives, build curriculum structures,
          design learning experiences and evaluate whether programmes genuinely
          respond to learner needs.
        </p>
        <p>
          We value rigour without unnecessary complexity. Every partnership is
          designed to be clear, practical, sustainable and responsive to its
          educational context.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow eyebrow-light">Our principles</p>
          <h2>Thoughtful, rigorous and focused on long-term development.</h2>
        </div>
      </div>

      <div class="grid-4">
        {
          principles.map(([number, title, description]) => (
            <article class="card dark-card">
              <span class="card-number">{number}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-ivory">
    <div class="container split">
      <div>
        <p class="eyebrow">Areas of partnership</p>
        <h2>Flexible programmes shaped around each educational context.</h2>
        <p>
          Partnerships can begin with a workshop, curriculum review or consultation
          and extend to long-term curriculum development, professional learning and research.
        </p>
        <a class="button button-primary" href="/en/programmes/">Explore programmes</a>
      </div>

      <div class="list-panel">
        {
          programmes.map((item, index) => (
            <div class="list-row">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{item}</strong>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-white">
    <div class="container card research-summary-card">
      <p class="eyebrow">Research and practice</p>
      <h2>Making educational research understandable and usable.</h2>
      <p class="lead">
        Our areas of interest include positive psychology, educational neuroscience,
        self-regulated learning, artificial intelligence, international curriculum design
        and student wellbeing. We focus on creating value in real schools.
      </p>
      <a class="text-link" href="/en/research/">Explore our research →</a>
    </div>
  </section>

  <Cta
    eyebrow="Start a conversation"
    title="Build deeper and more resilient learning experiences."
    copy="Contact us to discuss curriculum design, professional development, AI integration, educational research, school consultancy or student learning programmes."
    label="Contact iBridge"
    href="/en/contact/"
  />
  </div>
</BaseLayout>
