---
import BaseLayout from "../../layouts/BaseLayout.astro";

const enquiryTypes = [
  "Curriculum and unit design",
  "Professional learning",
  "Educational research and evaluation",
  "Artificial intelligence in education",
  "Student learning and resilience",
  "Resource collaboration",
  "Other partnership",
];

const contactTopics = [
  {
    number: "01",
    title: "School and curriculum partnerships",
    description:
      "For schools and organisations seeking curriculum review, mapping, unit design, vertical alignment or sustained curriculum development.",
  },
  {
    number: "02",
    title: "Professional learning",
    description:
      "For teacher workshops, collaborative planning, artificial intelligence training, assessment design or sustained professional development.",
  },
  {
    number: "03",
    title: "Research and evaluation",
    description:
      "For educational research, evidence collection, instrument design, programme evaluation and research translation.",
  },
  {
    number: "04",
    title: "Resources and content",
    description:
      "For educational materials, bilingual resources, curriculum publishing, website content and professional resource collaboration.",
  },
];

const enquirySteps = [
  {
    number: "01",
    title: "Provide initial information",
    description:
      "Describe your school or organisation, your role, the current need and the intended participants.",
  },
  {
    number: "02",
    title: "Clarify scope and priorities",
    description:
      "Identify intended outcomes, timing, delivery model and available resources.",
  },
  {
    number: "03",
    title: "Arrange an initial discussion",
    description:
      "Continue through an online meeting, written response or exchange of relevant information.",
  },
  {
    number: "04",
    title: "Outline the partnership",
    description:
      "Receive a proposed direction, scope of work, indicative timeframe and next steps.",
  },
];

const contactDetails = [
  {
    label: "Email",
    value: "hello@ibridge.info",
    href: "mailto:hello@ibridge.info",
  },
  {
    label: "Website",
    value: "ibridge.info",
    href: "https://ibridge.info",
  },
  {
    label: "Service area",
    value: "Taiwan and international partnerships",
    href: null,
  },
  {
    label: "Delivery",
    value: "Online, in person or blended",
    href: null,
  },
];
---

<BaseLayout
  title="Contact"
  description="Contact iBridge Education to discuss curriculum design, professional development, educational research, resources or school partnerships."
  locale="en"
>
  <section class="page-hero">
    <div class="hero-decoration" aria-hidden="true">
      <span class="hero-circle hero-circle-one"></span>
      <span class="hero-circle hero-circle-two"></span>
      <span class="hero-line"></span>
    </div>

    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Contact</p>

        <h1>
          Begin with a clear description of the need.
          <span>Build a partnership appropriate to the educational context.</span>
        </h1>
      </div>

      <div class="hero-copy">
        <p>
          Schools, educators, educational organisations and research teams
          are welcome to contact iBridge Education regarding curriculum,
          professional learning, research, artificial intelligence
          or educational resource collaboration.
        </p>

        <p>
          An initial enquiry should briefly identify the current need,
          intended participants, expected outcomes and approximate timeframe.
        </p>

        <a class="hero-button" href="#contact-form">
          Complete the enquiry form
        </a>
      </div>
    </div>
  </section>

  <section class="contact-overview-section">
    <div class="container overview-grid">
      <div>
        <p class="section-label">Partnership areas</p>

        <h2>
          Collaboration for schools, educators, researchers and organisations.
        </h2>
      </div>

      <div class="topic-grid">
        {
          contactTopics.map((topic) => (
            <article class="topic-card">
              <span>{topic.number}</span>
              <h3>{topic.title}</h3>
              <p>{topic.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="contact-form"
    class="form-section"
  >
    <div class="container form-layout">
      <div class="form-introduction">
        <p class="section-label">Enquiry form</p>

        <h2>
          Provide the essential information about the proposed partnership.
        </h2>

        <p>
          Once submitted, Formspree will send the enquiry
          to the iBridge Education contact address.
        </p>

        <p>
          Do not use this form to transmit student names, health information,
          grades or other sensitive personal information.
        </p>

        <div class="response-note">
          <strong>Response time</strong>

          <p>
            General enquiries are usually answered within three to five working days.
          </p>
        </div>
      </div>

      <form
        class="contact-form"
        action="https://formspree.io/f/mrenyjjk"
        method="POST"
      >
        <input
          type="hidden"
          name="_subject"
          value="New iBridge Education website enquiry"
        />

        <input
          type="hidden"
          name="_language"
          value="en"
        />

        <div class="form-grid">
          <div class="field-group">
            <label for="name">
              Name
              <span aria-hidden="true">*</span>
            </label>

            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              required
            />
          </div>

          <div class="field-group">
            <label for="email">
              Email address
              <span aria-hidden="true">*</span>
            </label>

            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
            />
          </div>

          <div class="field-group">
            <label for="organisation">
              School or organisation
            </label>

            <input
              id="organisation"
              name="organisation"
              type="text"
              autocomplete="organization"
            />
          </div>

          <div class="field-group">
            <label for="role">
              Your role
            </label>

            <input
              id="role"
              name="role"
              type="text"
              placeholder="For example: teacher, curriculum leader, school leader"
            />
          </div>

          <div class="field-group field-full">
            <label for="enquiry-type">
              Enquiry type
              <span aria-hidden="true">*</span>
            </label>

            <select
              id="enquiry-type"
              name="enquiry_type"
              required
            >
              <option value="">
                Select an option
              </option>

              {
                enquiryTypes.map((type) => (
                  <option value={type}>
                    {type}
                  </option>
                ))
              }
            </select>
          </div>

          <div class="field-group">
            <label for="participants">
              Intended participants
            </label>

            <input
              id="participants"
              name="participants"
              type="text"
              placeholder="For example: 20 teachers or two year levels"
            />
          </div>

          <div class="field-group">
            <label for="timeline">
              Approximate timeframe
            </label>

            <input
              id="timeline"
              name="timeline"
              type="text"
              placeholder="For example: first semester of 2026"
            />
          </div>

          <div class="field-group field-full">
            <label for="message">
              Partnership requirements
              <span aria-hidden="true">*</span>
            </label>

            <textarea
              id="message"
              name="message"
              rows="8"
              required
              placeholder="Briefly describe the context, current need, expected outcomes and any important constraints."
            ></textarea>
          </div>

          <div class="field-group field-full consent-field">
            <label class="checkbox-label">
              <input
                type="checkbox"
                name="privacy_confirmation"
                value="confirmed"
                required
              />

              <span>
                I confirm that this form does not contain student personal data,
                health information, grades or other sensitive information.
              </span>
            </label>
          </div>

          <div class="field-group field-full">
            <button type="submit">
              Submit enquiry
            </button>
          </div>
        </div>
      </form>
    </div>
  </section>

  <section class="process-section">
    <div class="container process-grid">
      <div class="process-introduction">
        <p class="section-label light-label">
          What happens next
        </p>

        <h2>
          From an initial enquiry to a defined partnership direction.
        </h2>

        <p>
          An initial enquiry does not create a formal commitment.
          Both sides first confirm the need, feasibility and appropriate format.
        </p>
      </div>

      <ol class="process-list">
        {
          enquirySteps.map((step) => (
            <li>
              <span>{step.number}</span>

              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="details-section">
    <div class="container details-grid">
      <div>
        <p class="section-label">Direct contact</p>

        <h2>
          You may also contact iBridge directly by email.
        </h2>

        <p>
          When the enquiry form is unavailable,
          send the partnership requirements to hello@ibridge.info.
        </p>
      </div>

      <dl class="details-list">
        {
          contactDetails.map((detail) => (
            <div>
              <dt>{detail.label}</dt>

              <dd>
                {
                  detail.href ? (
                    <a href={detail.href}>
                      {detail.value}
                    </a>
                  ) : (
                    detail.value
                  )
                }
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="privacy-section">
    <div class="container privacy-card">
      <div class="privacy-marker" aria-hidden="true">
        P
      </div>

      <div>
        <p class="section-label">Privacy and data protection</p>

        <h2>
          Provide only the information needed to assess the enquiry.
        </h2>

        <p>
          Form submissions are used only to respond to enquiries
          and consider possible partnerships.
          Do not include student names, identification records,
          medical information, individual grades
          or unnecessary sensitive personal data.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .page-hero {
    position: relative;
    overflow: hidden;
    padding: 112px 0 104px;
    background:
      radial-gradient(
        circle at 88% 14%,
        rgba(196, 138, 44, 0.1),
        transparent 28%
      ),
      linear-gradient(
        125deg,
        #f7f1e3 0%,
        #faf7f0 100%
      );
  }

  .hero-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-circle {
    position: absolute;
    border: 1px solid rgba(165, 28, 48, 0.16);
    border-radius: 999px;
  }

  .hero-circle-one {
    width: 520px;
    height: 520px;
    top: -270px;
    right: -90px;
  }

  .hero-circle-two {
    width: 260px;
    height: 260px;
    right: 240px;
    bottom: -175px;
  }

  .hero-line {
    position: absolute;
    top: 58%;
    right: -120px;
    width: 700px;
    height: 1px;
    background: rgba(165, 28, 48, 0.16);
    transform: rotate(-16deg);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 90px;
    align-items: end;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 18px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    color: #1f2933;
    font-family:
      "Neue Helvetica",
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif;
    font-weight: 700;
    letter-spacing: -0.045em;
  }

  h1 {
    font-size: clamp(3.1rem, 6.2vw, 5.7rem);
    line-height: 0.99;
  }

  h1 span {
    display: block;
    margin-top: 14px;
    color: #a51c30;
  }

  .hero-copy {
    display: grid;
    gap: 20px;
  }

  .hero-copy p,
  .topic-card p,
  .form-introduction > p,
  .process-introduction > p,
  .details-grid > div > p,
  .privacy-card p {
    margin: 0;
    color: #52606d;
    font-size: 1.03rem;
    line-height: 1.85;
  }

  .hero-button {
    display: inline-flex;
    width: fit-content;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    padding: 0 24px;
    border-radius: 999px;
    background: #a51c30;
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
  }

  .hero-button:hover {
    background: #7b1422;
    color: #ffffff;
  }

  .contact-overview-section,
  .form-section,
  .process-section,
  .details-section,
  .privacy-section {
    padding: 104px 0;
  }

  .overview-grid {
    display: grid;
    grid-template-columns: 0.78fr 1.22fr;
    gap: 76px;
  }

  .overview-grid h2,
  .form-introduction h2,
  .process-introduction h2,
  .details-grid h2,
  .privacy-card h2 {
    font-size: clamp(2.35rem, 4vw, 4.1rem);
    line-height: 1.08;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .topic-card {
    padding: 28px;
    border: 1px solid #e4d7c5;
    border-radius: 20px;
    background: #faf7f0;
  }

  .topic-card > span {
    color: #a51c30;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .topic-card h3 {
    margin: 34px 0 13px;
    color: #1f2933;
    font-size: 1.35rem;
  }

  .topic-card p {
    font-size: 0.96rem;
    line-height: 1.72;
  }

  .form-section {
    background: #faf7f0;
  }

  .form-layout {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: 72px;
    align-items: start;
  }

  .form-introduction {
    position: sticky;
    top: 118px;
  }

  .form-introduction > p {
    margin-top: 22px;
  }

  .response-note {
    margin-top: 34px;
    padding: 24px;
    border: 1px solid #e4d7c5;
    border-radius: 16px;
    background: #f7f1e3;
  }

  .response-note strong {
    color: #a51c30;
  }

  .response-note p {
    margin: 8px 0 0;
    color: #52606d;
    line-height: 1.7;
  }

  .contact-form {
    padding: 38px;
    border: 1px solid #e4d7c5;
    border-radius: 24px;
    background: #f7f1e3;
    box-shadow: 0 18px 48px rgba(31, 41, 51, 0.06);
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .field-group {
    display: grid;
    gap: 9px;
  }

  .field-full {
    grid-column: 1 / -1;
  }

  .field-group label {
    margin: 0;
    color: #1f2933;
    font-weight: 700;
  }

  .field-group label > span {
    color: #a51c30;
  }

  .field-group input,
  .field-group select,
  .field-group textarea {
    width: 100%;
    border: 1px solid #e4d7c5;
    border-radius: 10px;
    background: #faf7f0;
    color: #1f2933;
  }

  .field-group input,
  .field-group select {
    min-height: 52px;
    padding: 0 15px;
  }

  .field-group textarea {
    min-height: 190px;
    padding: 15px;
    resize: vertical;
  }

  .field-group input:focus,
  .field-group select:focus,
  .field-group textarea:focus {
    border-color: #a51c30;
    box-shadow: 0 0 0 4px rgba(165, 28, 48, 0.1);
    outline: none;
  }

  .checkbox-label {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 12px;
    align-items: start;
    font-weight: 300 !important;
  }

  .checkbox-label input {
    width: 18px;
    min-height: 18px;
    margin-top: 3px;
    accent-color: #a51c30;
  }

  .checkbox-label span {
    color: #52606d !important;
    font-weight: 300;
    line-height: 1.65;
  }

  .contact-form button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    padding: 0 26px;
    border: 0;
    border-radius: 999px;
    background: #a51c30;
    color: #ffffff;
    font-weight: 700;
    cursor: pointer;
  }

  .contact-form button:hover {
    background: #7b1422;
  }

  .process-section {
    background:
      linear-gradient(
        120deg,
        #7b1422 0%,
        #56101a 100%
      );
  }

  .process-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 86px;
  }

  .light-label {
    color: #f2c66d;
  }

  .process-introduction h2 {
    color: #ffffff;
  }

  .process-introduction > p {
    margin-top: 26px;
    color: rgba(255, 255, 255, 0.76);
  }

  .process-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-list li {
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 18px;
    padding: 23px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .process-list li:first-child {
    border-top: 0;
  }

  .process-list li > span {
    color: #f2c66d;
    font-size: 0.73rem;
    font-weight: 700;
  }

  .process-list h3 {
    margin: 0 0 8px;
    color: #ffffff;
    font-size: 1.12rem;
  }

  .process-list p {
    margin: 0;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.7;
  }

  .details-section {
    background: #f7f1e3;
  }

  .details-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 78px;
  }

  .details-grid > div > p {
    margin-top: 24px;
  }

  .details-list {
    margin: 0;
    border-top: 1px solid #e4d7c5;
  }

  .details-list > div {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 24px;
    padding: 22px 0;
    border-bottom: 1px solid #e4d7c5;
  }

  .details-list dt {
    color: #a51c30;
    font-weight: 700;
  }

  .details-list dd {
    margin: 0;
    color: #1f2933;
  }

  .details-list a {
    color: #315c6b;
    font-weight: 700;
    text-decoration: none;
  }

  .details-list a:hover {
    color: #a51c30;
  }

  .privacy-section {
    padding-top: 20px;
    background: #f7f1e3;
  }

  .privacy-card {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 60px;
    padding: 58px 0;
    border-top: 1px solid #e4d7c5;
    border-bottom: 1px solid #e4d7c5;
  }

  .privacy-marker {
    color: rgba(165, 28, 48, 0.14);
    font-size: 8rem;
    font-weight: 700;
    line-height: 0.85;
  }

  .privacy-card p {
    max-width: 880px;
    margin-top: 24px;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .overview-grid,
    .form-layout,
    .process-grid,
    .details-grid,
    .privacy-card {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .form-introduction {
      position: static;
    }
  }

  @media (max-width: 720px) {
    .container {
      width: min(100% - 30px, 1180px);
    }

    .page-hero {
      padding: 82px 0 74px;
    }

    h1 {
      font-size: clamp(2.7rem, 14vw, 4.2rem);
    }

    .contact-overview-section,
    .form-section,
    .process-section,
    .details-section,
    .privacy-section {
      padding: 76px 0;
    }

    .topic-grid,
    .form-grid {
      grid-template-columns: 1fr;
    }

    .contact-form {
      padding: 28px 22px;
    }

    .field-full {
      grid-column: auto;
    }

    .details-list > div {
      grid-template-columns: 1fr;
      gap: 7px;
    }

    .privacy-marker {
      font-size: 5rem;
    }
  }
</style>
