---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { contactFormEndpoint } from "../../config/forms";

const enquiryTypes = [
  "IB curriculum design and vertical alignment",
  "Assessment and feedback systems",
  "Professional development",
  "AI integration in education",
  "Student learning programmes",
  "Educational research and programme evaluation",
  "Resource collaboration",
  "Other",
];

const contactDetails = [
  {
    label: "Email",
    value: "cpc.ula@gmail.com",
    href: "mailto:cpc.ula@gmail.com",
  },
  {
    label: "Website",
    value: "ibridge.info",
    href: "https://ibridge.info",
  },
  {
    label: "Service Area",
    value: "Taiwan and international online collaboration",
  },
  {
    label: "Response Time",
    value: "We normally reply within two to three working days",
  },
];

const preparationItems = [
  "Your name and contact details",
  "School, organisation or team name",
  "The service area you are interested in",
  "Your main need or current challenge",
  "Your preferred starting date and timeline",
  "Whether you prefer online or in-person collaboration",
];
---

<BaseLayout
  locale="en"
  title="Contact Us"
  description="Contact iBridge Education regarding IB curriculum design, professional development, AI integration, research partnerships and student learning programmes."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact iBridge</span>

      <h1>Start a conversation about educational collaboration</h1>

      <p class="lead">
        Schools, teachers, educational organisations, researchers,
        students and families are welcome to contact us regarding
        curriculum, professional learning, AI, research and student support.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-layout">
      <div class="contact-information">
        <span class="eyebrow">Contact Information</span>

        <h2 class="section-title">
          Contact iBridge Education
        </h2>

        <p class="lead">
          Use the enquiry form to explain your needs. We will first consider
          your educational context, goals and timeline before suggesting
          an appropriate next step.
        </p>

        <div class="contact-detail-list">
          {
            contactDetails.map((item) => (
              <article class="contact-detail">
                <span class="contact-icon" aria-hidden="true">
                  iB
                </span>

                <div>
                  <h3>{item.label}</h3>

                  {
                    item.href ? (
                      <a href={item.href}>{item.value}</a>
                    ) : (
                      <p>{item.value}</p>
                    )
                  }
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="form-panel">
        <span class="eyebrow">Enquiry Form</span>

        <h2 class="section-title">
          Tell us about your needs
        </h2>

        <p class="form-introduction">
          Fields marked with an asterisk are required. Do not submit
          student names, health information, grades or other sensitive
          personal information through this form.
        </p>

        <form
          class="contact-form"
          action={contactFormEndpoint}
          method="POST"
          accept-charset="UTF-8"
        >
          <input
            type="hidden"
            name="_subject"
            value="New iBridge Education English website enquiry"
          />

          <input
            type="hidden"
            name="language"
            value="English"
          />

          <input
            class="hidden-field"
            type="text"
            name="_gotcha"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="form-grid">
            <div class="form-field">
              <label for="name">
                Name
                <span aria-hidden="true">*</span>
              </label>

              <input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                required
              />
            </div>

            <div class="form-field">
              <label for="email">
                Email
                <span aria-hidden="true">*</span>
              </label>

              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
              />
            </div>
          </div>

          <div class="form-grid">
            <div class="form-field">
              <label for="organisation">
                School or Organisation
              </label>

              <input
                id="organisation"
                name="organisation"
                type="text"
                autocomplete="organization"
              />
            </div>

            <div class="form-field">
              <label for="role">
                Position or Role
              </label>

              <input
                id="role"
                name="role"
                type="text"
                placeholder="For example: teacher, curriculum leader, parent"
              />
            </div>
          </div>

          <div class="form-grid">
            <div class="form-field">
              <label for="enquiry-type">
                Enquiry Type
                <span aria-hidden="true">*</span>
              </label>

              <select
                id="enquiry-type"
                name="enquiry_type"
                required
              >
                <option value="" selected disabled>
                  Please select
                </option>

                {
                  enquiryTypes.map((type) => (
                    <option value={type}>{type}</option>
                  ))
                }
              </select>
            </div>

            <div class="form-field">
              <label for="timeline">
                Preferred Starting Time
              </label>

              <select id="timeline" name="timeline">
                <option value="">
                  Not yet decided
                </option>

                <option value="Within one month">
                  Within one month
                </option>

                <option value="One to three months">
                  One to three months
                </option>

                <option value="Three to six months">
                  Three to six months
                </option>

                <option value="More than six months">
                  More than six months
                </option>
              </select>
            </div>
          </div>

          <div class="form-field">
            <label for="message">
              Message
              <span aria-hidden="true">*</span>
            </label>

            <textarea
              id="message"
              name="message"
              rows="8"
              minlength="20"
              required
              placeholder="Briefly explain your context, needs, goals and what you would like to discuss."
            ></textarea>

            <small>
              Please provide at least 20 characters.
            </small>
          </div>

          <label class="consent-field">
            <input
              type="checkbox"
              name="privacy_consent"
              value="Agreed"
              required
            />

            <span>
              I agree that iBridge Education may use the information
              provided to respond to this enquiry. I understand that
              sensitive personal data should not be submitted through
              this form.
            </span>
          </label>

          <button
            class="button button-primary submit-button"
            type="submit"
          >
            Send Enquiry
          </button>

          <div
            class="submission-message"
            id="submission-message"
            role="status"
            aria-live="polite"
          ></div>

          <p class="form-notice">
            Form data will be delivered through Formspree to the designated
            iBridge Education email account.
          </p>
        </form>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container preparation-layout">
      <div>
        <span class="eyebrow">Before You Contact Us</span>

        <h2 class="section-title">
          These details help us respond more efficiently
        </h2>

        <p class="lead">
          You do not need to prepare a formal proposal. However, clear
          background information helps us identify an appropriate service,
          timeline and next step.
        </p>
      </div>

      <div class="preparation-list">
        {
          preparationItems.map((item) => (
            <div class="preparation-item">
              <span class="check-mark">✓</span>
              <span>{item}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container privacy-panel">
      <div>
        <span class="eyebrow">Privacy</span>

        <h2 class="section-title">
          How enquiry information is used
        </h2>
      </div>

      <div class="privacy-copy">
        <p>
          Form information is used only to process the enquiry,
          arrange follow-up communication and consider possible
          forms of collaboration.
        </p>

        <p>
          Do not submit student full names, identification documents,
          health records, psychological information, individual grades
          or other unnecessary sensitive information.
        </p>

        <p>
          If a later partnership requires research data, student information
          or school documents, confidentiality, research ethics and data
          handling procedures will be agreed separately.
        </p>
      </div>
    </div>
  </section>

  <script>
    const form = document.querySelector(".contact-form");
    const messageBox = document.querySelector("#submission-message");
    const submitButton = document.querySelector(".submit-button");

    if (
      form instanceof HTMLFormElement &&
      messageBox instanceof HTMLElement &&
      submitButton instanceof HTMLButtonElement
    ) {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        submitButton.disabled = true;
        submitButton.textContent = "Sending…";

        messageBox.className = "submission-message";
        messageBox.textContent = "";

        try {
          const response = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: {
              Accept: "application/json",
            },
          });

          if (!response.ok) {
            const data = await response
              .json()
              .catch(() => null);

            const errors = Array.isArray(data?.errors)
              ? data.errors
                  .map((error: { message?: string }) => error.message)
                  .filter(Boolean)
                  .join(" ")
              : "";

            throw new Error(
              errors ||
                "The message could not be sent. Please try again.",
            );
          }

          form.reset();

          messageBox.classList.add("success");
          messageBox.textContent =
            "Your message has been sent successfully. We will reply as soon as possible.";
        } catch (error) {
          messageBox.classList.add("error");

          messageBox.textContent =
            error instanceof Error
              ? error.message
              : "The message could not be sent. Please try again.";
        } finally {
          submitButton.disabled = false;
          submitButton.textContent = "Send Enquiry";
        }
      });
    }
  </script>

  <style>
    .contact-layout {
      display: grid;
      grid-template-columns: 0.82fr 1.18fr;
      gap: 56px;
      align-items: start;
    }

    .contact-information {
      position: sticky;
      top: 110px;
    }

    .contact-detail-list {
      margin-top: 34px;
      display: grid;
      gap: 14px;
    }

    .contact-detail {
      padding: 19px;
      display: grid;
      grid-template-columns: 48px 1fr;
      gap: 15px;
      align-items: center;
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 17px;
      box-shadow: var(--shadow-small);
    }

    .contact-icon {
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      color: var(--white);
      background: linear-gradient(
        135deg,
        var(--navy),
        var(--teal)
      );
      border-radius: 14px;
      font-size: 0.78rem;
      font-weight: 850;
    }

    .contact-detail h3 {
      margin-bottom: 3px;
      color: var(--navy);
      font-size: 0.86rem;
    }

    .contact-detail p,
    .contact-detail a {
      margin: 0;
      color: var(--muted);
      overflow-wrap: anywhere;
    }

    .contact-detail a:hover {
      color: var(--teal);
    }

    .form-panel {
      padding: 38px;
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 28px;
      box-shadow: var(--shadow-medium);
    }

    .form-introduction {
      margin-bottom: 28px;
      color: var(--muted);
    }

    .contact-form {
      display: grid;
      gap: 22px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .form-field {
      display: grid;
      gap: 8px;
    }

    .form-field label {
      color: var(--navy);
      font-size: 0.92rem;
      font-weight: 780;
    }

    .form-field label span {
      color: #a93838;
    }

    .form-field input,
    .form-field select,
    .form-field textarea {
      width: 100%;
      min-height: 50px;
      padding: 13px 15px;
      color: var(--ink);
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 13px;
      font: inherit;
      outline: none;
      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
    }

    .form-field textarea {
      min-height: 170px;
      resize: vertical;
    }

    .form-field input:focus,
    .form-field select:focus,
    .form-field textarea:focus {
      border-color: var(--teal);
      box-shadow: 0 0 0 4px rgba(15, 124, 130, 0.1);
    }

    .form-field small {
      color: var(--muted);
    }

    .consent-field {
      display: grid;
      grid-template-columns: 20px 1fr;
      gap: 12px;
      align-items: start;
      color: var(--muted);
      font-size: 0.9rem;
      cursor: pointer;
    }

    .consent-field input {
      width: 18px;
      height: 18px;
      margin-top: 3px;
      accent-color: var(--teal);
    }

    .submit-button {
      justify-self: start;
      min-width: 170px;
      border: 0;
      cursor: pointer;
    }

    .submit-button:disabled {
      opacity: 0.65;
      cursor: wait;
      transform: none;
    }

    .submission-message {
      display: none;
      padding: 14px 16px;
      border-radius: 13px;
      font-size: 0.92rem;
      font-weight: 700;
    }

    .submission-message.success {
      display: block;
      color: #17623b;
      background: #e7f7ee;
      border: 1px solid #abdcc0;
    }

    .submission-message.error {
      display: block;
      color: #8a2828;
      background: #fff0f0;
      border: 1px solid #edb6b6;
    }

    .form-notice {
      margin: 0;
      color: var(--muted);
      font-size: 0.84rem;
    }

    .hidden-field {
      position: absolute !important;
      left: -10000px !important;
      width: 1px !important;
      height: 1px !important;
      overflow: hidden !important;
    }

    .preparation-layout,
    .privacy-panel {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 72px;
      align-items: start;
    }

    .preparation-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .preparation-item {
      min-height: 66px;
      padding: 16px 18px;
      display: flex;
      align-items: center;
      gap: 13px;
      color: var(--navy);
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 16px;
      box-shadow: var(--shadow-small);
      font-weight: 700;
    }

    .privacy-panel {
      padding: 42px;
      background:
        radial-gradient(
          circle at 90% 10%,
          rgba(15, 124, 130, 0.11),
          transparent 30%
        ),
        linear-gradient(145deg, #f8fbff, #edf7ff);
      border: 1px solid var(--line);
      border-radius: 28px;
    }

    .privacy-copy {
      color: var(--muted);
    }

    .privacy-copy p:last-child {
      margin-bottom: 0;
    }

    @media (max-width: 980px) {
      .contact-layout,
      .preparation-layout,
      .privacy-panel {
        grid-template-columns: 1fr;
        gap: 34px;
      }

      .contact-information {
        position: static;
      }
    }

    @media (max-width: 680px) {
      .form-panel,
      .privacy-panel {
        padding: 27px 22px;
      }

      .form-grid,
      .preparation-list {
        grid-template-columns: 1fr;
      }

      .submit-button {
        width: 100%;
      }
    }
  </style>
</BaseLayout>