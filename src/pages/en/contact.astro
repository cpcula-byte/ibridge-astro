---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ContactForm from "../../components/ContactForm.astro";
import "../../styles/contact.css";
---

<BaseLayout
  title="Contact"
  description="Contact iBridge Education about curriculum design, professional development, educational research, AI in education, educational resources or school partnerships."
  locale="en"
  zhPath="/contact/"
  enPath="/en/contact/"
>
  <PageHero
    eyebrow="Contact"
    title="Begin with a clear description"
    accent="of your educational context."
    copy="Please include the current need, intended participants, expected outcomes and approximate timeframe. We will respond in writing or arrange a further discussion as appropriate."
  />

  <ContactForm lang="en" />
</BaseLayout>
