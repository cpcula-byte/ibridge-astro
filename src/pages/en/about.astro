---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Cta from "../../components/Cta.astro";
const principles = [
  ["01","Clarity over complexity","Translate research, curriculum structures and educational ideas into action that schools, teachers and learners can understand."],
  ["02","Context shapes method","No single approach fits every school; programmes must respond to real learner, educator and organisational contexts."],
  ["03","Evidence supports judgement","Research provides direction, while professional judgement, experience and continuing evaluation remain essential."],
  ["04","Development over short-term results","Education should also build thinking, resilience, independence and long-term learning capacity."]
];
const fields = ["International curriculum and unit design","Professional development","English and academic writing","Positive psychology and student wellbeing","Educational neuroscience","Artificial intelligence in education","Self-regulation and metacognition","Curriculum and programme evaluation"];
---
<BaseLayout title="About" description="Learn how iBridge Education connects international education, research and school practice." locale="en" zhPath="/about/" enPath="/en/about/">
  <PageHero eyebrow="About iBridge Education" title="Building meaningful connections" accent="between research and practice." copy="iBridge Education turns international education, educational research and practical innovation into clear, feasible and valuable learning experiences." />
  <section class="section section-white"><div class="container split"><div><p class="eyebrow">Our mission</p><h2>Bring educational research into curricula, classrooms and learners’ real experiences.</h2></div><div class="prose"><p>Many educational ideas are valuable, but without clear structures, implementation and sustained support, they rarely create lasting impact in real schools.</p><p>iBridge Education helps educators bridge theory and practice by turning complex content into understandable, adaptable and sustainable programmes.</p></div></div></section>
  <section class="section section-ivory"><div class="container"><div class="section-heading"><div><p class="eyebrow">Our principles</p><h2>Responsible innovation begins with clear values and judgement.</h2></div></div><div class="grid-4">{principles.map(([n,t,d]) => <article class="card"><span class="card-number">{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div></div></section>
  <section class="section section-dark"><div class="container split"><div><p class="eyebrow eyebrow-light">Areas of expertise</p><h2>Interdisciplinary, but always centred on learning quality.</h2><p>These areas work together to shape how learners understand, participate and continue learning.</p></div><div class="list-panel">{fields.map((item,i)=><div class="list-row"><span>{String(i+1).padStart(2,"0")}</span><strong style="color:white">{item}</strong></div>)}</div></div></section>
  <section class="section section-white"><div class="container"><div class="section-heading"><div><p class="eyebrow">How we work</p><h2>Understand the context before designing the programme.</h2></div></div><div class="grid-4">{[["01","Understand needs","Clarify the issues facing the school, educators, learners and curriculum."],["02","Set direction","Define goals, success criteria and feasible development steps."],["03","Co-design","Develop curricula, tools, professional learning or research programmes."],["04","Evaluate and adapt","Improve continuously using outcomes, feedback and evidence."]].map(([n,t,d])=><article class="card"><span class="card-number">{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div></div></section>
  <Cta eyebrow="Start a conversation" title="Discuss your school, curriculum or education project." copy="Share the current need, participants, intended outcomes and approximate timeline so we can identify the next step." label="Contact iBridge" href="/en/contact/" />
</BaseLayout>
