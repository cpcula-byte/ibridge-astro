---
import BaseLayout from "../../layouts/BaseLayout.astro";

const principles = [
  {
    number: "01",
    title: "Clarity over complexity",
    description:
      "We translate research, curriculum frameworks and educational ideas into actions that schools, teachers and learners can understand and use.",
  },
  {
    number: "02",
    title: "Context shapes method",
    description:
      "No single model works everywhere. Programmes must respond to the actual learners, educators, curriculum and organisation.",
  },
  {
    number: "03",
    title: "Evidence supports judgement",
    description:
      "Research provides direction, while professional judgement, practical experience and continued evaluation remain essential.",
  },
  {
    number: "04",
    title: "Development over short-term results",
    description:
      "Education is not only about immediate performance. It should also build thinking, resilience, independence and lifelong learning capacity.",
  },
];

const expertise = [
  "International curriculum and unit design",
  "Teacher professional development",
  "English and academic writing",
  "Positive psychology and student wellbeing",
  "Educational neuroscience",
  "Artificial intelligence in education",
  "Self-regulation and metacognition",
  "Programme and curriculum evaluation",
];
---

<BaseLayout
  title="About Us"
  description="Learn about iBridge Education, our educational principles, professional expertise and approach to connecting international education, research and practical innovation."
  locale="en"
  zhPath="/about"
  enPath="/en/about"
  pageType="AboutPage"
  breadcrumbs={[
    {
      name: "Home",
      path: "/en/",
    },
    {
      name: "About Us",
      path: "/en/about",
    },
  ]}
>
  <section class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">About iBridge Education</p>

        <h1>
          Building meaningful connections
          <span>between research and practice.</span>
        </h1>
      </div>

      <div class="hero-copy">
        <p>
          iBridge Education translates international education,
          educational research and practical innovation into clear,
          sustainable and valuable learning experiences.
        </p>

        <p>
          We work with schools, educators and educational teams to design
          curricula, strengthen professional capacity, integrate technology
          and build deeper and more resilient learning environments.
        </p>
      </div>
    </div>
  </section>

  <section class="mission-section">
    <div class="container mission-grid">
      <div class="mission-marker" aria-hidden="true">iB</div>

      <div class="mission-content">
        <p class="section-label">Our mission</p>

        <h2>
          To move educational research beyond ideas and into curricula,
          classrooms and authentic learner experiences.
        </h2>

        <div class="mission-copy">
          <p>
            Many educational ideas have genuine value, but without clear
            structures, implementation processes and continued support,
            they rarely create lasting impact in real schools.
          </p>

          <p>
            iBridge Education helps educators build bridges between theory
            and practice, translating complex content into programmes that
            are understandable, adaptable and sustainable.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="principles-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-label">Our principles</p>
        <h2>Thoughtful innovation begins with clear values and sound judgement.</h2>
      </div>

      <div class="principle-grid">
        {
          principles.map((principle) => (
            <article class="principle-card">
              <span>{principle.number}</span>
              <h3>{principle.title}</h3>
              <p>{principle.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="expertise-section">
    <div class="container expertise-grid">
      <div class="expertise-copy">
        <p class="section-label">Areas of expertise</p>

        <h2>Interdisciplinary work centred on the quality of learning.</h2>

        <p>
          Our work connects curriculum design, language learning,
          professional development, educational research, artificial
          intelligence and student wellbeing. These areas are not separate;
          together, they influence how learners understand, participate
          and continue to grow.
        </p>
      </div>

      <div class="expertise-list">
        {
          expertise.map((item, index) => (
            <div class="expertise-item">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{item}</strong>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="approach-section">
    <div class="container approach-card">
      <div>
        <p class="section-label light-label">How we work</p>

        <h2>Understand the context before designing the solution.</h2>

        <p>
          Every partnership begins with the organisation’s context,
          learner needs, existing resources and stage of development.
          We do not offer fixed answers; we work collaboratively to create
          the most appropriate direction for each setting.
        </p>
      </div>

      <ol>
        <li>
          <span>01</span>
          <div>
            <h3>Understand the need</h3>
            <p>
              Clarify the current challenges facing the school,
              educators, learners and curriculum.
            </p>
          </div>
        </li>

        <li>
          <span>02</span>
          <div>
            <h3>Establish direction</h3>
            <p>
              Define clear objectives, indicators of success
              and realistic stages of development.
            </p>
          </div>
        </li>

        <li>
          <span>03</span>
          <div>
            <h3>Design collaboratively</h3>
            <p>
              Develop curricula, tools, professional learning
              or research programmes together.
            </p>
          </div>
        </li>

        <li>
          <span>04</span>
          <div>
            <h3>Evaluate and refine</h3>
            <p>
              Improve the work through implementation evidence,
              professional feedback and continued review.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-card">
      <div>
        <p class="eyebrow">Start a conversation</p>
        <h2>Discuss your school, curriculum or educational project.</h2>
      </div>

      <a href="/en/contact">Contact iBridge</a>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .page-hero {
    padding: 112px 0 102px;
    background:
      linear-gradient(125deg, #f5faf9 0%, #eaf7f4 100%);
  }

  .page-hero-grid {
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    gap: 90px;
    align-items: end;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 18px;
    color: #0b6675;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    color: #0a355b;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  h1 {
    font-size: clamp(3.1rem, 6.3vw, 5.8rem);
    line-height: 0.99;
  }

  h1 span {
    display: block;
    margin-top: 14px;
    color: #0b6675;
  }

  .hero-copy {
    display: grid;
    gap: 22px;
    padding-bottom: 10px;
  }

  .hero-copy p,
  .mission-copy p,
  .expertise-copy > p,
  .approach-card > div > p {
    margin: 0;
    color: #587286;
    font-size: 1.03rem;
    line-height: 1.85;
  }

  .mission-section,
  .principles-section,
  .expertise-section,
  .approach-section {
    padding: 104px 0;
  }

  .mission-grid {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 70px;
  }

  .mission-marker {
    color: rgba(11, 102, 117, 0.14);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 8rem;
    font-weight: 700;
    line-height: 0.9;
  }

  .mission-content h2,
  .section-heading h2,
  .expertise-copy h2,
  .approach-card h2,
  .cta-card h2 {
    max-width: 930px;
    font-size: clamp(2.35rem, 4vw, 4.15rem);
    line-height: 1.08;
  }

  .mission-copy {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 42px;
    margin-top: 42px;
  }

  .principles-section {
    background: #f7fafb;
  }

  .section-heading {
    max-width: 900px;
    margin-bottom: 50px;
  }

  .principle-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .principle-card {
    min-height: 310px;
    padding: 28px;
    border: 1px solid rgba(10, 53, 91, 0.1);
    border-radius: 18px;
    background: #ffffff;
  }

  .principle-card > span {
    color: #0b6675;
    font-size: 0.74rem;
    font-weight: 800;
  }

  .principle-card h3 {
    margin: 58px 0 16px;
    color: #123e60;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.45rem;
  }

  .principle-card p {
    margin: 0;
    color: #61798b;
    line-height: 1.75;
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: 90px;
    align-items: start;
  }

  .expertise-copy > p {
    margin-top: 28px;
  }

  .expertise-list {
    border-top: 1px solid rgba(10, 53, 91, 0.13);
  }

  .expertise-item {
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 18px;
    padding: 21px 0;
    border-bottom: 1px solid rgba(10, 53, 91, 0.13);
  }

  .expertise-item span {
    color: #0b6675;
    font-size: 0.74rem;
    font-weight: 800;
  }

  .expertise-item strong {
    color: #173f60;
  }

  .approach-section {
    padding-top: 20px;
  }

  .approach-card {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 76px;
    padding: 64px;
    border-radius: 28px;
    background: #082f52;
  }

  .light-label {
    color: #76d0c8;
  }

  .approach-card h2 {
    color: #ffffff;
  }

  .approach-card > div > p {
    margin-top: 25px;
    color: #bfd0dc;
  }

  .approach-card ol {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .approach-card li {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: 18px;
    padding: 20px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
  }

  .approach-card li:first-child {
    border-top: 0;
  }

  .approach-card li > span {
    color: #76d0c8;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .approach-card h3 {
    margin: 0 0 8px;
    color: #ffffff;
    font-size: 1.08rem;
  }

  .approach-card li p {
    margin: 0;
    color: #bccbd7;
    line-height: 1.65;
  }

  .cta-section {
    padding: 20px 0 100px;
  }

  .cta-card {
    display: flex;
    justify-content: space-between;
    gap: 50px;
    align-items: center;
    padding: 54px 60px;
    border-radius: 24px;
    background:
      linear-gradient(115deg, #edf8f5 0%, #dcefeb 100%);
  }

  .cta-card h2 {
    max-width: 780px;
    font-size: clamp(2.15rem, 3.6vw, 3.7rem);
  }

  .cta-card a {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 25px;
    border-radius: 999px;
    background: #0a4d70;
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .page-hero-grid,
    .mission-grid,
    .expertise-grid,
    .approach-card {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .principle-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cta-card {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .container {
      width: min(100% - 30px, 1180px);
    }

    .page-hero {
      padding: 82px 0 74px;
    }

    h1 {
      font-size: clamp(2.7rem, 14vw, 4.2rem);
    }

    .mission-section,
    .principles-section,
    .expertise-section,
    .approach-section {
      padding: 76px 0;
    }

    .mission-copy,
    .principle-grid {
      grid-template-columns: 1fr;
    }

    .mission-marker {
      font-size: 5rem;
    }

    .approach-card,
    .cta-card {
      padding: 34px 26px;
    }

    .cta-section {
      padding-bottom: 74px;
    }
  }
</style>