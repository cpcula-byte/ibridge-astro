---
import BaseLayout from "../../layouts/BaseLayout.astro";

const lastUpdated = "26 July 2026";

const commitments = [
  {
    number: "01",
    title: "Clear and consistent navigation",
    text:
      "We aim to use clear page structures, headings, navigation links and consistent layouts so that users can understand the website and move between pages efficiently.",
  },
  {
    number: "02",
    title: "Keyboard access",
    text:
      "Important navigation, links, buttons and forms should be accessible by keyboard. The website also provides a skip link so keyboard and screen-reader users can bypass repeated navigation.",
  },
  {
    number: "03",
    title: "Text and colour",
    text:
      "We use text and background combinations with reasonable contrast and avoid relying only on colour to communicate important information. Text and layouts adapt to desktop, tablet and mobile screens.",
  },
  {
    number: "04",
    title: "Semantic structure",
    text:
      "The website uses semantic HTML elements such as headings, paragraphs, lists, navigation regions, main content and footers to help assistive technologies interpret each page.",
  },
  {
    number: "05",
    title: "Images and visual content",
    text:
      "Informative images should include appropriate alternative text. Decorative images are handled in a way that reduces unnecessary interruption for screen-reader users.",
  },
  {
    number: "06",
    title: "Forms and error messages",
    text:
      "Contact forms should use clear field labels, required-field indicators and understandable error messages so that users can complete and submit information successfully.",
  },
];

const knownLimitations = [
  "The accessibility of some third-party services or embedded content may be controlled by the relevant service provider.",
  "Some older PDFs, teaching materials or downloadable files may not yet meet every accessibility requirement.",
  "Automatically generated or externally sourced content may require additional manual review and correction.",
  "Presentation may vary between browsers, devices and assistive technologies.",
];

const feedbackItems = [
  "A function cannot be accessed using a keyboard",
  "A screen reader cannot interpret part of a page",
  "Text, buttons or links have insufficient contrast",
  "An informative image is missing alternative text",
  "A form label or error message is unclear",
  "A PDF or downloadable resource is difficult to read or operate",
];
---

<BaseLayout
  title="Accessibility Statement"
  description="Learn how iBridge Education improves keyboard access, semantic structure, colour contrast, forms, images and downloadable educational resources."
  locale="en"
>
  <section class="page-hero">
    <div class="hero-decoration" aria-hidden="true">
      <span class="hero-circle hero-circle-one"></span>
      <span class="hero-circle hero-circle-two"></span>
      <span class="hero-line"></span>
    </div>

    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Accessibility Statement</p>

        <h1>
          Making educational information and resources
          <span>more accessible to every user.</span>
        </h1>
      </div>

      <div class="hero-copy">
        <p>
          iBridge Education is committed to improving website accessibility
          and regularly reviewing navigation, text, images, forms and downloads.
        </p>

        <div class="updated-card">
          <span>Last updated</span>
          <strong>{lastUpdated}</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="intro-section">
    <div class="container intro-grid">
      <div>
        <p class="section-label">Our objective</p>

        <h2>
          A clear and reliable educational website that supports different ways of accessing content.
        </h2>
      </div>

      <div class="intro-card">
        <p>
          We want educators, students, families, researchers and organisations
          to understand and use important website content whether they use
          a mouse, keyboard, touch device or assistive technology.
        </p>

        <p>
          Accessibility improvement is an ongoing process.
          As the website and its resources develop, we will continue
          to review and correct identified issues.
        </p>
      </div>
    </div>
  </section>

  <section class="commitment-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-label">Website principles</p>

        <h2>
          Accessibility measures currently used on the website
        </h2>
      </div>

      <div class="commitment-grid">
        {
          commitments.map((commitment) => (
            <article class="commitment-card">
              <span>{commitment.number}</span>

              <h3>{commitment.title}</h3>

              <p>{commitment.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="standards-section">
    <div class="container standards-grid">
      <div class="standards-copy">
        <p class="section-label">Reference principles</p>

        <h2>
          We use recognised web-accessibility principles to guide improvements.
        </h2>

        <p>
          Website design and updates consider perceivable, operable,
          understandable and robust content, with particular attention
          to keyboard access, screen readers, content structure and contrast.
        </p>

        <p>
          This statement does not claim that every page will produce
          an identical or fully accessible result in every browser,
          device and assistive technology.
        </p>
      </div>

      <div class="principle-list">
        <article>
          <span aria-hidden="true">01</span>
          <div>
            <h3>Perceivable</h3>
            <p>Content should be presented in ways that can be understood visually, textually or through assistive technology.</p>
          </div>
        </article>

        <article>
          <span aria-hidden="true">02</span>
          <div>
            <h3>Operable</h3>
            <p>Navigation, forms and interactive functions should support keyboard access and different input methods.</p>
          </div>
        </article>

        <article>
          <span aria-hidden="true">03</span>
          <div>
            <h3>Understandable</h3>
            <p>Text, navigation, field labels and error messages should remain clear and consistent.</p>
          </div>
        </article>

        <article>
          <span aria-hidden="true">04</span>
          <div>
            <h3>Robust</h3>
            <p>The website should use standard structures to improve compatibility with browsers and assistive technologies.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="limitations-section">
    <div class="container limitations-grid">
      <div>
        <p class="section-label">Current limitations</p>

        <h2>
          Some content may still require further improvement.
        </h2>
      </div>

      <div class="limitations-card">
        <ul>
          {
            knownLimitations.map((item) => (
              <li>{item}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="feedback-section">
    <div class="container feedback-grid">
      <div class="feedback-copy">
        <p class="section-label light-label">Report an issue</p>

        <h2>
          When reporting an accessibility problem, include the page and a clear description.
        </h2>

        <p>
          We will review specific and reasonable reports and prioritise
          improvements according to impact, technical constraints and available resources.
        </p>

        <a href="/en/contact/">
          Contact us
        </a>
      </div>

      <div class="feedback-card">
        <h3>Issues that may be reported</h3>

        <ul>
          {
            feedbackItems.map((item) => (
              <li>{item}</li>
            ))
          }
        </ul>

        <div class="contact-details">
          <span>Email</span>

          <a href="mailto:hello@ibridge.info">
            hello@ibridge.info
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .page-hero {
    position: relative;
    overflow: hidden;
    padding: 112px 0 104px;
    background:
      radial-gradient(
        circle at 88% 14%,
        rgba(196, 138, 44, 0.12),
        transparent 28%
      ),
      linear-gradient(
        125deg,
        #f7f1e3 0%,
        #faf7f0 100%
      );
  }

  .hero-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-circle {
    position: absolute;
    border: 1px solid rgba(165, 28, 48, 0.16);
    border-radius: 999px;
  }

  .hero-circle-one {
    top: -270px;
    right: -90px;
    width: 520px;
    height: 520px;
  }

  .hero-circle-two {
    right: 240px;
    bottom: -175px;
    width: 260px;
    height: 260px;
  }

  .hero-line {
    position: absolute;
    top: 58%;
    right: -120px;
    width: 700px;
    height: 1px;
    background: rgba(165, 28, 48, 0.16);
    transform: rotate(-16deg);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 90px;
    align-items: end;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 18px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    color: #1f2933;
    font-family:
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif;
    font-weight: 700;
  }

  h1,
  h2 {
    letter-spacing: -0.045em;
  }

  h1 {
    font-size: clamp(3.1rem, 6.2vw, 5.7rem);
    line-height: 0.99;
  }

  h1 span {
    display: block;
    margin-top: 14px;
    color: #a51c30;
  }

  .hero-copy {
    display: grid;
    gap: 28px;
  }

  .hero-copy > p,
  .intro-card p,
  .commitment-card p,
  .standards-copy > p,
  .principle-list p,
  .feedback-copy > p {
    margin: 0;
    color: #52606d;
    font-size: 1.02rem;
    line-height: 1.82;
  }

  .updated-card {
    display: grid;
    gap: 5px;
    width: fit-content;
    padding: 18px 22px;
    border: 1px solid #e4d7c5;
    border-radius: 14px;
    background: #faf7f0;
  }

  .updated-card span {
    color: #315c6b;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .updated-card strong {
    color: #1f2933;
  }

  .intro-section,
  .commitment-section,
  .standards-section,
  .limitations-section,
  .feedback-section {
    padding: 104px 0;
  }

  .intro-section,
  .standards-section {
    background: #faf7f0;
  }

  .commitment-section,
  .limitations-section {
    background: #f7f1e3;
  }

  .intro-grid,
  .limitations-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 80px;
    align-items: start;
  }

  .intro-grid h2,
  .section-heading h2,
  .standards-copy h2,
  .limitations-grid h2,
  .feedback-copy h2 {
    font-size: clamp(2.35rem, 4vw, 4.1rem);
    line-height: 1.08;
  }

  .intro-card {
    display: grid;
    gap: 22px;
    padding: 36px;
    border: 1px solid #e4d7c5;
    border-radius: 22px;
    background: #f7f1e3;
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 54px;
  }

  .commitment-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .commitment-card {
    min-height: 290px;
    padding: 30px;
    border: 1px solid #e4d7c5;
    border-radius: 20px;
    background: #faf7f0;
  }

  .commitment-card > span {
    display: block;
    margin-bottom: 42px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .commitment-card h3 {
    margin-bottom: 16px;
    font-size: 1.3rem;
  }

  .commitment-card p {
    font-size: 0.96rem;
  }

  .standards-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 84px;
    align-items: start;
  }

  .standards-copy {
    display: grid;
    gap: 22px;
  }

  .standards-copy .section-label {
    margin-bottom: -4px;
  }

  .principle-list {
    border-top: 1px solid #e4d7c5;
  }

  .principle-list article {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 22px;
    padding: 27px 0;
    border-bottom: 1px solid #e4d7c5;
  }

  .principle-list article > span {
    padding-top: 4px;
    color: #a51c30;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .principle-list h3 {
    margin-bottom: 8px;
    font-size: 1.25rem;
  }

  .principle-list p {
    font-size: 0.95rem;
  }

  .limitations-card {
    padding: 36px;
    border: 1px solid #e4d7c5;
    border-radius: 22px;
    background: #faf7f0;
  }

  .limitations-card ul,
  .feedback-card ul {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .limitations-card li,
  .feedback-card li {
    position: relative;
    padding-left: 24px;
    color: #52606d;
    line-height: 1.75;
  }

  .limitations-card li::before,
  .feedback-card li::before {
    position: absolute;
    top: 0.65em;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #c48a2c;
    content: "";
  }

  .feedback-section {
    background:
      linear-gradient(
        115deg,
        #7b1422 0%,
        #a51c30 72%,
        #b72e42 100%
      );
  }

  .feedback-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 72px;
    align-items: center;
  }

  .light-label {
    color: #f2c66d;
  }

  .feedback-copy h2 {
    color: #ffffff;
  }

  .feedback-copy > p {
    margin-top: 24px;
    color: rgba(255, 255, 255, 0.8);
  }

  .feedback-copy > a {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    margin-top: 30px;
    padding: 0 26px;
    border-radius: 999px;
    background: #ffffff;
    color: #7b1422;
    font-weight: 700;
    text-decoration: none;
  }

  .feedback-copy > a:hover {
    background: #c48a2c;
    color: #1f2933;
  }

  .feedback-card {
    padding: 36px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.96);
  }

  .feedback-card h3 {
    margin-bottom: 24px;
    font-size: 1.35rem;
  }

  .feedback-card li {
    font-size: 0.95rem;
  }

  .contact-details {
    display: grid;
    gap: 6px;
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid #e4d7c5;
  }

  .contact-details span {
    color: #a51c30;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .contact-details a {
    color: #315c6b;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .intro-grid,
    .standards-grid,
    .limitations-grid,
    .feedback-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .commitment-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 720px) {
    .container {
      width: min(100% - 30px, 1180px);
    }

    .page-hero {
      padding: 82px 0 74px;
    }

    h1 {
      font-size: clamp(2.7rem, 14vw, 4.2rem);
    }

    .intro-section,
    .commitment-section,
    .standards-section,
    .limitations-section,
    .feedback-section {
      padding: 76px 0;
    }

    .commitment-grid {
      grid-template-columns: 1fr;
    }

    .commitment-card,
    .intro-card,
    .limitations-card,
    .feedback-card {
      padding: 26px;
    }

    .commitment-card {
      min-height: auto;
    }
  }
</style>