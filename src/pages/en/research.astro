---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Cta from "../../components/Cta.astro";
const areas = [
  ["01","Positive Psychology and Student Wellbeing","Explore how strengths, hope, gratitude, resilience and learning environments support wellbeing and engagement."],
  ["02","Educational Neuroscience","Translate neuroplasticity, stress physiology, attention, memory and emotion regulation into responsible educational practice."],
  ["03","Self-Regulated Learning and Metacognition","Study how learners plan, monitor, adapt and reflect on learning."],
  ["04","Artificial Intelligence in Education","Examine generative AI, educator workflows, feedback, assessment, academic integrity and AI literacy."],
  ["05","International Curriculum and Assessment","Investigate curriculum coherence, concept-based learning, vertical alignment and assessment quality."],
  ["06","Programme Evaluation and School Improvement","Use quantitative and qualitative evidence to examine feasibility, impact and long-term value."]
];
---
<BaseLayout title="Research" description="Explore iBridge Education research in positive psychology, educational neuroscience, self-regulated learning, artificial intelligence and curriculum design." locale="en" zhPath="/research/" enPath="/en/research/">
  <PageHero eyebrow="Educational research" title="Make research understandable," accent="implementable and useful for continuous improvement." copy="We focus on how research creates value in real schools rather than remaining at the level of theory or terminology." />
  <section class="section section-white"><div class="container split"><div><p class="eyebrow">Research position</p><h2>Rigorous evidence and professional judgement must work together.</h2></div><div class="prose"><p>Educational research can offer direction, explanations and possibilities, but it cannot be separated from learners, educators, curricula and organisational context.</p><p>We prioritise clear questions, appropriate tools, ethics and privacy, and whether findings can become feasible improvement.</p></div></div></section>
  <section class="section section-ivory"><div class="container"><div class="section-heading"><div><p class="eyebrow">Research areas</p><h2>Connecting learning science, curriculum design and school improvement.</h2></div></div><div class="grid-3">{areas.map(([n,t,d])=><article class="card"><span class="card-number">{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div></div></section>
  <section class="section section-dark"><div class="container"><div class="section-heading"><div><p class="eyebrow eyebrow-light">Research process</p><h2>From questions to evidence, and back to practice.</h2></div></div><div class="grid-4">{[["01","Define the problem","Clarify purpose, participants, context and success criteria."],["02","Design the method","Select suitable quantitative, qualitative or mixed methods."],["03","Collect and analyse","Prioritise ethics, privacy, credibility and transparency."],["04","Translate and improve","Turn findings into curricula, tools, recommendations and follow-up evaluation."]].map(([n,t,d])=><article class="card dark-card"><span class="card-number">{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div></div></section>
  <Cta eyebrow="Research partnership" title="Discuss educational research, programme evaluation or data-tool design." copy="Share the research question, participants, available data, timeframe and intended outputs." label="Contact iBridge" href="/en/contact/" />
</BaseLayout>
