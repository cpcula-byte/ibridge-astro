---
import BaseLayout from "../../layouts/BaseLayout.astro";

const researchAreas = [
  {
    number: "01",
    title: "Applied Neuroscience and Learning",
    description:
      "We investigate the relationships between attention, motivation, stress, self-regulation and academic learning, then translate findings into practical educational strategies.",
    topics: [
      "Attention and cognitive load",
      "Stress physiology and learning",
      "Neuroplasticity and learning beliefs",
      "Self-regulation and executive function",
      "Sleep, emotion and academic performance",
    ],
  },
  {
    number: "02",
    title: "Positive Psychology and Learning Resilience",
    description:
      "We examine the relationships between student wellbeing, resilience, personal strengths and academic development, while designing interventions suited to school contexts.",
    topics: [
      "Personal strengths and learner identity",
      "Resilience and coping strategies",
      "Gratitude and positive emotion",
      "Emotional regulation and stress management",
      "Student wellbeing and academic performance",
    ],
  },
  {
    number: "03",
    title: "Artificial Intelligence, Writing and Assessment",
    description:
      "We investigate how generative artificial intelligence affects writing, authorship, feedback, academic integrity and authentic assessment.",
    topics: [
      "AI-supported writing and feedback",
      "Authorship and originality",
      "Artificial intelligence literacy",
      "Authentic assessment design",
      "Academic integrity and responsible use",
    ],
  },
  {
    number: "04",
    title: "International Curriculum and Teacher Development",
    description:
      "We study curriculum design, professional learning, assessment practice and educational change in international schools.",
    topics: [
      "IB MYP and DP curriculum design",
      "Teacher professional learning",
      "Assessment literacy and standardisation",
      "Interdisciplinary and concept-based learning",
      "Curriculum reform and implementation",
    ],
  },
];

const researchProcess = [
  {
    number: "01",
    title: "Define the Problem",
    description:
      "Begin with authentic school, teacher and student needs to establish a clear, meaningful and researchable question.",
  },
  {
    number: "02",
    title: "Design the Study",
    description:
      "Select appropriate methods, participants, data sources, measurement tools and ethical procedures.",
  },
  {
    number: "03",
    title: "Collect and Analyse Evidence",
    description:
      "Use quantitative and qualitative evidence systematically to understand implementation and impact.",
  },
  {
    number: "04",
    title: "Translate the Findings",
    description:
      "Turn research findings into strategies that teachers can use, students can benefit from and schools can sustain.",
  },
];

const methods = [
  {
    title: "Quantitative Research",
    description:
      "Uses surveys, validated measures, attainment data, attendance, assessment results and statistical analysis to examine impact.",
  },
  {
    title: "Qualitative Research",
    description:
      "Uses interviews, focus groups, observations, reflective journals and text analysis to understand participant experiences.",
  },
  {
    title: "Mixed-methods Research",
    description:
      "Combines quantitative and qualitative evidence to create a more complete and contextualised understanding.",
  },
  {
    title: "Action Research",
    description:
      "Supports teachers and schools in planning, implementing, evaluating and improving educational initiatives in authentic settings.",
  },
];

const currentThemes = [
  {
    label: "Student Wellbeing",
    title: "Integrating positive psychology and neuroscience into writing education",
    description:
      "Examining whether structured reflection, strengths, self-regulation and stress-management activities improve wellbeing, engagement and learning.",
  },
  {
    label: "AI and Assessment",
    title: "Authentic writing assessment in the age of generative AI",
    description:
      "Investigating how schools can redesign writing tasks, feedback processes and academic-integrity expectations in response to generative AI.",
  },
  {
    label: "Curriculum Design",
    title: "Aligning writing and thinking from MYP to DP",
    description:
      "Exploring how schools can establish a coherent progression of writing and thinking skills across year levels and subjects.",
  },
];

const outputs = [
  "Research designs and ethics documentation",
  "Surveys, interviews and data-collection tools",
  "Statistical and qualitative analysis",
  "Educational programme evaluation reports",
  "Teacher implementation guidance",
  "School-development recommendations",
  "Conference and professional presentations",
  "Academic papers and research summaries",
];
---

<BaseLayout
  locale="en"
  title="Research"
  description="iBridge Education conducts research in applied neuroscience, positive psychology, artificial intelligence, writing, assessment and international education."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Research at iBridge</span>

      <h1>Using evidence to support better educational decisions</h1>

      <p class="lead">
        iBridge Education connects educational research, learning science
        and classroom practice to help schools understand problems,
        evaluate impact and establish systems of continuous improvement.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container research-intro">
      <div>
        <span class="eyebrow">Our Research Approach</span>

        <h2 class="section-title">
          Research is not only about collecting data
        </h2>
      </div>

      <div class="research-copy">
        <p>
          Educational research is valuable not only because it answers
          theoretical questions, but because it helps schools, teachers
          and students understand what is happening and which changes
          are genuinely effective.
        </p>

        <p>
          Our work begins with authentic educational problems and places
          strong emphasis on research ethics, methodological quality,
          participant experience and practical application.
        </p>

        <p>
          The goal is not simply to produce a report. It is to translate
          evidence into meaningful improvements in curriculum, teaching,
          assessment and student support.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <span class="eyebrow">Research Areas</span>

      <h2 class="section-title">
        Four core areas of research
      </h2>

      <p class="lead">
        Our work focuses on the intersections between learning,
        student wellbeing, artificial intelligence and international
        educational practice.
      </p>

      <div class="research-area-list">
        {
          researchAreas.map((area) => (
            <article class="research-area-card">
              <div class="research-area-heading">
                <span class="research-number">{area.number}</span>

                <div>
                  <h3>{area.title}</h3>
                  <p>{area.description}</p>
                </div>
              </div>

              <ul class="research-topic-list">
                {
                  area.topics.map((topic) => (
                    <li>
                      <span class="check-mark">✓</span>
                      <span>{topic}</span>
                    </li>
                  ))
                }
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Research Process</span>

      <h2 class="section-title">
        From defining the problem to practical improvement
      </h2>

      <p class="lead">
        Every study follows a clear and traceable process so that the
        question, methods, analysis and practical application remain aligned.
      </p>

      <div class="grid-4 process-grid">
        {
          researchProcess.map((step) => (
            <article class="card process-card">
              <div class="process-number">{step.number}</div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-blue">
    <div class="container">
      <span class="eyebrow">Research Methods</span>

      <h2 class="section-title">
        Methods suited to authentic educational contexts
      </h2>

      <p class="lead">
        Methods are selected according to the research question,
        participants, available evidence and implementation environment,
        rather than through a fixed model.
      </p>

      <div class="grid-4 method-grid">
        {
          methods.map((method) => (
            <article class="card method-card">
              <h3>{method.title}</h3>
              <p>{method.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Current Themes</span>

      <h2 class="section-title">
        Current areas of investigation
      </h2>

      <div class="theme-grid">
        {
          currentThemes.map((theme) => (
            <article class="theme-card">
              <span class="theme-label">{theme.label}</span>
              <h3>{theme.title}</h3>
              <p>{theme.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container output-layout">
      <div>
        <span class="eyebrow">Research Outputs</span>

        <h2 class="section-title">
          From evidence to usable outcomes
        </h2>

        <p class="lead">
          Research outputs are presented in formats suitable for schools,
          teachers, research institutions and professional communities.
        </p>
      </div>

      <div class="output-list">
        {
          outputs.map((output) => (
            <div class="output-item">
              <span class="check-mark">✓</span>
              <span>{output}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container research-cta">
      <div>
        <span class="eyebrow">Research Partnership</span>

        <h2 class="section-title">
          Transform educational challenges into valuable research
        </h2>

        <p class="lead">
          We welcome enquiries from schools, teaching teams,
          educational organisations and researchers regarding study design,
          programme evaluation, data analysis and collaborative research.
        </p>
      </div>

      <div class="research-actions">
        <a class="button button-primary" href="/en/contact">
          Discuss a Research Partnership
        </a>

        <a class="button button-secondary" href="/en/services">
          View Consultancy Services
        </a>
      </div>
    </div>
  </section>

  <style>
    .research-intro {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 72px;
      align-items: start;
    }

    .research-copy {
      color: var(--muted);
      font-size: 1.08rem;
    }

    .research-copy p {
      margin-bottom: 22px;
    }

    .research-area-list {
      margin-top: 48px;
      display: grid;
      gap: 22px;
    }

    .research-area-card {
      padding: 34px;

      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;

      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--radius-large);
      box-shadow: var(--shadow-small);
    }

    .research-area-heading {
      display: grid;
      grid-template-columns: 52px 1fr;
      gap: 20px;
      align-items: start;
    }

    .research-number {
      width: 52px;
      height: 52px;

      display: grid;
      place-items: center;

      color: var(--teal);
      background: var(--teal-light);
      border-radius: 16px;

      font-size: 0.83rem;
      font-weight: 850;
      letter-spacing: 0.08em;
    }

    .research-area-heading h3 {
      margin-bottom: 12px;
      color: var(--navy);
      font-size: 1.5rem;
    }

    .research-area-heading p {
      margin-bottom: 0;
      color: var(--muted);
    }

    .research-topic-list {
      margin: 0;
      padding: 22px;

      display: grid;
      gap: 14px;

      list-style: none;
      background: var(--soft);
      border-radius: 18px;
    }

    .research-topic-list li {
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }

    .process-grid,
    .method-grid {
      margin-top: 44px;
    }

    .process-number {
      margin-bottom: 18px;
      color: var(--teal);
      font-size: 0.84rem;
      font-weight: 850;
      letter-spacing: 0.1em;
    }

    .process-card h3,
    .method-card h3 {
      color: var(--navy);
    }

    .theme-grid {
      margin-top: 44px;

      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }

    .theme-card {
      padding: 30px;

      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--radius-large);
      box-shadow: var(--shadow-small);
    }

    .theme-label {
      display: inline-flex;
      margin-bottom: 18px;
      padding: 6px 11px;

      color: var(--teal);
      background: var(--teal-light);
      border-radius: 999px;

      font-size: 0.78rem;
      font-weight: 800;
    }

    .theme-card h3 {
      margin-bottom: 12px;
      color: var(--navy);
      font-size: 1.35rem;
    }

    .theme-card p {
      margin-bottom: 0;
      color: var(--muted);
    }

    .output-layout {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 72px;
      align-items: start;
    }

    .output-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .output-item {
      min-height: 64px;
      padding: 16px 18px;

      display: flex;
      align-items: center;
      gap: 13px;

      color: var(--navy);
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 16px;
      box-shadow: var(--shadow-small);

      font-weight: 700;
    }

    .research-cta {
      padding: 52px;

      display: grid;
      grid-template-columns: 1fr auto;
      gap: 48px;
      align-items: center;

      background:
        radial-gradient(
          circle at 90% 10%,
          rgba(15, 124, 130, 0.13),
          transparent 28%
        ),
        linear-gradient(145deg, #f8fbff, #edf7ff);

      border: 1px solid var(--line);
      border-radius: 30px;
      box-shadow: var(--shadow-medium);
    }

    .research-actions {
      min-width: 210px;

      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    @media (max-width: 980px) {
      .research-intro,
      .research-area-card,
      .output-layout,
      .research-cta {
        grid-template-columns: 1fr;
        gap: 34px;
      }

      .theme-grid {
        grid-template-columns: 1fr;
      }

      .research-actions {
        flex-direction: row;
        flex-wrap: wrap;
      }
    }

    @media (max-width: 680px) {
      .research-area-card {
        padding: 24px;
      }

      .research-area-heading {
        grid-template-columns: 1fr;
      }

      .output-list {
        grid-template-columns: 1fr;
      }

      .research-cta {
        padding: 32px 24px;
      }

      .research-actions {
        flex-direction: column;
      }
    }
  </style>
</BaseLayout>