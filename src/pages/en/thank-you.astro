---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Message Sent Successfully"
  description="Your message has been submitted successfully to iBridge Education. We will review it and respond as soon as possible."
  locale="en"
  zhPath="/thank-you/"
  enPath="/en/thank-you/"
  noindex={true}
>
  <section class="success-page">
    <div class="decoration" aria-hidden="true">
      <span class="circle circle-one"></span>
      <span class="circle circle-two"></span>
      <span class="line"></span>
    </div>

    <div class="container">
      <div class="success-card">
        <div class="success-icon" aria-hidden="true">
          <svg
            viewBox="0 0 64 64"
            role="presentation"
          >
            <circle
              cx="32"
              cy="32"
              r="29"
            />

            <path
              d="M19 33.5 28 42l17-20"
            />
          </svg>
        </div>

        <p class="eyebrow">
          Message sent
        </p>

        <h1>
          Thank you for contacting
          <span>iBridge Education.</span>
        </h1>

        <p class="lead">
          We have received your message and will respond after reviewing
          the information provided. Keep access to the email address used
          in the form so that we can contact you.
        </p>

        <div class="information-card">
          <h2>What happens next?</h2>

          <ol>
            <li>
              <span>01</span>

              <div>
                <h3>We review your message</h3>
                <p>
                  We will check the name, email address,
                  enquiry topic and message you submitted.
                </p>
              </div>
            </li>

            <li>
              <span>02</span>

              <div>
                <h3>We prepare an appropriate response</h3>
                <p>
                  Your enquiry will be considered according to its focus,
                  such as curriculum design, professional learning,
                  research, resources or partnership opportunities.
                </p>
              </div>
            </li>

            <li>
              <span>03</span>

              <div>
                <h3>We contact you by email</h3>
                <p>
                  Our response will be sent to the email address
                  entered in the contact form.
                </p>
              </div>
            </li>
          </ol>
        </div>

        <div class="actions">
          <a
            class="primary-button"
            href="/en/"
          >
            Return home
          </a>

          <a
            class="secondary-button"
            href="/en/resources/"
          >
            Explore resources
          </a>
        </div>

        <div class="language-note">
          <span>繁體中文確認頁面</span>

          <a
            href="/thank-you/"
            hreflang="zh-Hant"
          >
            查看繁體中文
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

