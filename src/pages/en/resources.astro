---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Cta from "../../components/Cta.astro";
const resources = [
  ["MYP", "MYP Resources", "Unit planning, inquiry, assessment, language support and vertical alignment resources."],
  ["DP", "DP Resources", "Materials supporting disciplinary knowledge, conceptual understanding, academic writing and assessment preparation."],
  ["TOK", "Theory of Knowledge", "Learning experiences centred on questions, evidence, perspectives, methods and ethics."],
  ["ELA", "English and Academic Writing", "Reading, writing, speaking, listening and language-development materials across proficiency levels."],
  ["AI", "AI in Education", "Resources focused on safety, ethics, learning purposes, teacher judgement and classroom use."],
  ["WELL", "Learning and Resilience", "Practical resources connecting self-regulation, reflection, motivation, learning habits and wellbeing."]
];
---
<BaseLayout title="Educational Resources" description="Explore iBridge Education resources for MYP, DP, TOK, English, AI in education and student learning." locale="en" zhPath="/resources/" enPath="/en/resources/">
  <PageHero eyebrow="Educational resources" title="Clear, usable and" accent="continuously developed professional content." copy="The resource centre will organise materials by programme stage, subject, skill, resource type and language so educators can quickly find content to use or adapt." />
  <section class="section section-white"><div class="container">
    <div class="section-heading"><div><p class="eyebrow">Resource categories</p><h2>From curriculum architecture to classroom practice</h2></div></div>
    <div class="grid-3">{resources.map(([code,title,copy]) => <article class="card"><span class="card-number">{code}</span><h3>{title}</h3><p>{copy}</p><p><strong>Resources are being published progressively.</strong></p></article>)}</div>
  </div></section>
  <section class="section section-ivory"><div class="container split"><div><p class="eyebrow">Resource principles</p><h2>A structured learning pathway, not simply a file repository.</h2></div><div class="list-panel">
    {[["01","Clearly identify year level, programme stage and language level"],["02","Provide learning objectives, teacher guidance and student tasks"],["03","Show file format, page count, update date and intended use"],["04","Preserve flexibility for different schools and learner needs"]].map(([n,t]) => <div class="list-row"><span>{n}</span><strong>{t}</strong></div>)}
  </div></div></section>
  <Cta eyebrow="Resource partnerships" title="Develop credible, clear and practical educational content together." copy="Contact us about materials, curriculum publishing, bilingual resources, teacher tools and educational content partnerships." label="Contact iBridge" href="/en/contact/" />
</BaseLayout>
