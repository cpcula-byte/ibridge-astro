---
import BaseLayout from "../../layouts/BaseLayout.astro";

const resourceCategories = [
  {
    number: "01",
    title: "Curriculum and Unit Design",
    description:
      "Resources for curriculum mapping, unit planning, inquiry, conceptual development and vertical alignment.",
    resources: [
      "Curriculum mapping templates",
      "Unit planning frameworks",
      "Concept and inquiry tools",
      "Alignment checklists",
    ],
    status: "Continually updated",
  },
  {
    number: "02",
    title: "Teaching and Learning",
    description:
      "Support for inquiry-based learning, differentiation, academic language, collaboration and engagement.",
    resources: [
      "Inquiry activity examples",
      "Differentiation tools",
      "Discussion structures",
      "Learning strategy guides",
    ],
    status: "Continually updated",
  },
  {
    number: "03",
    title: "Assessment and Feedback",
    description:
      "Tools for effective assessment, success criteria, feedback processes and learner self-assessment.",
    resources: [
      "Formative assessment tools",
      "Success criteria templates",
      "Self- and peer-assessment forms",
      "Feedback design checklists",
    ],
    status: "Continually updated",
  },
  {
    number: "04",
    title: "English and Academic Writing",
    description:
      "Resources for textual analysis, essay structure, argument, language development and bilingual learning.",
    resources: [
      "Paragraph and essay structures",
      "Argumentation tools",
      "Text-type guides",
      "Vocabulary and language activities",
    ],
    status: "Priority area",
  },
  {
    number: "05",
    title: "Learning and Resilience",
    description:
      "Support for metacognition, self-regulation, emotional management, study habits and learner resilience.",
    resources: [
      "Learning reflection tools",
      "Goal-setting activities",
      "Stress-regulation resources",
      "Self-management checklists",
    ],
    status: "Research informed",
  },
  {
    number: "06",
    title: "Artificial Intelligence in Education",
    description:
      "Practical resources for teacher AI literacy, curriculum integration, academic integrity and responsible use.",
    resources: [
      "Teacher AI guidance",
      "AI curriculum examples",
      "Academic integrity tools",
      "AI policy templates",
    ],
    status: "In development",
  },
];

const featuredResources = [
  {
    type: "Curriculum Design",
    title: "International Curriculum Unit Planning Checklist",
    description:
      "A structured tool for reviewing alignment between objectives, inquiry, formative assessment and summative assessment.",
    format: "PDF",
    access: "Free resource",
    href: "#coming-soon",
  },
  {
    type: "Academic Writing",
    title: "Argumentative Writing Planner",
    description:
      "A planning framework for claims, evidence, reasoning, counterarguments and responses.",
    format: "PDF",
    access: "Free resource",
    href: "#coming-soon",
  },
  {
    type: "Student Learning",
    title: "Self-Regulated Learning Reflection",
    description:
      "A reflection tool for goal setting, strategy selection, progress monitoring and future improvement.",
    format: "PDF",
    access: "Free resource",
    href: "#coming-soon",
  },
];

const accessSteps = [
  {
    number: "01",
    title: "Select a resource area",
    description:
      "Browse by curriculum, teaching, assessment, language, student learning or artificial intelligence.",
  },
  {
    number: "02",
    title: "Review the guidance",
    description:
      "Each resource will identify its audience, purpose, format and recommended approach.",
  },
  {
    number: "03",
    title: "Download or read online",
    description:
      "Public resources will be downloadable, while full programmes may be available through online reading.",
  },
  {
    number: "04",
    title: "Adapt to the context",
    description:
      "Educators may adjust resources according to proficiency, curriculum expectations and available time.",
  },
];

const principles = [
  "Practice focused",
  "Research informed",
  "Clear and accessible",
  "Adaptable to context",
  "Chinese and English support",
  "Regular review and revision",
];
---

<BaseLayout
  title="Resource Centre"
  description="Explore iBridge Education resources for curriculum design, teaching, assessment, academic writing, student learning and artificial intelligence in education."
  locale="en"
  zhPath="/resources"
  enPath="/en/resources"
  pageType="CollectionPage"
  breadcrumbs={[
    {
      name: "Home",
      path: "/en/",
    },
    {
      name: "Resource Centre",
      path: "/en/resources",
    },
  ]}
>
  <section class="page-hero">
    <div class="hero-decoration" aria-hidden="true">
      <span class="hero-circle hero-circle-one"></span>
      <span class="hero-circle hero-circle-two"></span>
      <span class="hero-line"></span>
    </div>

    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Resource Centre</p>

        <h1>
          Translating research, curriculum and experience
          <span>into practical educational resources.</span>
        </h1>
      </div>

      <div class="hero-copy">
        <p>
          The iBridge Education Resource Centre provides materials
          for curriculum planning, teaching, assessment,
          academic writing and student learning.
        </p>

        <p>
          Resources will be released progressively in English and Traditional Chinese
          and updated through research and educator feedback.
        </p>

        <a class="hero-button" href="#resource-library">
          Browse resources
        </a>
      </div>
    </div>
  </section>

  <section class="introduction-section">
    <div class="container introduction-grid">
      <div>
        <p class="section-label">Our resource approach</p>

        <h2>
          More than downloadable files:
          tools that support authentic practice.
        </h2>
      </div>

      <div class="introduction-copy">
        <p>
          An educational resource can improve learning only when educators
          understand, adapt and use it effectively.
        </p>

        <p>
          Each resource will therefore aim to include its purpose,
          intended users, recommended process and possible adaptations,
          rather than providing an isolated worksheet or template.
        </p>
      </div>
    </div>
  </section>

  <section
    id="resource-library"
    class="categories-section"
  >
    <div class="container">
      <div class="section-heading">
        <p class="section-label">Resource categories</p>

        <h2>
          Six core areas of educational resources.
        </h2>
      </div>

      <div class="category-grid">
        {
          resourceCategories.map((category) => (
            <article class="category-card">
              <div class="category-header">
                <span class="category-number">
                  {category.number}
                </span>

                <h3>{category.title}</h3>
              </div>

              <p class="category-description">
                {category.description}
              </p>

              <ul>
                {
                  category.resources.map((resource) => (
                    <li>{resource}</li>
                  ))
                }
              </ul>

              <div class="category-footer">
                <span class="status-badge">
                  {category.status}
                </span>

                <a href="#coming-soon">
                  View resources
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="featured-section">
    <div class="container">
      <div class="featured-heading">
        <div>
          <p class="section-label">Featured resources</p>

          <h2>
            Practical tools currently in preparation.
          </h2>
        </div>

        <p>
          These resources will be released progressively.
          Once published, each button will link to a download or online reading page.
        </p>
      </div>

      <div class="featured-grid">
        {
          featuredResources.map((resource, index) => (
            <article class="resource-card">
              <div class="resource-top">
                <span class="resource-index">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <span class="resource-type">
                  {resource.type}
                </span>
              </div>

              <h3>{resource.title}</h3>

              <p>{resource.description}</p>

              <div class="resource-meta">
                <span>{resource.format}</span>
                <span>{resource.access}</span>
              </div>

              <a href={resource.href}>
                Coming soon
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="access-section">
    <div class="container access-grid">
      <div class="access-intro">
        <p class="section-label light-label">
          Using the resources
        </p>

        <h2>
          Find the resource,
          then adapt it to your educational context.
        </h2>

        <p>
          Resources are not fixed scripts. Educators should consider
          learner proficiency, language background, curriculum objectives
          and available time before implementation.
        </p>
      </div>

      <ol class="access-list">
        {
          accessSteps.map((step) => (
            <li>
              <span>{step.number}</span>

              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="principles-section">
    <div class="container principles-card">
      <div>
        <p class="section-label">Resource principles</p>

        <h2>
          A consistent standard across the resource library.
        </h2>

        <p>
          As the library expands, resources will retain clear classification,
          practical guidance, version control and bilingual support.
        </p>
      </div>

      <div class="principles-list">
        {
          principles.map((principle, index) => (
            <div>
              <span>
                {String(index + 1).padStart(2, "0")}
              </span>

              <strong>{principle}</strong>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="coming-soon"
    class="notice-section"
  >
    <div class="container notice-card">
      <div>
        <p class="eyebrow notice-eyebrow">
          Resource library in development
        </p>

        <h2>
          The first collection of free educational resources is being prepared.
        </h2>

        <p>
          Published resources will include clear categories,
          file descriptions, intended year levels,
          language versions and revision dates.
        </p>
      </div>

      <a href="/en/contact">
        Discuss resource collaboration
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .page-hero {
    position: relative;
    overflow: hidden;
    padding: 112px 0 104px;
    background:
      radial-gradient(
        circle at 88% 14%,
        rgba(196, 138, 44, 0.1),
        transparent 28%
      ),
      linear-gradient(
        125deg,
        #f7f1e3 0%,
        #faf7f0 100%
      );
  }

  .hero-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-circle {
    position: absolute;
    border: 1px solid rgba(165, 28, 48, 0.16);
    border-radius: 999px;
  }

  .hero-circle-one {
    width: 520px;
    height: 520px;
    top: -270px;
    right: -90px;
  }

  .hero-circle-two {
    width: 260px;
    height: 260px;
    right: 240px;
    bottom: -175px;
  }

  .hero-line {
    position: absolute;
    top: 58%;
    right: -120px;
    width: 700px;
    height: 1px;
    background: rgba(165, 28, 48, 0.16);
    transform: rotate(-16deg);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 90px;
    align-items: end;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 18px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    color: #1f2933;
    font-family:
      "Neue Helvetica",
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif;
    font-weight: 700;
    letter-spacing: -0.045em;
  }

  h1 {
    font-size: clamp(3.1rem, 6.2vw, 5.7rem);
    line-height: 0.99;
  }

  h1 span {
    display: block;
    margin-top: 14px;
    color: #a51c30;
  }

  .hero-copy {
    display: grid;
    gap: 20px;
  }

  .hero-copy p,
  .introduction-copy p,
  .featured-heading > p,
  .access-intro > p,
  .principles-card > div:first-child > p,
  .notice-card p {
    margin: 0;
    color: #52606d;
    font-size: 1.03rem;
    line-height: 1.85;
  }

  .hero-button {
    display: inline-flex;
    width: fit-content;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    padding: 0 24px;
    border-radius: 999px;
    background: #a51c30;
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
  }

  .hero-button:hover {
    background: #7b1422;
    color: #ffffff;
  }

  .introduction-section,
  .categories-section,
  .featured-section,
  .access-section,
  .principles-section {
    padding: 104px 0;
  }

  .introduction-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 90px;
  }

  .introduction-grid h2,
  .section-heading h2,
  .featured-heading h2,
  .access-intro h2,
  .principles-card h2,
  .notice-card h2 {
    font-size: clamp(2.35rem, 4vw, 4.1rem);
    line-height: 1.08;
  }

  .introduction-copy {
    display: grid;
    gap: 24px;
    padding-top: 34px;
  }

  .categories-section {
    background: #f7f1e3;
  }

  .section-heading {
    max-width: 930px;
    margin-bottom: 50px;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .category-card {
    padding: 34px;
    border: 1px solid #e4d7c5;
    border-radius: 22px;
    background: #faf7f0;
    box-shadow: 0 12px 36px rgba(31, 41, 51, 0.05);
  }

  .category-header {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: 18px;
  }

  .category-number {
    padding-top: 7px;
    color: #a51c30;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .category-card h3 {
    margin: 0;
    color: #1f2933;
    font-size: 1.65rem;
    line-height: 1.2;
  }

  .category-description {
    margin: 25px 0;
    color: #52606d;
    line-height: 1.78;
  }

  .category-card ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 18px;
    margin: 0;
    padding: 23px 0;
    border-top: 1px solid #e4d7c5;
    border-bottom: 1px solid #e4d7c5;
    list-style: none;
  }

  .category-card li {
    position: relative;
    padding-left: 16px;
    color: #52606d;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .category-card li::before {
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: #a51c30;
    content: "";
  }

  .category-footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: center;
    padding-top: 22px;
  }

  .status-badge {
    display: inline-flex;
    padding: 6px 11px;
    border: 1px solid rgba(196, 138, 44, 0.35);
    border-radius: 999px;
    background: rgba(196, 138, 44, 0.1);
    color: #805916;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .category-footer a {
    color: #315c6b;
    font-weight: 700;
    text-decoration: none;
  }

  .category-footer a:hover {
    color: #a51c30;
  }

  .featured-section {
    background: #faf7f0;
  }

  .featured-heading {
    display: grid;
    grid-template-columns: 1fr 0.75fr;
    gap: 70px;
    align-items: end;
    margin-bottom: 48px;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .resource-card {
    display: flex;
    min-height: 360px;
    flex-direction: column;
    padding: 30px;
    border: 1px solid #e4d7c5;
    border-radius: 20px;
    background: #f7f1e3;
  }

  .resource-top {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: center;
  }

  .resource-index {
    color: #a51c30;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .resource-type {
    color: #315c6b;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .resource-card h3 {
    margin: 46px 0 18px;
    color: #1f2933;
    font-size: 1.5rem;
    line-height: 1.25;
  }

  .resource-card > p {
    margin: 0;
    color: #52606d;
    line-height: 1.75;
  }

  .resource-meta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 28px;
  }

  .resource-meta span {
    display: inline-flex;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(49, 92, 107, 0.09);
    color: #315c6b;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .resource-card > a {
    display: inline-flex;
    width: fit-content;
    margin-top: 22px;
    color: #a51c30;
    font-weight: 700;
    text-decoration: none;
  }

  .access-section {
    background:
      linear-gradient(
        120deg,
        #7b1422 0%,
        #56101a 100%
      );
  }

  .access-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 86px;
  }

  .light-label {
    color: #f2c66d;
  }

  .access-intro h2 {
    color: #ffffff;
  }

  .access-intro > p {
    margin-top: 26px;
    color: rgba(255, 255, 255, 0.76);
  }

  .access-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .access-list li {
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 18px;
    padding: 23px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .access-list li:first-child {
    border-top: 0;
  }

  .access-list li > span {
    color: #f2c66d;
    font-size: 0.73rem;
    font-weight: 700;
  }

  .access-list h3 {
    margin: 0 0 8px;
    color: #ffffff;
    font-size: 1.12rem;
  }

  .access-list p {
    margin: 0;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.7;
  }

  .principles-section {
    background: #f7f1e3;
  }

  .principles-card {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 76px;
    padding: 62px;
    border: 1px solid #e4d7c5;
    border-radius: 28px;
    background: #faf7f0;
  }

  .principles-card > div:first-child > p {
    margin-top: 25px;
  }

  .principles-list {
    border-top: 1px solid #e4d7c5;
  }

  .principles-list > div {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 18px;
    padding: 21px 0;
    border-bottom: 1px solid #e4d7c5;
  }

  .principles-list span {
    color: #a51c30;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .principles-list strong {
    color: #1f2933;
  }

  .notice-section {
    padding: 20px 0 100px;
    background: #f7f1e3;
  }

  .notice-card {
    display: flex;
    justify-content: space-between;
    gap: 60px;
    align-items: center;
    padding: 58px 62px;
    border-radius: 26px;
    background:
      linear-gradient(
        115deg,
        #7b1422 0%,
        #a51c30 72%,
        #b72e42 100%
      );
  }

  .notice-card > div {
    max-width: 820px;
  }

  .notice-eyebrow {
    color: #f2c66d;
  }

  .notice-card h2 {
    color: #ffffff;
  }

  .notice-card p {
    margin-top: 22px;
    color: rgba(255, 255, 255, 0.82);
  }

  .notice-card > a {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    padding: 0 25px;
    border-radius: 999px;
    background: #ffffff;
    color: #7b1422;
    font-weight: 700;
    text-decoration: none;
  }

  .notice-card > a:hover {
    background: #c48a2c;
    color: #1f2933;
  }

  @media (max-width: 960px) {
    .hero-grid,
    .introduction-grid,
    .featured-heading,
    .access-grid,
    .principles-card {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .category-grid,
    .featured-grid {
      grid-template-columns: 1fr;
    }

    .notice-card {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 720px) {
    .container {
      width: min(100% - 30px, 1180px);
    }

    .page-hero {
      padding: 82px 0 74px;
    }

    h1 {
      font-size: clamp(2.7rem, 14vw, 4.2rem);
    }

    .introduction-section,
    .categories-section,
    .featured-section,
    .access-section,
    .principles-section {
      padding: 76px 0;
    }

    .category-card,
    .resource-card,
    .principles-card,
    .notice-card {
      padding: 32px 25px;
    }

    .category-card ul {
      grid-template-columns: 1fr;
    }

    .category-footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .notice-section {
      padding-bottom: 74px;
    }
  }
</style>