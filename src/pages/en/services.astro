---
import BaseLayout from "../../layouts/BaseLayout.astro";

const services = [
  {
    number: "01",
    title: "Curriculum and Learning Design",
    summary:
      "Helping schools and educators build coherent, challenging and learner-responsive curricula.",
    details: [
      "MYP and DP curriculum planning",
      "Unit and learning experience design",
      "Vertical curriculum alignment",
      "Learning and assessment alignment",
      "Interdisciplinary curriculum development",
      "Curriculum documentation review",
    ],
  },
  {
    number: "02",
    title: "Teacher Professional Development",
    summary:
      "Practical workshops, collaborative planning and sustained professional learning support.",
    details: [
      "Curriculum and pedagogy workshops",
      "Assessment and feedback design",
      "Inquiry-based learning",
      "Differentiated instruction",
      "Academic writing instruction",
      "Collaborative planning and consultancy",
    ],
  },
  {
    number: "03",
    title: "Artificial Intelligence in Education",
    summary:
      "Supporting purposeful, safe and effective integration of artificial intelligence into education.",
    details: [
      "Generative AI for teaching and learning",
      "Teacher AI literacy",
      "AI-supported curriculum planning",
      "Academic integrity and policy",
      "AI-assisted feedback and assessment",
      "School-based AI frameworks",
    ],
  },
  {
    number: "04",
    title: "Educational Research and Evaluation",
    summary:
      "Connecting research questions, evidence collection and educational needs through practical studies.",
    details: [
      "Research design and planning",
      "Survey and interview design",
      "Programme evaluation",
      "Student learning data analysis",
      "Research-to-practice translation",
      "Educational research reporting",
    ],
  },
  {
    number: "05",
    title: "Student Learning and Resilience",
    summary:
      "Programmes that develop self-regulation, metacognition, confidence and learner resilience.",
    details: [
      "Self-regulated learning",
      "Metacognition and reflection",
      "Positive psychology",
      "Stress and emotional regulation",
      "Study habits and time management",
      "Academic confidence and resilience",
    ],
  },
  {
    number: "06",
    title: "School and Curriculum Consultancy",
    summary:
      "Flexible and systematic consultancy aligned with each school’s stage of development.",
    details: [
      "Whole-curriculum review",
      "Educational programme planning",
      "International curriculum development",
      "Professional team development",
      "School improvement planning",
      "Long-term consultancy and follow-up",
    ],
  },
];

const processSteps = [
  {
    number: "01",
    title: "Clarify the need",
    description:
      "Understand the current context, strengths and primary challenges facing the school, educators, learners and curriculum.",
  },
  {
    number: "02",
    title: "Define scope and objectives",
    description:
      "Establish the purpose, priorities, scope of work and measurable outcomes of the partnership.",
  },
  {
    number: "03",
    title: "Design the programme",
    description:
      "Develop a contextualised curriculum, workshop, research or consultancy plan.",
  },
  {
    number: "04",
    title: "Implement and support",
    description:
      "Provide resources, professional guidance, collaborative planning and ongoing feedback.",
  },
  {
    number: "05",
    title: "Evaluate and refine",
    description:
      "Use evidence, observation and participant feedback to improve the work and its impact.",
  },
];

const partnershipTypes = [
  {
    title: "One-off workshop",
    description:
      "Suitable for focused professional learning in curriculum, pedagogy, assessment or artificial intelligence.",
  },
  {
    title: "Short-term project",
    description:
      "Suitable for unit design, curriculum review, teacher development or a defined educational initiative.",
  },
  {
    title: "Long-term consultancy",
    description:
      "Suitable for sustained curriculum development, professional support, research evaluation or school improvement.",
  },
];
---

<BaseLayout
  title="Professional Services"
  description="Explore iBridge Education services in curriculum design, professional learning, educational research, AI integration and school consultancy."
  locale="en"
  zhPath="/services"
  enPath="/en/services"
  pageType="CollectionPage"
  breadcrumbs={[
    {
      name: "Home",
      path: "/en/",
    },
    {
      name: "Professional Services",
      path: "/en/services",
    },
  ]}
>
  <section class="page-hero">
    <div class="hero-decoration" aria-hidden="true">
      <span class="shape shape-one"></span>
      <span class="shape shape-two"></span>
    </div>

    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Professional Services</p>

        <h1>
          From educational purpose
          <span>to practical and sustainable action.</span>
        </h1>
      </div>

      <div class="hero-copy">
        <p>
          iBridge Education works with schools, educational teams and teachers
          to translate curriculum goals, research and innovation into clear,
          practical and sustainable educational practice.
        </p>

        <p>
          Every service can be adapted to the organisation’s size,
          learner profile, professional experience and stage of development.
        </p>
      </div>
    </div>
  </section>

  <section class="services-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-label">Areas of service</p>

        <h2>Comprehensive support for curricula, educators, learners and schools.</h2>
      </div>

      <div class="services-grid">
        {
          services.map((service) => (
            <article class="service-card">
              <div class="service-header">
                <span>{service.number}</span>
                <h3>{service.title}</h3>
              </div>

              <p class="service-summary">{service.summary}</p>

              <ul>
                {
                  service.details.map((detail) => (
                    <li>{detail}</li>
                  ))
                }
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="approach-section">
    <div class="container approach-grid">
      <div class="approach-copy">
        <p class="section-label light-label">Our process</p>

        <h2>Every service begins with an understanding of the educational context.</h2>

        <p>
          We do not apply a fixed model. Each partnership is designed around
          school priorities, existing resources, learner needs and professional expertise.
        </p>

        <a href="/en/contact" class="light-button">
          Discuss your needs
        </a>
      </div>

      <ol class="process-list">
        {
          processSteps.map((step) => (
            <li>
              <span>{step.number}</span>

              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="partnership-section">
    <div class="container">
      <div class="partnership-heading">
        <div>
          <p class="section-label">Partnership formats</p>
          <h2>Choose a level of support appropriate to the need.</h2>
        </div>

        <p>
          A partnership may begin with a focused professional learning session
          or develop into a sustained curriculum, research or organisational project.
        </p>
      </div>

      <div class="partnership-grid">
        {
          partnershipTypes.map((type, index) => (
            <article class="partnership-card">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{type.title}</h3>
              <p>{type.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="audience-section">
    <div class="container audience-card">
      <div class="audience-copy">
        <p class="section-label">Who we work with</p>

        <h2>Supporting educational organisations and professional teams at different stages.</h2>
      </div>

      <div class="audience-list">
        <div>
          <span>01</span>
          <strong>International and bilingual schools</strong>
        </div>

        <div>
          <span>02</span>
          <strong>School leaders and curriculum teams</strong>
        </div>

        <div>
          <span>03</span>
          <strong>Teachers and subject departments</strong>
        </div>

        <div>
          <span>04</span>
          <strong>Educational and training organisations</strong>
        </div>

        <div>
          <span>05</span>
          <strong>Research teams and educational projects</strong>
        </div>

        <div>
          <span>06</span>
          <strong>Student learning and wellbeing teams</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-card">
      <div>
        <p class="eyebrow cta-eyebrow">Begin a partnership</p>

        <h2>Discuss the most appropriate service for your school or educational team.</h2>

        <p>
          Share your current need, objectives, intended participants and timeline,
          and we will help identify a suitable direction.
        </p>
      </div>

      <a href="/en/contact">Contact iBridge</a>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .page-hero {
    position: relative;
    overflow: hidden;
    padding: 112px 0 104px;
    background:
      linear-gradient(125deg, #f5faf9 0%, #e9f6f3 100%);
  }

  .hero-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .shape {
    position: absolute;
    display: block;
    border: 1px solid rgba(11, 102, 117, 0.17);
    border-radius: 999px;
  }

  .shape-one {
    width: 520px;
    height: 520px;
    top: -270px;
    right: -80px;
  }

  .shape-two {
    width: 250px;
    height: 250px;
    right: 250px;
    bottom: -165px;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.16fr 0.84fr;
    gap: 90px;
    align-items: end;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 18px;
    color: #0b6675;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    color: #0a355b;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  h1 {
    font-size: clamp(3.1rem, 6.3vw, 5.8rem);
    line-height: 0.99;
  }

  h1 span {
    display: block;
    margin-top: 14px;
    color: #0b6675;
  }

  .hero-copy {
    display: grid;
    gap: 22px;
    padding-bottom: 8px;
  }

  .hero-copy p,
  .approach-copy > p,
  .partnership-heading > p,
  .cta-card p {
    margin: 0;
    color: #587286;
    font-size: 1.03rem;
    line-height: 1.85;
  }

  .services-section,
  .approach-section,
  .partnership-section,
  .audience-section {
    padding: 104px 0;
  }

  .section-heading {
    max-width: 930px;
    margin-bottom: 50px;
  }

  .section-heading h2,
  .approach-copy h2,
  .partnership-heading h2,
  .audience-copy h2,
  .cta-card h2 {
    font-size: clamp(2.35rem, 4vw, 4.15rem);
    line-height: 1.08;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .service-card {
    padding: 34px;
    border: 1px solid rgba(10, 53, 91, 0.1);
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 18px 50px rgba(10, 53, 91, 0.05);
  }

  .service-header {
    display: grid;
    grid-template-columns: 46px 1fr;
    gap: 18px;
    align-items: start;
  }

  .service-header > span {
    padding-top: 6px;
    color: #0b6675;
    font-size: 0.74rem;
    font-weight: 800;
  }

  .service-header h3 {
    margin: 0;
    color: #123e60;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.72rem;
    line-height: 1.2;
  }

  .service-summary {
    margin: 24px 0;
    color: #5c7487;
    line-height: 1.75;
  }

  .service-card ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px 18px;
    margin: 0;
    padding: 22px 0 0;
    border-top: 1px solid rgba(10, 53, 91, 0.1);
    list-style: none;
  }

  .service-card li {
    position: relative;
    padding-left: 16px;
    color: #294d69;
    font-size: 0.93rem;
    line-height: 1.55;
  }

  .service-card li::before {
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: #0b6675;
    content: "";
  }

  .approach-section {
    background: #082f52;
  }

  .approach-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 86px;
    align-items: start;
  }

  .light-label {
    color: #78d1ca;
  }

  .approach-copy h2 {
    color: #ffffff;
  }

  .approach-copy > p {
    margin-top: 26px;
    color: #c1d0dc;
  }

  .light-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    margin-top: 34px;
    padding: 0 24px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
    transition:
      background 180ms ease,
      color 180ms ease;
  }

  .light-button:hover {
    background: #ffffff;
    color: #082f52;
  }

  .process-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-list li {
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 18px;
    padding: 23px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
  }

  .process-list li:first-child {
    border-top: 0;
  }

  .process-list li > span {
    color: #78d1ca;
    font-size: 0.73rem;
    font-weight: 800;
  }

  .process-list h3 {
    margin: 0 0 8px;
    color: #ffffff;
    font-size: 1.12rem;
  }

  .process-list p {
    margin: 0;
    color: #becdd9;
    line-height: 1.7;
  }

  .partnership-section {
    background: #f7fafb;
  }

  .partnership-heading {
    display: grid;
    grid-template-columns: 1fr 0.75fr;
    gap: 70px;
    align-items: end;
    margin-bottom: 48px;
  }

  .partnership-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .partnership-card {
    min-height: 240px;
    padding: 30px;
    border: 1px solid rgba(10, 53, 91, 0.1);
    border-radius: 20px;
    background: #ffffff;
  }

  .partnership-card > span {
    color: #0b6675;
    font-size: 0.74rem;
    font-weight: 800;
  }

  .partnership-card h3 {
    margin: 46px 0 16px;
    color: #123e60;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.5rem;
  }

  .partnership-card p {
    margin: 0;
    color: #60788b;
    line-height: 1.75;
  }

  .audience-section {
    padding-top: 28px;
  }

  .audience-card {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: 76px;
    padding: 62px;
    border-radius: 28px;
    background:
      linear-gradient(130deg, #edf8f6 0%, #f9fbfc 100%);
  }

  .audience-list {
    border-top: 1px solid rgba(10, 53, 91, 0.14);
  }

  .audience-list > div {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 18px;
    padding: 21px 0;
    border-bottom: 1px solid rgba(10, 53, 91, 0.14);
  }

  .audience-list span {
    color: #0b6675;
    font-size: 0.74rem;
    font-weight: 800;
  }

  .audience-list strong {
    color: #173f60;
  }

  .cta-section {
    padding: 20px 0 100px;
  }

  .cta-card {
    display: flex;
    justify-content: space-between;
    gap: 60px;
    align-items: center;
    padding: 58px 62px;
    border-radius: 26px;
    background:
      linear-gradient(115deg, #0a355b 0%, #0b6675 68%, #18828d 100%);
  }

  .cta-card > div {
    max-width: 810px;
  }

  .cta-eyebrow {
    color: #a8e4df;
  }

  .cta-card h2 {
    color: #ffffff;
  }

  .cta-card p {
    margin-top: 22px;
    color: #d3e2e7;
  }

  .cta-card > a {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 25px;
    border-radius: 999px;
    background: #ffffff;
    color: #0a355b;
    font-weight: 800;
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .hero-grid,
    .approach-grid,
    .partnership-heading,
    .audience-card {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .partnership-grid {
      grid-template-columns: 1fr;
    }

    .cta-card {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 720px) {
    .container {
      width: min(100% - 30px, 1180px);
    }

    .page-hero {
      padding: 82px 0 74px;
    }

    h1 {
      font-size: clamp(2.7rem, 14vw, 4.2rem);
    }

    .services-section,
    .approach-section,
    .partnership-section,
    .audience-section {
      padding: 76px 0;
    }

    .services-grid,
    .service-card ul {
      grid-template-columns: 1fr;
    }

    .service-card,
    .audience-card,
    .cta-card {
      padding: 32px 25px;
    }

    .cta-section {
      padding-bottom: 74px;
    }
  }
</style>
