---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Cta from "../../components/Cta.astro";
const services = [
  ["01","Curriculum and Learning Design","Build coherent, challenging and learner-responsive curriculum structures.",["MYP and DP curriculum planning","Unit and learning-experience design","Vertical curriculum alignment","Alignment of objectives and assessment","Interdisciplinary curriculum development","Curriculum and resource review"]],
  ["02","Professional Development","Practical workshops, collaborative planning and sustained professional-learning support.",["Curriculum and teaching workshops","Assessment and feedback design","Inquiry-based learning","Differentiation","Academic writing instruction","Collaborative planning and consultancy"]],
  ["03","Artificial Intelligence in Education","Use AI safely, effectively and purposefully in education.",["Generative AI for teaching","Educator AI literacy","AI-supported curriculum planning","Academic integrity and guidance","AI-assisted feedback and assessment","School-based AI frameworks"]],
  ["04","Educational Research and Programme Evaluation","Combine research questions, data collection and practical needs in executable studies.",["Research design and planning","Questionnaire and interview tools","Programme evaluation","Student-learning data analysis","Research-practice connections","Research reporting and recommendations"]],
  ["05","Student Learning and Resilience","Develop self-regulation, metacognition, confidence and psychological resilience.",["Self-regulated learning","Metacognition and reflection","Positive psychology","Stress and emotion regulation","Learning habits and time management","Academic confidence and resilience"]],
  ["06","School and Curriculum Consultancy","Flexible, systematic support shaped by the school’s development stage.",["Whole-curriculum review","Education programme planning","International curriculum development","Faculty professional growth","School improvement planning","Long-term consultancy and follow-up"]]
];
---
<BaseLayout title="Services" description="Explore iBridge Education services in curriculum design, professional learning, educational research, AI integration and school consultancy." locale="en" zhPath="/services/" enPath="/en/services/">
  <PageHero eyebrow="Professional services" title="Start with educational purpose" accent="and build programmes that can be implemented." copy="The scope can be adapted to organisational size, learner needs, educator experience and development stage." />
  <section class="section section-white"><div class="container"><div class="section-heading"><div><p class="eyebrow">Service areas</p><h2>Comprehensive support for curriculum, educators, learners and schools.</h2></div></div><div class="grid-2">{services.map(([n,t,s,items])=><article class="card"><span class="card-number">{n}</span><h3>{t}</h3><p>{s}</p><ul>{items.map((x)=><li>{x}</li>)}</ul></article>)}</div></div></section>
  <section class="section section-dark"><div class="container"><div class="section-heading"><div><p class="eyebrow eyebrow-light">Our process</p><h2>Every service begins with the real educational context.</h2></div></div><div class="grid-4">{[["01","Clarify needs","Understand the current situation, strengths and main challenges."],["02","Set goals and scope","Agree purpose, priorities, work scope and outcomes."],["03","Design the programme","Create curriculum, workshops, research or consultancy support."],["04","Implement, evaluate and adapt","Provide support and improve using data, observation and feedback."]].map(([n,t,d])=><article class="card dark-card"><span class="card-number">{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div></div></section>
  <section class="section section-ivory"><div class="container"><div class="section-heading"><div><p class="eyebrow">Delivery formats</p><h2>Choose the depth of partnership that fits the need.</h2></div></div><div class="grid-3">{[["01","Single workshop","Focused training on a particular teaching, curriculum, assessment or AI topic."],["02","Short-term project","Suitable for unit design, curriculum review, training or a specific education programme."],["03","Long-term consultancy","For sustained curriculum development, faculty support, evaluation or school improvement."]].map(([n,t,d])=><article class="card"><span class="card-number">{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div></div></section>
  <Cta eyebrow="Begin a partnership" title="Discuss the right service model for your school or education team." copy="Share your need, goals, participants and expected timeline so we can identify a suitable direction." label="Contact iBridge" href="/en/contact/" />
</BaseLayout>
