---
import BaseLayout from "../../layouts/BaseLayout.astro";

const lastUpdated = "26 July 2026";

const termsSections = [
  {
    number: "01",
    id: "acceptance",
    title: "Acceptance of these terms",
    paragraphs: [
      "Welcome to the iBridge Education website. By browsing, downloading or using this website and its content, you agree to comply with these terms of use.",
      "Do not use the website or its resources when you do not agree with these terms.",
      "These terms apply to visitors, educators, school personnel, researchers, educational organisations and other users.",
    ],
    items: [],
  },
  {
    number: "02",
    id: "website-purpose",
    title: "Purpose of the website",
    paragraphs: [
      "iBridge Education provides information relating to international education, curriculum design, professional learning, educational research, artificial intelligence in education and educational resources.",
      "Website content is primarily provided for education, professional development, research exchange and general information.",
      "Unless expressly stated in writing, website content does not constitute legal, medical, psychological, financial or other regulated professional advice.",
    ],
    items: [],
  },
  {
    number: "03",
    id: "educational-information",
    title: "Educational information and professional judgement",
    paragraphs: [
      "Curriculum, teaching, assessment, research and artificial-intelligence content may need to be adapted to school policy, student needs, age, language level and local requirements.",
      "Users must exercise appropriate professional judgement when determining whether content is suitable for a particular programme, student or educational context.",
      "iBridge Education does not guarantee that any individual resource, teaching approach or programme will produce a particular learning outcome.",
    ],
    items: [],
  },
  {
    number: "04",
    id: "permitted-use",
    title: "Permitted use",
    paragraphs: [
      "Unless an individual resource states otherwise, you may access website content for personal learning, non-commercial teaching, internal professional development and reasonable research use.",
      "Downloaded resources remain subject to any conditions displayed on the resource page, download page, licence notice or accompanying document.",
    ],
    items: [
      "Personal learning and lesson preparation",
      "Ordinary non-commercial classroom teaching",
      "Internal professional learning",
      "Reasonable educational research and citation",
      "Other uses allowed by an individual resource licence",
    ],
  },
  {
    number: "05",
    id: "restricted-use",
    title: "Prohibited use",
    paragraphs: [
      "Without express written permission, you must not use the website in a way that infringes rights, damages the website or improperly exploits its content.",
    ],
    items: [
      "Large-scale copying, republication, resale or commercialisation",
      "Removal of copyright, source, trademark or licence notices",
      "Impersonation of iBridge Education, a school, educator or another person",
      "Automated scraping, excessive downloading or interference with the website",
      "Uploading malware, spam or harmful content",
      "Attempting to bypass security, permissions or access controls",
      "Using content for unlawful, discriminatory, harmful or misleading purposes",
    ],
  },
  {
    number: "06",
    id: "intellectual-property",
    title: "Intellectual property",
    paragraphs: [
      "Unless otherwise stated, original text, design, graphics, layout, branding, logos, curriculum structures and other original website material belong to iBridge Education or the relevant rights holder.",
      "The website may contain third-party material, trademarks, quotations, links or licensed content. Such material remains the property of its respective owner.",
      "Access to the website does not transfer copyright, trademark rights or other intellectual-property rights to the user.",
    ],
    items: [],
  },
  {
    number: "07",
    id: "resources",
    title: "Teaching materials and downloads",
    paragraphs: [
      "Individual worksheets, PDFs, presentations, curriculum units and downloadable resources may include specific licences, limits, attribution requirements or restrictions.",
      "Where the conditions for an individual resource differ from these terms, the conditions displayed with that resource take priority.",
      "Unless separately licensed, free educational resources must not be repackaged, sold, placed behind a paid membership or incorporated into a commercial product.",
    ],
    items: [],
  },
  {
    number: "08",
    id: "user-submissions",
    title: "User submissions",
    paragraphs: [
      "When submitting a contact form or email, you confirm that the information is accurate, lawful and does not infringe another person's rights.",
      "Do not submit student names, identity records, health information, individual grades, special educational information or unnecessary sensitive information.",
      "You retain ownership of your original content, while granting us permission to use it as reasonably necessary to process the enquiry, reply and assess a possible partnership.",
    ],
    items: [],
  },
  {
    number: "09",
    id: "third-party-services",
    title: "Third-party services",
    paragraphs: [
      "The website may use or link to Cloudflare, Formspree, GitHub, Google, social platforms, educational platforms or other third-party services.",
      "Third-party services are operated independently and are governed by their own terms, privacy policies and technical limitations.",
      "iBridge Education does not control third-party websites and does not guarantee their content, availability, security or data practices.",
    ],
    items: [],
  },
  {
    number: "10",
    id: "external-links",
    title: "External links",
    paragraphs: [
      "External links are provided for reference or convenience and do not mean that iBridge Education endorses, controls or guarantees the linked content.",
      "Users are responsible for determining whether external websites, files, products and services are appropriate and safe.",
    ],
    items: [],
  },
  {
    number: "11",
    id: "availability",
    title: "Website availability and changes",
    paragraphs: [
      "We take reasonable steps to maintain the website, but we do not guarantee uninterrupted, error-free or permanent availability.",
      "We may modify, update, limit, move or remove website content, functions and resources at any time.",
      "Content may become temporarily unavailable because of maintenance, technical issues, licensing changes, security events or third-party service interruptions.",
    ],
    items: [],
  },
  {
    number: "12",
    id: "accuracy",
    title: "Accuracy of information",
    paragraphs: [
      "We take reasonable care when preparing website information, but educational requirements, technical tools, service conditions and external resources may change over time.",
      "Before relying on important information, users should verify the publication date, applicable jurisdiction, school policy and relevant official sources.",
      "Errors may be reported through the contact page.",
    ],
    items: [],
  },
  {
    number: "13",
    id: "disclaimer",
    title: "Disclaimer",
    paragraphs: [
      "The website and its content are provided on an as-available basis. To the maximum extent permitted by law, we do not guarantee that the website will be entirely error-free, uninterrupted or suitable for every particular purpose.",
      "Users assume responsibility for decisions made when applying website content, downloading resources or adopting educational suggestions.",
    ],
    items: [],
  },
  {
    number: "14",
    id: "liability",
    title: "Limitation of liability",
    paragraphs: [
      "To the extent permitted by applicable law, iBridge Education is not responsible for indirect, incidental or consequential loss resulting from use of, inability to use, or reliance on the website, third-party services or downloaded resources.",
      "Nothing in these terms excludes or limits liability that cannot legally be excluded or limited.",
    ],
    items: [],
  },
  {
    number: "15",
    id: "privacy",
    title: "Privacy and data protection",
    paragraphs: [
      "Our handling of website and contact-form information is explained in the privacy policy.",
      "Read the privacy policy together with these terms before using the website.",
    ],
    items: [],
  },
  {
    number: "16",
    id: "termination",
    title: "Restriction or termination of access",
    paragraphs: [
      "We may restrict or terminate access when a user breaches these terms, infringes rights, threatens website security or misuses resources.",
      "Restriction or termination does not prevent us from taking any other action available under applicable law.",
    ],
    items: [],
  },
  {
    number: "17",
    id: "changes",
    title: "Changes to these terms",
    paragraphs: [
      "We may update these terms when website functions, services, legal requirements or operating practices change.",
      "The updated version will be published on this page with a revised date.",
      "Continued use of the website after an update constitutes acceptance of the revised terms.",
    ],
    items: [],
  },
  {
    number: "18",
    id: "governing-principles",
    title: "Governing principles",
    paragraphs: [
      "These terms are interpreted according to the legal principles applicable to the location of the website operator and the relevant service.",
      "If any part of these terms is found invalid or unenforceable, the remaining provisions continue to apply.",
      "Where a dispute arises, the parties should first attempt to resolve it through reasonable, direct and good-faith communication.",
    ],
    items: [],
  },
];

const quickLinks = [
  {
    href: "#acceptance",
    label: "Acceptance",
  },
  {
    href: "#permitted-use",
    label: "Permitted use",
  },
  {
    href: "#restricted-use",
    label: "Prohibited use",
  },
  {
    href: "#intellectual-property",
    label: "Intellectual property",
  },
  {
    href: "#resources",
    label: "Resources and downloads",
  },
  {
    href: "#disclaimer",
    label: "Disclaimer",
  },
];
---

<BaseLayout
  title="Terms of Use"
  description="Read the terms governing use of the iBridge Education website, educational content, downloadable resources, contact forms and third-party services."
  locale="en"
>
  <section class="page-hero">
    <div class="hero-decoration" aria-hidden="true">
      <span class="hero-circle hero-circle-one"></span>
      <span class="hero-circle hero-circle-two"></span>
      <span class="hero-line"></span>
    </div>

    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Terms of Use</p>

        <h1>
          Before using the website, content and resources,
          <span>review the applicable conditions.</span>
        </h1>
      </div>

      <div class="hero-copy">
        <p>
          These terms explain how you may use the iBridge Education website,
          educational content, downloads, contact functions and external links.
        </p>

        <div class="updated-card">
          <span>Last updated</span>
          <strong>{lastUpdated}</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="summary-section">
    <div class="container summary-grid">
      <div>
        <p class="section-label">Terms summary</p>

        <h2>
          Educational content may be used reasonably under its licence, but not resold or republished without permission.
        </h2>
      </div>

      <div class="summary-card">
        <p>
          The website primarily provides educational information,
          professional exchange and general non-commercial resources.
          Individual downloads may include additional licence conditions.
        </p>

        <p>
          Users must respect intellectual property, privacy, security rules
          and the terms of relevant third-party services.
        </p>
      </div>
    </div>
  </section>

  <section class="terms-section">
    <div class="container terms-layout">
      <aside class="terms-sidebar">
        <div class="navigation-card">
          <p class="navigation-title">Quick navigation</p>

          <nav aria-label="Terms of use sections">
            <ul>
              {
                quickLinks.map((link) => (
                  <li>
                    <a href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        <div class="related-card">
          <p>Related policy</p>

          <a href="/en/privacy/">
            Privacy Policy
          </a>
        </div>
      </aside>

      <div class="terms-content">
        {
          termsSections.map((section) => (
            <article
              id={section.id}
              class="terms-item"
            >
              <div class="terms-number">
                {section.number}
              </div>

              <div class="terms-text">
                <h2>{section.title}</h2>

                {
                  section.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))
                }

                {
                  section.items.length > 0 && (
                    <ul>
                      {
                        section.items.map((item) => (
                          <li>{item}</li>
                        ))
                      }
                    </ul>
                  )
                }
              </div>
            </article>
          ))
        }

        <article
          id="contact-information"
          class="terms-item"
        >
          <div class="terms-number">
            19
          </div>

          <div class="terms-text">
            <h2>Contact information</h2>

            <p>
              For questions about these terms, resource licensing
              or permitted website use, contact:
            </p>

            <dl class="contact-details">
              <div>
                <dt>Organisation</dt>
                <dd>iBridge Education</dd>
              </div>

              <div>
                <dt>Email</dt>
                <dd>
                  <a href="mailto:hello@ibridge.info">
                    hello@ibridge.info
                  </a>
                </dd>
              </div>

              <div>
                <dt>Website</dt>
                <dd>
                  <a href="https://ibridge.info">
                    ibridge.info
                  </a>
                </dd>
              </div>
            </dl>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="notice-section">
    <div class="container notice-card">
      <div>
        <p class="section-label light-label">
          Resource reminder
        </p>

        <h2>
          Check the licence and conditions attached to each resource before downloading or sharing it.
        </h2>

        <p>
          Contact iBridge Education before school-wide licensing,
          publishing partnerships, commercial use or large-scale deployment.
        </p>
      </div>

      <a href="/en/contact/">
        Contact us
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .page-hero {
    position: relative;
    overflow: hidden;
    padding: 112px 0 104px;
    background:
      radial-gradient(
        circle at 88% 14%,
        rgba(196, 138, 44, 0.12),
        transparent 28%
      ),
      linear-gradient(
        125deg,
        #f7f1e3 0%,
        #faf7f0 100%
      );
  }

  .hero-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-circle {
    position: absolute;
    border: 1px solid rgba(165, 28, 48, 0.16);
    border-radius: 999px;
  }

  .hero-circle-one {
    top: -270px;
    right: -90px;
    width: 520px;
    height: 520px;
  }

  .hero-circle-two {
    right: 240px;
    bottom: -175px;
    width: 260px;
    height: 260px;
  }

  .hero-line {
    position: absolute;
    top: 58%;
    right: -120px;
    width: 700px;
    height: 1px;
    background: rgba(165, 28, 48, 0.16);
    transform: rotate(-16deg);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 90px;
    align-items: end;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 18px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    color: #1f2933;
    font-family:
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif;
    font-weight: 700;
    letter-spacing: -0.045em;
  }

  h1 {
    font-size: clamp(3.1rem, 6.2vw, 5.7rem);
    line-height: 0.99;
  }

  h1 span {
    display: block;
    margin-top: 14px;
    color: #a51c30;
  }

  .hero-copy {
    display: grid;
    gap: 28px;
  }

  .hero-copy > p,
  .summary-card p,
  .terms-text p,
  .notice-card p {
    margin: 0;
    color: #52606d;
    font-size: 1.03rem;
    line-height: 1.85;
  }

  .updated-card {
    display: grid;
    gap: 5px;
    width: fit-content;
    padding: 18px 22px;
    border: 1px solid #e4d7c5;
    border-radius: 14px;
    background: #faf7f0;
  }

  .updated-card span {
    color: #315c6b;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .updated-card strong {
    color: #1f2933;
  }

  .summary-section,
  .terms-section {
    padding: 104px 0;
  }

  .summary-section {
    background: #faf7f0;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 80px;
    align-items: start;
  }

  .summary-grid h2,
  .notice-card h2 {
    font-size: clamp(2.35rem, 4vw, 4.1rem);
    line-height: 1.08;
  }

  .summary-card {
    display: grid;
    gap: 22px;
    padding: 36px;
    border: 1px solid #e4d7c5;
    border-radius: 22px;
    background: #f7f1e3;
  }

  .terms-section {
    background: #f7f1e3;
  }

  .terms-layout {
    display: grid;
    grid-template-columns: 270px 1fr;
    gap: 72px;
    align-items: start;
  }

  .terms-sidebar {
    position: sticky;
    top: 116px;
    display: grid;
    gap: 18px;
  }

  .navigation-card,
  .related-card {
    border: 1px solid #e4d7c5;
    border-radius: 18px;
    background: #faf7f0;
  }

  .navigation-card {
    padding: 26px;
  }

  .navigation-title,
  .related-card p {
    margin: 0 0 16px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .navigation-card ul {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .navigation-card a {
    display: block;
    padding: 9px 0;
    color: #315c6b;
    font-size: 0.94rem;
    font-weight: 700;
    text-decoration: none;
  }

  .navigation-card a:hover {
    color: #a51c30;
  }

  .related-card {
    padding: 24px;
  }

  .related-card a {
    color: #315c6b;
    font-weight: 700;
    text-decoration: none;
  }

  .related-card a:hover {
    color: #a51c30;
  }

  .terms-content {
    border-top: 1px solid #e4d7c5;
  }

  .terms-item {
    display: grid;
    grid-template-columns: 62px 1fr;
    gap: 26px;
    padding: 48px 0;
    border-bottom: 1px solid #e4d7c5;
    scroll-margin-top: 112px;
  }

  .terms-number {
    padding-top: 8px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .terms-text h2 {
    margin-bottom: 23px;
    font-size: clamp(1.65rem, 3vw, 2.45rem);
    line-height: 1.15;
  }

  .terms-text p + p {
    margin-top: 17px;
  }

  .terms-text ul {
    display: grid;
    gap: 11px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .terms-text li {
    position: relative;
    padding-left: 20px;
    color: #52606d;
    line-height: 1.7;
  }

  .terms-text li::before {
    position: absolute;
    top: 0.68em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #c48a2c;
    content: "";
  }

  .contact-details {
    margin: 28px 0 0;
    border-top: 1px solid #e4d7c5;
  }

  .contact-details > div {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 20px;
    padding: 17px 0;
    border-bottom: 1px solid #e4d7c5;
  }

  .contact-details dt {
    color: #a51c30;
    font-weight: 700;
  }

  .contact-details dd {
    margin: 0;
    color: #1f2933;
  }

  .contact-details a {
    color: #315c6b;
    font-weight: 700;
  }

  .notice-section {
    padding: 20px 0 100px;
    background: #f7f1e3;
  }

  .notice-card {
    display: flex;
    justify-content: space-between;
    gap: 60px;
    align-items: center;
    padding: 58px 62px;
    border-radius: 26px;
    background:
      linear-gradient(
        115deg,
        #7b1422 0%,
        #a51c30 72%,
        #b72e42 100%
      );
  }

  .notice-card > div {
    max-width: 820px;
  }

  .light-label {
    color: #f2c66d;
  }

  .notice-card h2 {
    color: #ffffff;
  }

  .notice-card p {
    margin-top: 22px;
    color: rgba(255, 255, 255, 0.82);
  }

  .notice-card > a {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    padding: 0 25px;
    border-radius: 999px;
    background: #ffffff;
    color: #7b1422;
    font-weight: 700;
    text-decoration: none;
  }

  .notice-card > a:hover {
    background: #c48a2c;
    color: #1f2933;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .summary-grid,
    .terms-layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .terms-sidebar {
      position: static;
      grid-template-columns: 1fr 1fr;
    }

    .notice-card {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 720px) {
    .container {
      width: min(100% - 30px, 1180px);
    }

    .page-hero {
      padding: 82px 0 74px;
    }

    h1 {
      font-size: clamp(2.7rem, 14vw, 4.2rem);
    }

    .summary-section,
    .terms-section {
      padding: 76px 0;
    }

    .terms-sidebar {
      grid-template-columns: 1fr;
    }

    .summary-card,
    .navigation-card,
    .related-card {
      padding: 25px;
    }

    .terms-item {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 38px 0;
    }

    .contact-details > div {
      grid-template-columns: 1fr;
      gap: 7px;
    }

    .notice-card {
      padding: 38px 25px;
    }

    .notice-section {
      padding-bottom: 74px;
    }
  }
</style>