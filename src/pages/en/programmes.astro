---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Cta from "../../components/Cta.astro";
const programmes = [
  ["01","International Curriculum Design and Development","International Curriculum Design","Build coherent, challenging international curriculum structures with clear vertical alignment.",["International schools","Bilingual schools","Curriculum teams","Subject departments"],["Complete curriculum maps","Improved vertical alignment","Aligned objectives, teaching and assessment","Inquiry-based units"]],
  ["02","English and Academic Writing","English and Academic Writing","Build systematic progression from language foundations and text comprehension to organisation and academic argument.",["MYP learners","DP learners","English-language learners","Academic writing programmes"],["Stronger paragraph and essay structure","Argument and analysis","Text-type awareness","Sustainable feedback systems"]],
  ["03","Professional Learning Programmes","Professional Learning Programmes","Address practical problems through workshops, collaborative planning and continuing feedback.",["Teaching teams","Subject departments","Curriculum leaders","School leadership teams"],["Better curriculum and assessment design","Stronger collaborative planning","Research-informed methods","Professional-learning culture"]],
  ["04","Artificial Intelligence in Education","Artificial Intelligence in Education","Develop purposeful, transparent and responsible approaches to AI.",["School leaders","Teaching teams","Curriculum departments","Education organisations"],["Educator AI literacy","School-based AI principles","Improved resource workflows","Academic-integrity guidance"]],
  ["05","Learning and Resilience","Learning and Resilience","Integrate self-regulation, metacognition, positive psychology and stress regulation into learning.",["Middle-school learners","High-school learners","Advisory programmes","Student-support teams"],["Self-management and reflection","Stress regulation","Effective learning habits","Academic confidence and resilience"]],
  ["06","Research and Programme Evaluation","Research and Programme Evaluation","Create an end-to-end process for research design, data collection, evaluation and improvement.",["School research teams","Education organisations","Curriculum leaders","Research partners"],["Clear research questions","Appropriate tools","Credible outcome analysis","Actionable recommendations"]]
];
---
<BaseLayout title="Programmes" description="Explore bilingual education programmes supporting curriculum development, teacher learning, student skills and evidence-informed school improvement." locale="en" zhPath="/programmes/" enPath="/en/programmes/">
  <PageHero eyebrow="Programmes" title="From one-off support to long-term partnership," accent="build programmes around real needs." copy="Every programme prioritises clear goals, feasibility, continuing evaluation and long-term development." />
  <section class="section section-white"><div class="container split"><div><p class="eyebrow">Design principles</p><h2>Provide more than content: build a learning system that can continue.</h2></div><div class="prose"><p>Effective programmes respond to specific problems and include clear outcomes, suitable implementation, educator support, learning evidence and mechanisms for adaptation.</p><p>We therefore co-design around organisational context, participant needs and available resources rather than relying on fixed packages.</p></div></div></section>
  <section class="section section-ivory"><div class="container"><div class="section-heading"><div><p class="eyebrow">Core programmes</p><h2>Six connected directions for educational development.</h2></div></div><div class="grid-2">{programmes.map(([n,t,sub,d,aud,out])=><article class="card"><span class="card-number">{n}</span><p class="eyebrow">{sub}</p><h3>{t}</h3><p>{d}</p><div class="grid-2"><div><strong>Suitable for</strong><ul>{aud.map(x=><li>{x}</li>)}</ul></div><div><strong>Expected outcomes</strong><ul>{out.map(x=><li>{x}</li>)}</ul></div></div></article>)}</div></div></section>
  <section class="section section-dark"><div class="container"><div class="section-heading"><div><p class="eyebrow eyebrow-light">Depth of partnership</p><h2>Programmes adapt to goals, timelines and available resources.</h2></div></div><div class="grid-4">{[["01","Adapt to school goals","Clarify the problem and success criteria first."],["02","Differentiate for participants","Adjust language, content and support."],["03","Plan around time and resources","Create feasible phases and outputs."],["04","Improve through evidence","Use feedback and data to refine the programme."]].map(([n,t,d])=><article class="card dark-card"><span class="card-number">{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div></div></section>
  <Cta eyebrow="Plan the next step" title="Design the right partnership for your educational context." copy="Share the current need, participants, intended outcomes and timeframe so we can discuss an appropriate model." label="Contact iBridge" href="/en/contact/" />
</BaseLayout>
