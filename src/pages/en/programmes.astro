---
import BaseLayout from "../../layouts/BaseLayout.astro";

const programmes = [
  {
    number: "01",
    title: "International Curriculum Design",
    subtitle: "Curriculum Development",
    description:
      "Supporting schools in building coherent, challenging and vertically aligned international curricula, then translating curriculum aims into practical units, learning experiences and assessments.",
    audiences: [
      "International schools",
      "Bilingual schools",
      "Curriculum teams",
      "Subject departments",
    ],
    outcomes: [
      "Build a coherent curriculum map",
      "Improve vertical alignment between year levels",
      "Align objectives, learning and assessment",
      "Develop inquiry and concept-based units",
    ],
    formats: [
      "Curriculum review",
      "Collaborative planning",
      "Consultancy",
      "Teacher workshops",
    ],
  },
  {
    number: "02",
    title: "English and Academic Writing",
    subtitle: "Language and Writing",
    description:
      "Developing systematic programmes that move from language foundations and textual understanding to organisation, analysis and academic argument.",
    audiences: [
      "MYP learners",
      "DP learners",
      "English language learners",
      "Academic writing programmes",
    ],
    outcomes: [
      "Improve paragraph and essay structure",
      "Develop argument, evidence and analysis",
      "Strengthen text-type awareness",
      "Build sustainable feedback systems",
    ],
    formats: [
      "Full programme",
      "Unit design",
      "Teacher training",
      "Student workshops",
    ],
  },
  {
    number: "03",
    title: "Professional Learning Programmes",
    subtitle: "Teacher Development",
    description:
      "Practical professional learning built around authentic problems through workshops, collaborative planning, observation and sustained feedback.",
    audiences: [
      "Teacher teams",
      "Subject departments",
      "Curriculum leaders",
      "School leadership teams",
    ],
    outcomes: [
      "Strengthen curriculum and assessment design",
      "Improve collaborative planning",
      "Use research-informed teaching methods",
      "Develop a professional learning culture",
    ],
    formats: [
      "Single workshop",
      "Training series",
      "Collaborative planning",
      "Long-term consultancy",
    ],
  },
  {
    number: "04",
    title: "Artificial Intelligence in Education",
    subtitle: "AI Integration",
    description:
      "Helping schools and educators use artificial intelligence with purpose, transparency and professional responsibility across curriculum planning, teaching, feedback and professional workflows.",
    audiences: [
      "School leaders",
      "Teacher teams",
      "Curriculum departments",
      "Educational organisations",
    ],
    outcomes: [
      "Build teacher AI literacy",
      "Develop school-based AI principles",
      "Improve planning and resource workflows",
      "Address assessment and academic integrity",
    ],
    formats: [
      "AI workshops",
      "Policy design",
      "Practical training",
      "Consultancy",
    ],
  },
  {
    number: "05",
    title: "Student Learning and Resilience",
    subtitle: "Learner Development",
    description:
      "Integrating self-regulated learning, metacognition, positive psychology, stress regulation and study habits into programmes that support more independent and resilient learners.",
    audiences: [
      "Middle school learners",
      "Senior school learners",
      "Advisory programmes",
      "Student support teams",
    ],
    outcomes: [
      "Improve self-management and reflection",
      "Strengthen emotional and stress regulation",
      "Build effective learning habits",
      "Develop academic confidence and resilience",
    ],
    formats: [
      "Student programme",
      "Short workshop",
      "Advisory programme",
      "Teacher training",
    ],
  },
  {
    number: "06",
    title: "Educational Research and Evaluation",
    subtitle: "Evidence and Improvement",
    description:
      "Helping educational organisations develop clear research questions, evidence systems and evaluation frameworks to understand whether programmes improve learning, teaching or school development.",
    audiences: [
      "School research teams",
      "Curriculum leaders",
      "Educational projects",
      "Teacher researchers",
    ],
    outcomes: [
      "Build a research and evaluation framework",
      "Design surveys, interviews and observations",
      "Analyse learner and educator evidence",
      "Produce clear improvement recommendations",
    ],
    formats: [
      "Research design",
      "Programme evaluation",
      "Data analysis",
      "Research consultancy",
    ],
  },
];

const stages = [
  {
    number: "01",
    title: "Understand the context",
    description:
      "Clarify school priorities, learner needs, professional experience, existing curricula and organisational constraints.",
  },
  {
    number: "02",
    title: "Design collaboratively",
    description:
      "Define intended outcomes and create the curriculum, training, research or consultancy structure.",
  },
  {
    number: "03",
    title: "Implement the programme",
    description:
      "Provide resources, workshops, collaborative planning, instructional support and implementation tools.",
  },
  {
    number: "04",
    title: "Collect evidence",
    description:
      "Use learner work, feedback, observation, surveys or performance evidence to understand impact.",
  },
  {
    number: "05",
    title: "Refine and extend",
    description:
      "Use the evidence to improve the programme and establish a sustainable or scalable next stage.",
  },
];

const deliveryOptions = [
  {
    title: "Focused professional session",
    description:
      "A concentrated workshop, curriculum review or strategy session addressing a specific priority.",
    duration: "Half a day to two days",
  },
  {
    title: "Short-term development programme",
    description:
      "Suitable for unit design, professional learning, student programmes or defined research projects.",
    duration: "Four weeks to one semester",
  },
  {
    title: "Long-term partnership",
    description:
      "Suitable for sustained curriculum development, professional learning and school improvement.",
    duration: "One semester to multiple years",
  },
];
---

<BaseLayout
  title="Programmes"
  description="Explore bilingual education programmes supporting curriculum development, teacher learning, student skills and evidence-informed school improvement."
  locale="en"
  zhPath="/programmes"
  enPath="/en/programmes"
  pageType="CollectionPage"
  breadcrumbs={[
    {
      name: "Home",
      path: "/en/",
    },
    {
      name: "Programmes",
      path: "/en/programmes",
    },
  ]}
>
  <section class="page-hero">
    <div class="hero-background" aria-hidden="true">
      <span class="hero-ring hero-ring-one"></span>
      <span class="hero-ring hero-ring-two"></span>
      <span class="hero-rule"></span>
    </div>

    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Programmes</p>

        <h1>
          From focused support to sustained partnership,
          <span>programmes designed around authentic educational needs.</span>
        </h1>
      </div>

      <div class="hero-copy">
        <p>
          iBridge Education provides adaptable curriculum, professional learning,
          research and consultancy programmes for schools, educators and learners.
        </p>

        <p>
          Every programme is built around clear objectives, practical implementation,
          continued evaluation and long-term development.
        </p>

        <a class="hero-button" href="/en/contact">
          Discuss a programme
        </a>
      </div>
    </div>
  </section>

  <section class="overview-section">
    <div class="container overview-grid">
      <div>
        <p class="section-label">Programme design</p>

        <h2>
          More than content:
          sustainable systems for learning and development.
        </h2>
      </div>

      <div class="overview-copy">
        <p>
          An effective educational programme must address a defined problem.
          It needs clear outcomes, appropriate implementation, professional support,
          evidence of learning and a process for continued refinement.
        </p>

        <p>
          Our programmes are therefore not fixed packages. They are designed
          collaboratively around organisational context, participant needs
          and available resources.
        </p>
      </div>
    </div>
  </section>

  <section class="programmes-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-label">Core programmes</p>
        <h2>Six connected areas of educational development.</h2>
      </div>

      <div class="programme-list">
        {
          programmes.map((programme) => (
            <article class="programme-card">
              <div class="programme-top">
                <span class="programme-number">{programme.number}</span>

                <div>
                  <p class="programme-subtitle">{programme.subtitle}</p>
                  <h3>{programme.title}</h3>
                </div>
              </div>

              <p class="programme-description">
                {programme.description}
              </p>

              <div class="programme-details">
                <div>
                  <h4>Suitable for</h4>

                  <ul>
                    {
                      programme.audiences.map((audience) => (
                        <li>{audience}</li>
                      ))
                    }
                  </ul>
                </div>

                <div>
                  <h4>Expected outcomes</h4>

                  <ul>
                    {
                      programme.outcomes.map((outcome) => (
                        <li>{outcome}</li>
                      ))
                    }
                  </ul>
                </div>

                <div>
                  <h4>Delivery formats</h4>

                  <ul class="format-list">
                    {
                      programme.formats.map((format) => (
                        <li>{format}</li>
                      ))
                    }
                  </ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="process-section">
    <div class="container process-grid">
      <div class="process-intro">
        <p class="section-label light-label">Programme development process</p>

        <h2>From needs analysis to continued improvement.</h2>

        <p>
          Each programme includes planning, implementation, evidence collection
          and refinement so that the impact extends beyond one event or document.
        </p>
      </div>

      <ol class="stage-list">
        {
          stages.map((stage) => (
            <li>
              <span>{stage.number}</span>

              <div>
                <h3>{stage.title}</h3>
                <p>{stage.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="delivery-section">
    <div class="container">
      <div class="delivery-heading">
        <div>
          <p class="section-label">Duration and delivery</p>
          <h2>Select a scale of partnership appropriate to the objective.</h2>
        </div>

        <p>
          Programmes may be delivered in person, online or through a blended model,
          and adapted to school calendars, professional availability and learner needs.
        </p>
      </div>

      <div class="delivery-grid">
        {
          deliveryOptions.map((option, index) => (
            <article class="delivery-card">
              <span>{String(index + 1).padStart(2, "0")}</span>

              <h3>{option.title}</h3>

              <p>{option.description}</p>

              <div class="duration">
                <small>Indicative duration</small>
                <strong>{option.duration}</strong>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="custom-section">
    <div class="container custom-card">
      <div class="custom-copy">
        <p class="section-label">Custom partnerships</p>

        <h2>
          Existing programmes can be combined, adapted or redesigned.
        </h2>

        <p>
          A school may, for example, combine curriculum review, professional learning,
          AI policy, student resilience and programme evaluation within one sustained
          development plan.
        </p>
      </div>

      <div class="custom-features">
        <div>
          <span>01</span>
          <strong>Adapted to school priorities</strong>
        </div>

        <div>
          <span>02</span>
          <strong>Differentiated for participant experience</strong>
        </div>

        <div>
          <span>03</span>
          <strong>Planned around time and resources</strong>
        </div>

        <div>
          <span>04</span>
          <strong>Refined through evidence</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-card">
      <div>
        <p class="eyebrow cta-eyebrow">Plan the next stage</p>

        <h2>
          Build a programme appropriate to your educational context.
        </h2>

        <p>
          Share the current need, intended participants, expected outcomes
          and approximate timeframe to begin the discussion.
        </p>
      </div>

      <a href="/en/contact">Contact iBridge</a>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .page-hero {
    position: relative;
    overflow: hidden;
    padding: 112px 0 104px;
    background:
      linear-gradient(125deg, #f5faf9 0%, #e9f6f3 100%);
  }

  .hero-background {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-ring {
    position: absolute;
    display: block;
    border: 1px solid rgba(11, 102, 117, 0.17);
    border-radius: 999px;
  }

  .hero-ring-one {
    width: 540px;
    height: 540px;
    top: -300px;
    right: -110px;
  }

  .hero-ring-two {
    width: 260px;
    height: 260px;
    right: 260px;
    bottom: -175px;
  }

  .hero-rule {
    position: absolute;
    width: 720px;
    height: 1px;
    right: -120px;
    top: 58%;
    background: rgba(11, 102, 117, 0.16);
    transform: rotate(-16deg);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 90px;
    align-items: end;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 18px;
    color: #0b6675;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    color: #0a355b;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  h1 {
    font-size: clamp(3.1rem, 6.2vw, 5.7rem);
    line-height: 0.99;
  }

  h1 span {
    display: block;
    margin-top: 14px;
    color: #0b6675;
  }

  .hero-copy {
    display: grid;
    gap: 20px;
  }

  .hero-copy p,
  .overview-copy p,
  .process-intro > p,
  .delivery-heading > p,
  .custom-copy > p,
  .cta-card p {
    margin: 0;
    color: #587286;
    font-size: 1.03rem;
    line-height: 1.85;
  }

  .hero-button {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    margin-top: 10px;
    padding: 0 24px;
    border-radius: 999px;
    background: #0a4d70;
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
  }

  .overview-section,
  .programmes-section,
  .process-section,
  .delivery-section,
  .custom-section {
    padding: 104px 0;
  }

  .overview-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 90px;
  }

  .overview-grid h2,
  .section-heading h2,
  .process-intro h2,
  .delivery-heading h2,
  .custom-copy h2,
  .cta-card h2 {
    font-size: clamp(2.35rem, 4vw, 4.1rem);
    line-height: 1.08;
  }

  .overview-copy {
    display: grid;
    gap: 24px;
    padding-top: 34px;
  }

  .programmes-section {
    background: #f7fafb;
  }

  .section-heading {
    max-width: 950px;
    margin-bottom: 50px;
  }

  .programme-list {
    display: grid;
    gap: 22px;
  }

  .programme-card {
    padding: 38px;
    border: 1px solid rgba(10, 53, 91, 0.1);
    border-radius: 24px;
    background: #ffffff;
    box-shadow: 0 18px 48px rgba(10, 53, 91, 0.045);
  }

  .programme-top {
    display: grid;
    grid-template-columns: 58px 1fr;
    gap: 20px;
    align-items: start;
  }

  .programme-number {
    padding-top: 8px;
    color: #0b6675;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .programme-subtitle {
    margin: 0 0 7px;
    color: #6c8495;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .programme-card h3 {
    margin: 0;
    color: #123e60;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.65rem, 2.4vw, 2.25rem);
  }

  .programme-description {
    max-width: 960px;
    margin: 25px 0 30px 78px;
    color: #5d7588;
    line-height: 1.8;
  }

  .programme-details {
    display: grid;
    grid-template-columns: 0.9fr 1.2fr 0.9fr;
    gap: 34px;
    margin-left: 78px;
    padding-top: 28px;
    border-top: 1px solid rgba(10, 53, 91, 0.1);
  }

  .programme-details h4 {
    margin: 0 0 16px;
    color: #163f60;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .programme-details ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .programme-details li {
    position: relative;
    padding-left: 15px;
    color: #536e82;
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .programme-details li::before {
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: #0b6675;
    content: "";
  }

  .format-list li {
    display: inline-flex;
    width: fit-content;
    padding: 7px 12px;
    border-radius: 999px;
    background: #edf7f5;
    color: #0a5e6d;
  }

  .format-list li::before {
    display: none;
  }

  .process-section {
    background: #082f52;
  }

  .process-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 86px;
  }

  .light-label {
    color: #78d1ca;
  }

  .process-intro h2 {
    color: #ffffff;
  }

  .process-intro > p {
    margin-top: 26px;
    color: #c1d0dc;
  }

  .stage-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stage-list li {
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 18px;
    padding: 23px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
  }

  .stage-list li:first-child {
    border-top: 0;
  }

  .stage-list li > span {
    color: #78d1ca;
    font-size: 0.73rem;
    font-weight: 800;
  }

  .stage-list h3 {
    margin: 0 0 8px;
    color: #ffffff;
    font-size: 1.12rem;
  }

  .stage-list p {
    margin: 0;
    color: #becdd9;
    line-height: 1.7;
  }

  .delivery-section {
    background: #f7fafb;
  }

  .delivery-heading {
    display: grid;
    grid-template-columns: 1fr 0.75fr;
    gap: 70px;
    align-items: end;
    margin-bottom: 48px;
  }

  .delivery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .delivery-card {
    display: flex;
    min-height: 290px;
    flex-direction: column;
    padding: 30px;
    border: 1px solid rgba(10, 53, 91, 0.1);
    border-radius: 20px;
    background: #ffffff;
  }

  .delivery-card > span {
    color: #0b6675;
    font-size: 0.74rem;
    font-weight: 800;
  }

  .delivery-card h3 {
    margin: 46px 0 16px;
    color: #123e60;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.5rem;
  }

  .delivery-card > p {
    margin: 0;
    color: #60788b;
    line-height: 1.75;
  }

  .duration {
    display: grid;
    gap: 5px;
    margin-top: auto;
    padding-top: 28px;
  }

  .duration small {
    color: #718797;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .duration strong {
    color: #0a4d70;
  }

  .custom-section {
    padding-top: 30px;
  }

  .custom-card {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 76px;
    padding: 62px;
    border-radius: 28px;
    background:
      linear-gradient(130deg, #edf8f6 0%, #f9fbfc 100%);
  }

  .custom-copy > p {
    margin-top: 26px;
  }

  .custom-features {
    border-top: 1px solid rgba(10, 53, 91, 0.14);
  }

  .custom-features > div {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 18px;
    padding: 23px 0;
    border-bottom: 1px solid rgba(10, 53, 91, 0.14);
  }

  .custom-features span {
    color: #0b6675;
    font-size: 0.74rem;
    font-weight: 800;
  }

  .custom-features strong {
    color: #173f60;
  }

  .cta-section {
    padding: 20px 0 100px;
  }

  .cta-card {
    display: flex;
    justify-content: space-between;
    gap: 60px;
    align-items: center;
    padding: 58px 62px;
    border-radius: 26px;
    background:
      linear-gradient(115deg, #0a355b 0%, #0b6675 68%, #18828d 100%);
  }

  .cta-card > div {
    max-width: 810px;
  }

  .cta-eyebrow {
    color: #a8e4df;
  }

  .cta-card h2 {
    color: #ffffff;
  }

  .cta-card p {
    margin-top: 22px;
    color: #d3e2e7;
  }

  .cta-card > a {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 25px;
    border-radius: 999px;
    background: #ffffff;
    color: #0a355b;
    font-weight: 800;
    text-decoration: none;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .overview-grid,
    .process-grid,
    .delivery-heading,
    .custom-card {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .programme-details {
      grid-template-columns: 1fr 1fr;
    }

    .delivery-grid {
      grid-template-columns: 1fr;
    }

    .cta-card {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 720px) {
    .container {
      width: min(100% - 30px, 1180px);
    }

    .page-hero {
      padding: 82px 0 74px;
    }

    h1 {
      font-size: clamp(2.7rem, 14vw, 4.2rem);
    }

    .overview-section,
    .programmes-section,
    .process-section,
    .delivery-section,
    .custom-section {
      padding: 76px 0;
    }

    .programme-card {
      padding: 28px 24px;
    }

    .programme-description,
    .programme-details {
      margin-left: 0;
    }

    .programme-details {
      grid-template-columns: 1fr;
    }

    .custom-card,
    .cta-card {
      padding: 34px 26px;
    }

    .cta-section {
      padding-bottom: 74px;
    }
  }
</style>
