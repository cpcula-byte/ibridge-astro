---
import BaseLayout from "../../layouts/BaseLayout.astro";

const programmes = [
  {
    number: "01",
    category: "Student Programme",
    title: "IB Academic Writing and Thinking Programme",
    description:
      "Supports students in developing coherent progression from paragraph writing and argumentation to text analysis and interdisciplinary academic communication.",
    audience: "MYP and DP students",
    format: "Intensive course, semester programme or in-school provision",
    outcomes: [
      "Develop clear claims, evidence and reasoning",
      "Analyse text conventions and authorial choices",
      "Build academic vocabulary and formal register",
      "Strengthen revision, reflection and self-assessment",
      "Prepare for DP English, TOK and interdisciplinary writing",
    ],
  },
  {
    number: "02",
    category: "Student Programme",
    title: "Learning Resilience and Self-regulation Programme",
    description:
      "Combines positive psychology, applied neuroscience and learning strategies to help students develop more sustainable learning habits.",
    audience: "Middle school, high school and IB students",
    format: "Class programme, workshop or semester intervention",
    outcomes: [
      "Understand relationships between attention, stress and learning",
      "Develop time-management and goal-setting strategies",
      "Practise emotional regulation and stress management",
      "Strengthen metacognition and reflection",
      "Increase learning confidence and sustained engagement",
    ],
  },
  {
    number: "03",
    category: "Professional Learning",
    title: "IB Curriculum Design and Vertical Alignment Workshop",
    description:
      "Helps teachers and subject teams establish coherent curriculum structures that support progression from MYP to DP.",
    audience: "Teachers, subject leaders and curriculum coordinators",
    format: "Single workshop, workshop series or collaborative planning",
    outcomes: [
      "Create five-year curriculum maps",
      "Sequence knowledge, skills and concepts",
      "Improve central ideas and unit contexts",
      "Align formative and summative assessment",
      "Build shared language and curriculum coherence",
    ],
  },
  {
    number: "04",
    category: "Professional Learning",
    title: "AI Literacy and Authentic Assessment Workshop",
    description:
      "Helps educators understand the implications of generative AI and redesign tasks, feedback and academic-integrity practices.",
    audience: "Teachers, curriculum leaders and school leaders",
    format: "Workshop, policy consultation or semester project",
    outcomes: [
      "Understand the capabilities and limitations of generative AI",
      "Establish teacher and student AI-use principles",
      "Design authentic tasks that are harder to outsource",
      "Improve writing, research and reflection assessment",
      "Create responsible-use and academic-integrity frameworks",
    ],
  },
  {
    number: "05",
    category: "School Development",
    title: "Curriculum and Assessment Systems Development",
    description:
      "Builds a complete school system connecting curriculum maps, unit planning, assessment design and teacher implementation support.",
    audience: "International schools, bilingual schools and educational organisations",
    format: "Semester or multi-year partnership",
    outcomes: [
      "Complete curriculum frameworks and documentation",
      "Establish shared assessment and feedback standards",
      "Improve collaborative planning efficiency",
      "Strengthen vertical and interdisciplinary alignment",
      "Create sustainable monitoring and improvement systems",
    ],
  },
  {
    number: "06",
    category: "Research and Evaluation",
    title: "Educational Intervention and Programme Evaluation",
    description:
      "Supports schools in designing, implementing and evaluating the impact of curriculum, professional learning or student-support initiatives.",
    audience: "Schools, research teams and educational organisations",
    format: "Short evaluation, semester research or long-term partnership",
    outcomes: [
      "Define research questions and indicators of success",
      "Design surveys, interviews and data-collection tools",
      "Analyse quantitative and qualitative evidence",
      "Produce evaluation reports and recommendations",
      "Establish follow-up and continuous-improvement plans",
    ],
  },
];

const deliveryFormats = [
  {
    title: "In-person School Programme",
    description:
      "Suitable for intensive interaction, collaborative planning, classroom observation and student learning programmes.",
  },
  {
    title: "International Online Programme",
    description:
      "Delivered through video conferencing, digital resources and online collaboration for geographically distributed teams.",
  },
  {
    title: "Blended Programme",
    description:
      "Combines in-person launch sessions, online follow-up, document feedback and scheduled review.",
  },
  {
    title: "Custom Project",
    description:
      "Designed according to the school's goals, student profile, staff experience, timeline and available resources.",
  },
];

const designPrinciples = [
  {
    number: "01",
    title: "Needs-led",
    description:
      "Programmes respond to authentic educational challenges rather than applying a fixed course.",
  },
  {
    number: "02",
    title: "Clear Outcomes",
    description:
      "Every programme establishes understandable, observable and assessable goals.",
  },
  {
    number: "03",
    title: "Implementation-focused",
    description:
      "Resources, modelling, feedback and follow-up support help participants apply their learning.",
  },
  {
    number: "04",
    title: "Continuous Improvement",
    description:
      "Participant feedback and evidence are used to refine subsequent implementation.",
  },
];

const partnershipSteps = [
  {
    number: "01",
    title: "Initial Enquiry",
    description:
      "Describe the organisation, participants, main needs and preferred timeline.",
  },
  {
    number: "02",
    title: "Needs Consultation",
    description:
      "Clarify goals, existing resources, constraints and indicators of success.",
  },
  {
    number: "03",
    title: "Programme Proposal",
    description:
      "Receive a proposed structure, delivery format, timeline, outcomes and evaluation approach.",
  },
  {
    number: "04",
    title: "Implementation",
    description:
      "Begin the agreed programme, workshop, coaching, research or systems-development work.",
  },
];
---

<BaseLayout
  locale="en"
  title="Programmes"
  description="Explore iBridge Education programmes for student learning, professional development, school curriculum systems, AI education and programme evaluation."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">iBridge Programmes</span>

      <h1>Sustainable educational programmes for students, teachers and schools</h1>

      <p class="lead">
        iBridge Education combines curriculum design, learning science,
        professional development, artificial intelligence and educational
        research within practical programmes.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container programme-intro">
      <div>
        <span class="eyebrow">Programme Overview</span>

        <h2 class="section-title">
          Moving beyond isolated activities to build genuine progression
        </h2>
      </div>

      <div class="programme-copy">
        <p>
          Each programme begins with authentic participant needs and
          establishes clear outcomes, content, implementation processes
          and evaluation tools.
        </p>

        <p>
          Programmes can be delivered for students, teaching teams,
          curriculum leaders or whole schools and adapted according to
          subject, year level, timeline and stage of development.
        </p>

        <p>
          The focus is not simply on completing activities. It is on whether
          participants can translate learning into improved educational practice.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <span class="eyebrow">Core Programmes</span>

      <h2 class="section-title">
        Six core programmes and partnership options
      </h2>

      <div class="programme-list">
        {
          programmes.map((programme) => (
            <article class="programme-card">
              <div class="programme-main">
                <div class="programme-top">
                  <span class="programme-number">{programme.number}</span>

                  <span class="programme-category">
                    {programme.category}
                  </span>
                </div>

                <h3>{programme.title}</h3>

                <p>{programme.description}</p>

                <dl class="programme-meta">
                  <div>
                    <dt>Suitable For</dt>
                    <dd>{programme.audience}</dd>
                  </div>

                  <div>
                    <dt>Delivery Format</dt>
                    <dd>{programme.format}</dd>
                  </div>
                </dl>
              </div>

              <div class="programme-outcomes">
                <h4>Key Outcomes</h4>

                <ul>
                  {
                    programme.outcomes.map((outcome) => (
                      <li>
                        <span class="check-mark">✓</span>
                        <span>{outcome}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Delivery Formats</span>

      <h2 class="section-title">
        Flexible delivery models
      </h2>

      <p class="lead">
        Programmes may be delivered in person, online, through a blended
        structure or as a fully customised project.
      </p>

      <div class="grid-4 format-grid">
        {
          deliveryFormats.map((format) => (
            <article class="card format-card">
              <h3>{format.title}</h3>
              <p>{format.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-blue">
    <div class="container">
      <span class="eyebrow">Design Principles</span>

      <h2 class="section-title">
        Principles guiding every programme
      </h2>

      <div class="grid-4 principle-grid">
        {
          designPrinciples.map((principle) => (
            <article class="card principle-card">
              <div class="principle-number">{principle.number}</div>
              <h3>{principle.title}</h3>
              <p>{principle.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Partnership Process</span>

      <h2 class="section-title">
        From enquiry to implementation
      </h2>

      <div class="partnership-grid">
        {
          partnershipSteps.map((step) => (
            <article class="partnership-step">
              <span>{step.number}</span>

              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container programme-cta">
      <div>
        <span class="eyebrow">Custom Programme</span>

        <h2 class="section-title">
          Build a programme suited to your school's needs
        </h2>

        <p class="lead">
          Share the intended participants, main goals, preferred timeline
          and current challenge so that we can identify an appropriate model.
        </p>
      </div>

      <div class="programme-actions">
        <a class="button button-primary" href="/en/contact">
          Discuss a Programme
        </a>

        <a class="button button-secondary" href="/en/services">
          View All Services
        </a>
      </div>
    </div>
  </section>

  <style>
    .programme-intro {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 72px;
      align-items: start;
    }

    .programme-copy {
      color: var(--muted);
      font-size: 1.08rem;
    }

    .programme-copy p {
      margin-bottom: 22px;
    }

    .programme-list {
      margin-top: 48px;
      display: grid;
      gap: 24px;
    }

    .programme-card {
      padding: 34px;

      display: grid;
      grid-template-columns: 1.08fr 0.92fr;
      gap: 48px;

      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--radius-large);
      box-shadow: var(--shadow-small);

      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    .programme-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-medium);
    }

    .programme-top {
      margin-bottom: 20px;

      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .programme-number,
    .programme-category {
      display: inline-flex;
      padding: 7px 11px;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 850;
    }

    .programme-number {
      color: var(--teal);
      background: var(--teal-light);
    }

    .programme-category {
      color: var(--navy);
      background: var(--soft-blue);
    }

    .programme-main h3 {
      margin-bottom: 13px;
      color: var(--navy);
      font-size: 1.55rem;
    }

    .programme-main > p {
      color: var(--muted);
    }

    .programme-meta {
      margin: 25px 0 0;
      display: grid;
      gap: 12px;
    }

    .programme-meta div {
      padding: 14px 16px;
      background: var(--soft);
      border-radius: 14px;
    }

    .programme-meta dt {
      margin-bottom: 4px;
      color: var(--teal);
      font-size: 0.78rem;
      font-weight: 850;
    }

    .programme-meta dd {
      margin: 0;
      color: var(--navy);
      font-weight: 700;
    }

    .programme-outcomes {
      padding: 25px;
      background: var(--soft);
      border-radius: 20px;
    }

    .programme-outcomes h4 {
      margin-bottom: 18px;
      color: var(--navy);
      font-size: 1rem;
    }

    .programme-outcomes ul {
      margin: 0;
      padding: 0;
      display: grid;
      gap: 14px;
      list-style: none;
    }

    .programme-outcomes li {
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }

    .format-grid,
    .principle-grid {
      margin-top: 44px;
    }

    .format-card h3,
    .principle-card h3 {
      color: var(--navy);
    }

    .principle-number {
      margin-bottom: 18px;
      color: var(--teal);
      font-size: 0.84rem;
      font-weight: 850;
      letter-spacing: 0.1em;
    }

    .partnership-grid {
      margin-top: 44px;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .partnership-step {
      padding: 24px;

      display: grid;
      grid-template-columns: 48px 1fr;
      gap: 17px;

      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 18px;
      box-shadow: var(--shadow-small);
    }

    .partnership-step > span {
      color: var(--teal);
      font-weight: 850;
    }

    .partnership-step h3 {
      margin-bottom: 7px;
      color: var(--navy);
    }

    .partnership-step p {
      margin: 0;
      color: var(--muted);
    }

    .programme-cta {
      padding: 52px;

      display: grid;
      grid-template-columns: 1fr auto;
      gap: 48px;
      align-items: center;

      background:
        radial-gradient(
          circle at 90% 10%,
          rgba(15, 124, 130, 0.13),
          transparent 28%
        ),
        linear-gradient(145deg, #f8fbff, #edf7ff);

      border: 1px solid var(--line);
      border-radius: 30px;
      box-shadow: var(--shadow-medium);
    }

    .programme-actions {
      min-width: 210px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    @media (max-width: 980px) {
      .programme-intro,
      .programme-card,
      .programme-cta {
        grid-template-columns: 1fr;
        gap: 34px;
      }

      .programme-actions {
        flex-direction: row;
        flex-wrap: wrap;
      }
    }

    @media (max-width: 720px) {
      .partnership-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 680px) {
      .programme-card {
        padding: 24px;
      }

      .programme-cta {
        padding: 32px 24px;
      }

      .programme-actions {
        flex-direction: column;
      }
    }
  </style>
</BaseLayout>