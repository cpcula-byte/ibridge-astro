---
import BaseLayout from "../../layouts/BaseLayout.astro";

const lastUpdated = "26 July 2026";

const policySections = [
  {
    number: "01",
    id: "information-collected",
    title: "Information we collect",
    paragraphs: [
      "When you use the iBridge Education website, contact form or email, we may collect the basic information that you choose to provide.",
      "This may include your name, email address, school or organisation, professional role, partnership requirements, intended participants, proposed timeframe and other information included in your message.",
    ],
    items: [
      "Name and email address",
      "School, educational organisation or institutional information",
      "Professional role or position",
      "Curriculum, research, training or resource requirements",
      "Other information that you choose to provide",
    ],
  },
  {
    number: "02",
    id: "information-use",
    title: "How we use information",
    paragraphs: [
      "We use submitted information only for reasonable purposes connected with the website and our educational services.",
    ],
    items: [
      "Responding to contact forms and email enquiries",
      "Assessing curriculum, research, training or resource partnerships",
      "Arranging meetings and further communication",
      "Improving website content, resources and user experience",
      "Maintaining website security and preventing abuse or spam",
      "Complying with applicable legal or administrative requirements",
    ],
  },
  {
    number: "03",
    id: "formspree",
    title: "Contact forms and Formspree",
    paragraphs: [
      "iBridge Education uses Formspree to process website contact forms. When you submit a form, the information is transmitted through Formspree and may be stored within its services.",
      "Formspree is an independent third-party service provider. Its processing of information is also governed by its own privacy policy and terms of service.",
      "Do not use the contact form to send student names, identity numbers, health information, individual grades, special educational information, financial information or other unnecessary sensitive information.",
    ],
    items: [],
  },
  {
    number: "04",
    id: "technical-data",
    title: "Cookies and technical information",
    paragraphs: [
      "The website may use essential technical information, caching, server records and security functions to operate the website, improve performance and prevent malicious traffic.",
      "Technical information may include browser type, device type, request time, approximate region, referring page, IP address and server records.",
      "We do not currently use this information to create individual advertising profiles. If analytics, advertising or other non-essential cookies are introduced, this policy will be updated where appropriate.",
    ],
    items: [],
  },
  {
    number: "05",
    id: "cloudflare",
    title: "Cloudflare and website hosting",
    paragraphs: [
      "This website uses Cloudflare Pages, DNS, security and content-delivery services.",
      "Cloudflare may process network requests, security records and technical information as required to provide its services. Its processing is governed by its own policies and applicable terms.",
    ],
    items: [],
  },
  {
    number: "06",
    id: "sharing",
    title: "Sharing and disclosure",
    paragraphs: [
      "We do not sell personal information.",
      "Where necessary to operate the website and process enquiries, limited information may be handled by Formspree, Cloudflare, email providers or website-maintenance tools.",
      "We may also disclose necessary information when required by law, to protect website security, investigate abuse or protect legitimate rights.",
    ],
    items: [],
  },
  {
    number: "07",
    id: "retention",
    title: "Data retention",
    paragraphs: [
      "We retain information only for as long as reasonably necessary to respond to enquiries, maintain partnership records, meet administrative needs or comply with legal obligations.",
      "Information that is no longer required will be deleted, anonymised or removed from active use through reasonable procedures.",
      "Third-party services may apply their own retention periods according to their systems and policies.",
    ],
    items: [],
  },
  {
    number: "08",
    id: "security",
    title: "Data security",
    paragraphs: [
      "We use reasonable technical and administrative measures to protect the website and submitted information, including HTTPS, Cloudflare security services, account controls and appropriate access restrictions.",
      "No internet transmission or electronic storage method can guarantee absolute security. Do not submit unnecessary sensitive information through the website.",
    ],
    items: [],
  },
  {
    number: "09",
    id: "students",
    title: "Children and student information",
    paragraphs: [
      "This website is primarily intended for educators, schools, researchers and educational organisations. It is not designed for children to submit personal information independently.",
      "Minors should not submit personal information without appropriate guidance from a parent, guardian, teacher or school.",
      "Schools and educators should not provide information that identifies individual students in an initial enquiry.",
    ],
    items: [],
  },
  {
    number: "10",
    id: "rights",
    title: "Your information rights",
    paragraphs: [
      "Depending on the laws that apply in your location, you may have the right to request access to, correction of, restriction of or deletion of personal information that we hold.",
      "You may also ask for an explanation of how information is used or withdraw previously provided consent. Some information may need to be retained for legal, administrative or security reasons.",
    ],
    items: [],
  },
  {
    number: "11",
    id: "external-links",
    title: "External links",
    paragraphs: [
      "The website may contain links to third-party websites, educational platforms, download services or other external resources.",
      "External websites are operated independently and are responsible for their own privacy, security and content practices. Review their policies before using those services.",
    ],
    items: [],
  },
  {
    number: "12",
    id: "updates",
    title: "Changes to this policy",
    paragraphs: [
      "We may update this privacy policy when website functions, service providers, legal requirements or information practices change.",
      "The revised policy will be published on this page with an updated revision date.",
    ],
    items: [],
  },
];

const quickLinks = [
  {
    href: "#information-collected",
    label: "Information collected",
  },
  {
    href: "#information-use",
    label: "How information is used",
  },
  {
    href: "#formspree",
    label: "Formspree",
  },
  {
    href: "#technical-data",
    label: "Technical information",
  },
  {
    href: "#sharing",
    label: "Information sharing",
  },
  {
    href: "#rights",
    label: "Your rights",
  },
];
---

<BaseLayout
  title="Privacy Policy"
  description="Learn how iBridge Education collects, uses, retains and protects information provided by website visitors and contact-form users."
  locale="en"
>
  <section class="page-hero">
    <div class="hero-decoration" aria-hidden="true">
      <span class="hero-circle hero-circle-one"></span>
      <span class="hero-circle hero-circle-two"></span>
      <span class="hero-line"></span>
    </div>

    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Privacy Policy</p>

        <h1>
          A clear explanation of how we handle
          <span>website and contact-form information.</span>
        </h1>
      </div>

      <div class="hero-copy">
        <p>
          This policy explains what information iBridge Education collects,
          why it is used and how you may contact us regarding your information.
        </p>

        <div class="updated-card">
          <span>Last updated</span>
          <strong>{lastUpdated}</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="summary-section">
    <div class="container summary-grid">
      <div>
        <p class="section-label">Policy summary</p>

        <h2>
          We collect only the information needed to provide services and respond to enquiries.
        </h2>
      </div>

      <div class="summary-card">
        <p>
          iBridge Education does not sell personal information and does not ask
          visitors to submit student data, health information, grades or other
          sensitive material through the contact form.
        </p>

        <p>
          Contact forms are processed through Formspree. Website hosting,
          DNS, security and content-delivery services are provided through Cloudflare.
        </p>
      </div>
    </div>
  </section>

  <section class="policy-section">
    <div class="container policy-layout">
      <aside class="policy-sidebar">
        <div class="navigation-card">
          <p class="navigation-title">Quick navigation</p>

          <nav aria-label="Privacy policy sections">
            <ul>
              {
                quickLinks.map((link) => (
                  <li>
                    <a href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        <div class="contact-card">
          <p>Information enquiries</p>

          <a href="mailto:hello@ibridge.info">
            hello@ibridge.info
          </a>
        </div>
      </aside>

      <div class="policy-content">
        {
          policySections.map((section) => (
            <article
              id={section.id}
              class="policy-item"
            >
              <div class="policy-number">
                {section.number}
              </div>

              <div class="policy-text">
                <h2>{section.title}</h2>

                {
                  section.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))
                }

                {
                  section.items.length > 0 && (
                    <ul>
                      {
                        section.items.map((item) => (
                          <li>{item}</li>
                        ))
                      }
                    </ul>
                  )
                }
              </div>
            </article>
          ))
        }

        <article
          id="contact-information"
          class="policy-item"
        >
          <div class="policy-number">
            13
          </div>

          <div class="policy-text">
            <h2>Contact information</h2>

            <p>
              For questions about this privacy policy, our use of information
              or a personal-information request, contact:
            </p>

            <dl class="contact-details">
              <div>
                <dt>Organisation</dt>
                <dd>iBridge Education</dd>
              </div>

              <div>
                <dt>Email</dt>
                <dd>
                  <a href="mailto:hello@ibridge.info">
                    hello@ibridge.info
                  </a>
                </dd>
              </div>

              <div>
                <dt>Website</dt>
                <dd>
                  <a href="https://ibridge.info">
                    ibridge.info
                  </a>
                </dd>
              </div>
            </dl>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="notice-section">
    <div class="container notice-card">
      <div>
        <p class="section-label light-label">
          Important reminder
        </p>

        <h2>
          Do not send sensitive student or personal information through the website.
        </h2>

        <p>
          An initial partnership enquiry requires only general contact information
          and a description of the need. Where other information is required,
          an appropriate and secure method will first be agreed.
        </p>
      </div>

      <a href="/en/contact">
        Contact us
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .page-hero {
    position: relative;
    overflow: hidden;
    padding: 112px 0 104px;
    background:
      radial-gradient(
        circle at 88% 14%,
        rgba(196, 138, 44, 0.12),
        transparent 28%
      ),
      linear-gradient(
        125deg,
        #f7f1e3 0%,
        #faf7f0 100%
      );
  }

  .hero-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-circle {
    position: absolute;
    border: 1px solid rgba(165, 28, 48, 0.16);
    border-radius: 999px;
  }

  .hero-circle-one {
    top: -270px;
    right: -90px;
    width: 520px;
    height: 520px;
  }

  .hero-circle-two {
    right: 240px;
    bottom: -175px;
    width: 260px;
    height: 260px;
  }

  .hero-line {
    position: absolute;
    top: 58%;
    right: -120px;
    width: 700px;
    height: 1px;
    background: rgba(165, 28, 48, 0.16);
    transform: rotate(-16deg);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 90px;
    align-items: end;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 18px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    color: #1f2933;
    font-family:
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif;
    font-weight: 700;
    letter-spacing: -0.045em;
  }

  h1 {
    font-size: clamp(3.1rem, 6.2vw, 5.7rem);
    line-height: 0.99;
  }

  h1 span {
    display: block;
    margin-top: 14px;
    color: #a51c30;
  }

  .hero-copy {
    display: grid;
    gap: 28px;
  }

  .hero-copy > p,
  .summary-card p,
  .policy-text p,
  .notice-card p {
    margin: 0;
    color: #52606d;
    font-size: 1.03rem;
    line-height: 1.85;
  }

  .updated-card {
    display: grid;
    gap: 5px;
    width: fit-content;
    padding: 18px 22px;
    border: 1px solid #e4d7c5;
    border-radius: 14px;
    background: #faf7f0;
  }

  .updated-card span {
    color: #315c6b;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .updated-card strong {
    color: #1f2933;
  }

  .summary-section,
  .policy-section {
    padding: 104px 0;
  }

  .summary-section {
    background: #faf7f0;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 80px;
    align-items: start;
  }

  .summary-grid h2,
  .notice-card h2 {
    font-size: clamp(2.35rem, 4vw, 4.1rem);
    line-height: 1.08;
  }

  .summary-card {
    display: grid;
    gap: 22px;
    padding: 36px;
    border: 1px solid #e4d7c5;
    border-radius: 22px;
    background: #f7f1e3;
  }

  .policy-section {
    background: #f7f1e3;
  }

  .policy-layout {
    display: grid;
    grid-template-columns: 270px 1fr;
    gap: 72px;
    align-items: start;
  }

  .policy-sidebar {
    position: sticky;
    top: 116px;
    display: grid;
    gap: 18px;
  }

  .navigation-card,
  .contact-card {
    border: 1px solid #e4d7c5;
    border-radius: 18px;
    background: #faf7f0;
  }

  .navigation-card {
    padding: 26px;
  }

  .navigation-title,
  .contact-card p {
    margin: 0 0 16px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .navigation-card ul {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .navigation-card a {
    display: block;
    padding: 9px 0;
    color: #315c6b;
    font-size: 0.94rem;
    font-weight: 700;
    text-decoration: none;
  }

  .navigation-card a:hover {
    color: #a51c30;
  }

  .contact-card {
    padding: 24px;
  }

  .contact-card a {
    color: #315c6b;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .policy-content {
    border-top: 1px solid #e4d7c5;
  }

  .policy-item {
    display: grid;
    grid-template-columns: 62px 1fr;
    gap: 26px;
    padding: 48px 0;
    border-bottom: 1px solid #e4d7c5;
    scroll-margin-top: 112px;
  }

  .policy-number {
    padding-top: 8px;
    color: #a51c30;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .policy-text h2 {
    margin-bottom: 23px;
    font-size: clamp(1.65rem, 3vw, 2.45rem);
    line-height: 1.15;
  }

  .policy-text p + p {
    margin-top: 17px;
  }

  .policy-text ul {
    display: grid;
    gap: 11px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .policy-text li {
    position: relative;
    padding-left: 20px;
    color: #52606d;
    line-height: 1.7;
  }

  .policy-text li::before {
    position: absolute;
    top: 0.68em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #c48a2c;
    content: "";
  }

  .contact-details {
    margin: 28px 0 0;
    border-top: 1px solid #e4d7c5;
  }

  .contact-details > div {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 20px;
    padding: 17px 0;
    border-bottom: 1px solid #e4d7c5;
  }

  .contact-details dt {
    color: #a51c30;
    font-weight: 700;
  }

  .contact-details dd {
    margin: 0;
    color: #1f2933;
  }

  .contact-details a {
    color: #315c6b;
    font-weight: 700;
  }

  .notice-section {
    padding: 20px 0 100px;
    background: #f7f1e3;
  }

  .notice-card {
    display: flex;
    justify-content: space-between;
    gap: 60px;
    align-items: center;
    padding: 58px 62px;
    border-radius: 26px;
    background:
      linear-gradient(
        115deg,
        #7b1422 0%,
        #a51c30 72%,
        #a51c30 100%
      );
  }

  .notice-card > div {
    max-width: 820px;
  }

  .light-label {
    color: #f2c66d;
  }

  .notice-card h2 {
    color: #ffffff;
  }

  .notice-card p {
    margin-top: 22px;
    color: rgba(255, 255, 255, 0.82);
  }

  .notice-card > a {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    padding: 0 25px;
    border-radius: 999px;
    background: #ffffff;
    color: #7b1422;
    font-weight: 700;
    text-decoration: none;
  }

  .notice-card > a:hover {
    background: #c48a2c;
    color: #1f2933;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .summary-grid,
    .policy-layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .policy-sidebar {
      position: static;
      grid-template-columns: 1fr 1fr;
    }

    .notice-card {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 720px) {
    .container {
      width: min(100% - 30px, 1180px);
    }

    .page-hero {
      padding: 82px 0 74px;
    }

    h1 {
      font-size: clamp(2.7rem, 14vw, 4.2rem);
    }

    .summary-section,
    .policy-section {
      padding: 76px 0;
    }

    .policy-sidebar {
      grid-template-columns: 1fr;
    }

    .summary-card,
    .navigation-card,
    .contact-card {
      padding: 25px;
    }

    .policy-item {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 38px 0;
    }

    .contact-details > div {
      grid-template-columns: 1fr;
      gap: 7px;
    }

    .notice-card {
      padding: 38px 25px;
    }

    .notice-section {
      padding-bottom: 74px;
    }
  }
</style>