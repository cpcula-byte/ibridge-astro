---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Cta from "../components/Cta.astro";
const programmes = [
  ["01","國際課程設計與發展","International Curriculum Design","協助學校建立具連貫性、挑戰性與明確垂直銜接的國際課程架構。",["國際學校","雙語學校","課程統籌團隊","學科部門"],["完整課程地圖","改善垂直銜接","對齊目標、教學與評量","發展探究式單元"]],
  ["02","英語與學術寫作課程","English and Academic Writing","從語言基礎、文本理解、組織結構到學術論證，建立系統性課程。",["MYP 學生","DP 學生","英語學習者","學術寫作課程"],["改善段落與文章結構","發展論證與分析能力","強化文本類型理解","建立寫作回饋系統"]],
  ["03","教師專業學習方案","Professional Learning Programmes","以實務問題為核心，透過工作坊、共同備課與持續回饋支持教師。",["教師團隊","學科部門","課程領導者","學校行政團隊"],["提升課程與評量設計","改善共同規劃品質","建立研究支持的方法","發展專業學習文化"]],
  ["04","人工智慧教育應用方案","Artificial Intelligence in Education","建立具目的性、透明度與責任感的 AI 使用方式。",["學校領導","教師團隊","課程部門","教育機構"],["建立教師 AI 素養","發展校本 AI 原則","改善教材製作流程","處理學術誠信問題"]],
  ["05","學生學習與韌性方案","Learning and Resilience","將自我調節、後設認知、正向心理學與壓力調節融入課程。",["中學生","高中生","導師課程","學生支持團隊"],["提升自我管理與反思","改善壓力調節","建立有效學習習慣","發展學術信心與韌性"]],
  ["06","教育研究與方案評估","Research and Programme Evaluation","建立研究設計、資料蒐集、成效評估與後續改善的完整流程。",["學校研究團隊","教育機構","課程領導者","研究合作夥伴"],["清楚研究問題","適切資料工具","可信成效分析","可執行的改善建議"]]
];
---
<BaseLayout title="課程與方案" description="探索 iBridge Education 的雙語教育方案，支援課程發展、教師學習、學生能力與實證導向的學校改進。" locale="zh-Hant" zhPath="/programmes/" enPath="/en/programmes/">
  <PageHero eyebrow="課程與方案" title="從單次支持到長期合作，" accent="建立符合真實需求的教育方案。" copy="每一項方案都重視清楚目標、實際可行性、持續評估與長期發展。" />
  <section class="section section-white"><div class="container split"><div><p class="eyebrow">方案設計原則</p><h2>不只提供內容，更建立能夠持續運作的學習系統。</h2></div><div class="prose"><p>有效方案必須回應具體問題，具備明確學習成果、適合的實施方式、教師支持、學習證據與後續調整機制。</p><p>因此，我們不以固定套裝為核心，而是依據組織脈絡、參與者需求與可用資源共同設計。</p></div></div></section>
  <section class="section section-ivory"><div class="container"><div class="section-heading"><div><p class="eyebrow">主要方案</p><h2>六個相互連結的教育發展方向。</h2></div></div><div class="grid-2">{programmes.map(([n,t,sub,d,aud,out])=><article class="card"><span class="card-number">{n}</span><p class="eyebrow">{sub}</p><h3>{t}</h3><p>{d}</p><div class="grid-2"><div><strong>適合對象</strong><ul>{aud.map(x=><li>{x}</li>)}</ul></div><div><strong>預期成果</strong><ul>{out.map(x=><li>{x}</li>)}</ul></div></div></article>)}</div></div></section>
  <section class="section section-dark"><div class="container"><div class="section-heading"><div><p class="eyebrow eyebrow-light">合作深度</p><h2>方案可依目標、時程與資源進行調整。</h2></div></div><div class="grid-4">{[["01","依據學校目標調整","先確認問題與成功標準。"],["02","依據參與者能力分層","調整語言、內容與支持程度。"],["03","依據時程與資源規劃","建立可實施的階段與成果。"],["04","依據證據持續修正","使用回饋與資料進行改善。"]].map(([n,t,d])=><article class="card dark-card"><span class="card-number">{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div></div></section>
  <Cta eyebrow="規劃下一步" title="根據您的教育情境，設計最合適的合作方案。" copy="請提供目前需求、參與對象、預期成果與時間範圍，以便進一步討論。" label="聯絡 iBridge" href="/contact/" />
</BaseLayout>
