---
import BaseLayout from "../layouts/BaseLayout.astro";

const programmes = [
  {
    number: "01",
    title: "國際課程設計與發展",
    subtitle: "International Curriculum Design",
    description:
      "協助學校建立具連貫性、挑戰性與明確垂直銜接的國際課程架構，並將課程理念轉化為可實施的單元、學習活動與評量。",
    audiences: [
      "國際學校",
      "雙語學校",
      "課程統籌團隊",
      "學科部門",
    ],
    outcomes: [
      "建立完整課程地圖",
      "改善年級與學段之間的垂直銜接",
      "對齊學習目標、教學活動與評量",
      "發展探究式與概念導向單元",
    ],
    formats: [
      "課程檢視",
      "共同規劃",
      "顧問支持",
      "教師工作坊",
    ],
  },
  {
    number: "02",
    title: "英語與學術寫作課程",
    subtitle: "English and Academic Writing",
    description:
      "建立從語言基礎、文本理解、組織結構到學術論證的系統性課程，支援學生逐步發展英語溝通與學術寫作能力。",
    audiences: [
      "MYP 學生",
      "DP 學生",
      "英語學習者",
      "學術寫作課程",
    ],
    outcomes: [
      "改善段落與文章結構",
      "發展論證、證據與分析能力",
      "強化文本類型與語言慣例理解",
      "建立可持續的寫作回饋系統",
    ],
    formats: [
      "完整課程",
      "單元設計",
      "教師培訓",
      "學生工作坊",
    ],
  },
  {
    number: "03",
    title: "教師專業學習方案",
    subtitle: "Professional Learning Programmes",
    description:
      "以實務問題為核心，透過工作坊、共同備課、教學觀察與持續回饋，協助教師將新方法真正融入課程與教室。",
    audiences: [
      "教師團隊",
      "學科部門",
      "課程領導者",
      "學校行政團隊",
    ],
    outcomes: [
      "提升課程與評量設計能力",
      "改善教師共同規劃品質",
      "建立研究支持的教學方法",
      "發展持續專業學習文化",
    ],
    formats: [
      "單次工作坊",
      "系列培訓",
      "共同備課",
      "長期顧問",
    ],
  },
  {
    number: "04",
    title: "人工智慧教育應用方案",
    subtitle: "Artificial Intelligence in Education",
    description:
      "協助學校與教師建立具目的性、透明度與責任感的人工智慧使用方式，將 AI 融入課程規劃、教學、回饋與專業工作流程。",
    audiences: [
      "學校領導",
      "教師團隊",
      "課程部門",
      "教育機構",
    ],
    outcomes: [
      "建立教師 AI 素養",
      "發展校本 AI 使用原則",
      "改善課程規劃與教材製作流程",
      "處理學術誠信與評量問題",
    ],
    formats: [
      "AI 工作坊",
      "政策設計",
      "實務培訓",
      "顧問服務",
    ],
  },
  {
    number: "05",
    title: "學生學習與韌性方案",
    subtitle: "Learning and Resilience",
    description:
      "將自我調節學習、後設認知、正向心理學、壓力調節與學習習慣融入課程，協助學生建立更穩定且自主的學習能力。",
    audiences: [
      "中學生",
      "高中生",
      "導師課程",
      "學生支持團隊",
    ],
    outcomes: [
      "提升自我管理與反思能力",
      "改善壓力與情緒調節",
      "建立有效學習習慣",
      "發展學術信心與心理韌性",
    ],
    formats: [
      "學生課程",
      "短期工作坊",
      "導師方案",
      "教師培訓",
    ],
  },
  {
    number: "06",
    title: "教育研究與方案評估",
    subtitle: "Research and Programme Evaluation",
    description:
      "協助教育組織建立清楚研究問題、資料蒐集方式與評估架構，了解方案是否真正改善學生學習、教師實務或學校發展。",
    audiences: [
      "學校研究團隊",
      "課程領導者",
      "教育專案",
      "教師研究者",
    ],
    outcomes: [
      "建立研究與評估架構",
      "設計問卷、訪談與觀察工具",
      "分析學生與教師資料",
      "形成清楚且可行的改善建議",
    ],
    formats: [
      "研究設計",
      "方案評估",
      "資料分析",
      "研究顧問",
    ],
  },
];

const stages = [
  {
    number: "01",
    title: "理解情境",
    description:
      "釐清學校目標、學生需求、教師經驗、現有課程與組織限制。",
  },
  {
    number: "02",
    title: "共同設計",
    description:
      "設定明確成果，建立課程、培訓、研究或顧問合作架構。",
  },
  {
    number: "03",
    title: "實施方案",
    description:
      "提供教材、工作坊、共同規劃、教學支持與實施工具。",
  },
  {
    number: "04",
    title: "蒐集證據",
    description:
      "使用作品、回饋、觀察、問卷或學習資料了解實施成效。",
  },
  {
    number: "05",
    title: "調整與延伸",
    description:
      "根據證據改善方案，並建立可持續或可擴展的下一階段。",
  },
];

const deliveryOptions = [
  {
    title: "單次專業活動",
    description:
      "針對特定主題進行集中式工作坊、課程檢視或策略會議。",
    duration: "半天至兩天",
  },
  {
    title: "短期發展方案",
    description:
      "適合單元設計、教師培訓、學生課程或教育研究專案。",
    duration: "四週至一學期",
  },
  {
    title: "長期合作方案",
    description:
      "適合跨學期或跨學年的課程發展、教師學習與學校改進。",
    duration: "一學期至多學年",
  },
];
---

<BaseLayout
  title="課程與方案"
  description="探索 iBridge Education 的雙語教育方案，支援課程發展、教師學習、學生能力與實證導向的學校改進。"
  locale="zh-tw"
  zhPath="/programmes"
  enPath="/en/programmes"
  pageType="CollectionPage"
  breadcrumbs={[
    {
      name: "首頁",
      path: "/",
    },
    {
      name: "課程與方案",
      path: "/programmes",
    },
  ]}
>
  <section class="page-hero">
    <div class="hero-background" aria-hidden="true">
      <span class="hero-ring hero-ring-one"></span>
      <span class="hero-ring hero-ring-two"></span>
      <span class="hero-rule"></span>
    </div>

    <div class="container hero-grid">
      <div>
        <p class="eyebrow">課程與方案</p>

        <h1>
          從單次支持到長期合作，
          <span>建立符合真實需求的教育方案。</span>
        </h1>
      </div>

      <div class="hero-copy">
        <p>
          iBridge Education 提供可依學校、教師與學生需求調整的課程、
          專業學習、研究與顧問方案。
        </p>

        <p>
          每一項方案都重視清楚目標、實際可行性、持續評估與長期發展。
        </p>

        <a class="hero-button" href="/contact">
          討論方案需求
        </a>
      </div>
    </div>
  </section>

  <section class="overview-section">
    <div class="container overview-grid">
      <div>
        <p class="section-label">方案設計原則</p>

        <h2>
          不只提供內容，
          更建立能夠持續運作的學習系統。
        </h2>
      </div>

      <div class="overview-copy">
        <p>
          有效的教育方案必須回應具體問題。它需要明確的學習成果、
          適合的實施方式、教師支持、學習證據與後續調整機制。
        </p>

        <p>
          因此，我們的方案不以固定套裝為核心，而是依據組織脈絡、
          參與者需求與可用資源共同設計。
        </p>
      </div>
    </div>
  </section>

  <section class="programmes-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-label">主要方案</p>
        <h2>六個相互連結的教育發展方向。</h2>
      </div>

      <div class="programme-list">
        {
          programmes.map((programme) => (
            <article class="programme-card">
              <div class="programme-top">
                <span class="programme-number">{programme.number}</span>

                <div>
                  <p class="programme-subtitle">{programme.subtitle}</p>
                  <h3>{programme.title}</h3>
                </div>
              </div>

              <p class="programme-description">
                {programme.description}
              </p>

              <div class="programme-details">
                <div>
                  <h4>適合對象</h4>

                  <ul>
                    {
                      programme.audiences.map((audience) => (
                        <li>{audience}</li>
                      ))
                    }
                  </ul>
                </div>

                <div>
                  <h4>預期成果</h4>

                  <ul>
                    {
                      programme.outcomes.map((outcome) => (
                        <li>{outcome}</li>
                      ))
                    }
                  </ul>
                </div>

                <div>
                  <h4>合作形式</h4>

                  <ul class="format-list">
                    {
                      programme.formats.map((format) => (
                        <li>{format}</li>
                      ))
                    }
                  </ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="process-section">
    <div class="container process-grid">
      <div class="process-intro">
        <p class="section-label light-label">方案發展流程</p>

        <h2>從需求分析到持續改善。</h2>

        <p>
          每一項方案都包含規劃、實施、證據蒐集與調整，
          確保成果不只停留在一次活動或一份文件。
        </p>
      </div>

      <ol class="stage-list">
        {
          stages.map((stage) => (
            <li>
              <span>{stage.number}</span>

              <div>
                <h3>{stage.title}</h3>
                <p>{stage.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="delivery-section">
    <div class="container">
      <div class="delivery-heading">
        <div>
          <p class="section-label">合作時間與形式</p>
          <h2>依據目標選擇合適的合作規模。</h2>
        </div>

        <p>
          方案可實體、線上或混合進行，並可依據學校時程、
          教師可用時間與學生需求進行調整。
        </p>
      </div>

      <div class="delivery-grid">
        {
          deliveryOptions.map((option, index) => (
            <article class="delivery-card">
              <span>{String(index + 1).padStart(2, "0")}</span>

              <h3>{option.title}</h3>

              <p>{option.description}</p>

              <div class="duration">
                <small>參考時程</small>
                <strong>{option.duration}</strong>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="custom-section">
    <div class="container custom-card">
      <div class="custom-copy">
        <p class="section-label">客製化合作</p>

        <h2>
          現有方案可組合、調整或重新設計。
        </h2>

        <p>
          例如，學校可以將課程檢視、教師培訓、人工智慧政策、
          學生韌性課程與方案評估整合為一個長期發展計畫。
        </p>
      </div>

      <div class="custom-features">
        <div>
          <span>01</span>
          <strong>依據學校目標調整</strong>
        </div>

        <div>
          <span>02</span>
          <strong>依據參與者能力分層</strong>
        </div>

        <div>
          <span>03</span>
          <strong>依據時程與資源規劃</strong>
        </div>

        <div>
          <span>04</span>
          <strong>依據證據持續修正</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-card">
      <div>
        <p class="eyebrow cta-eyebrow">規劃下一步</p>

        <h2>
          讓我們根據您的教育情境，
          設計最合適的合作方案。
        </h2>

        <p>
          請提供目前需求、參與對象、預期成果與時間範圍，
          以便進一步討論。
        </p>
      </div>

      <a href="/contact">聯絡 iBridge</a>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .page-hero {
    position: relative;
    overflow: hidden;
    padding: 112px 0 104px;
    background:
      linear-gradient(125deg, #f5faf9 0%, #e9f6f3 100%);
  }

  .hero-background {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-ring {
    position: absolute;
    display: block;
    border: 1px solid rgba(11, 102, 117, 0.17);
    border-radius: 999px;
  }

  .hero-ring-one {
    width: 540px;
    height: 540px;
    top: -300px;
    right: -110px;
  }

  .hero-ring-two {
    width: 260px;
    height: 260px;
    right: 260px;
    bottom: -175px;
  }

  .hero-rule {
    position: absolute;
    width: 720px;
    height: 1px;
    right: -120px;
    top: 58%;
    background: rgba(11, 102, 117, 0.16);
    transform: rotate(-16deg);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 90px;
    align-items: end;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 18px;
    color: #0b6675;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    color: #0a355b;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  h1 {
    font-size: clamp(3.1rem, 6.2vw, 5.7rem);
    line-height: 0.99;
  }

  h1 span {
    display: block;
    margin-top: 14px;
    color: #0b6675;
  }

  .hero-copy {
    display: grid;
    gap: 20px;
  }

  .hero-copy p,
  .overview-copy p,
  .process-intro > p,
  .delivery-heading > p,
  .custom-copy > p,
  .cta-card p {
    margin: 0;
    color: #587286;
    font-size: 1.03rem;
    line-height: 1.85;
  }

  .hero-button {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    margin-top: 10px;
    padding: 0 24px;
    border-radius: 999px;
    background: #0a4d70;
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
  }

  .overview-section,
  .programmes-section,
  .process-section,
  .delivery-section,
  .custom-section {
    padding: 104px 0;
  }

  .overview-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 90px;
  }

  .overview-grid h2,
  .section-heading h2,
  .process-intro h2,
  .delivery-heading h2,
  .custom-copy h2,
  .cta-card h2 {
    font-size: clamp(2.35rem, 4vw, 4.1rem);
    line-height: 1.08;
  }

  .overview-copy {
    display: grid;
    gap: 24px;
    padding-top: 34px;
  }

  .programmes-section {
    background: #f7fafb;
  }

  .section-heading {
    max-width: 930px;
    margin-bottom: 50px;
  }

  .programme-list {
    display: grid;
    gap: 22px;
  }

  .programme-card {
    padding: 38px;
    border: 1px solid rgba(10, 53, 91, 0.1);
    border-radius: 24px;
    background: #ffffff;
    box-shadow: 0 18px 48px rgba(10, 53, 91, 0.045);
  }

  .programme-top {
    display: grid;
    grid-template-columns: 58px 1fr;
    gap: 20px;
    align-items: start;
  }

  .programme-number {
    padding-top: 8px;
    color: #0b6675;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .programme-subtitle {
    margin: 0 0 7px;
    color: #6c8495;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .programme-card h3 {
    margin: 0;
    color: #123e60;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.65rem, 2.4vw, 2.25rem);
  }

  .programme-description {
    max-width: 940px;
    margin: 25px 0 30px 78px;
    color: #5d7588;
    line-height: 1.8;
  }

  .programme-details {
    display: grid;
    grid-template-columns: 0.9fr 1.2fr 0.9fr;
    gap: 34px;
    margin-left: 78px;
    padding-top: 28px;
    border-top: 1px solid rgba(10, 53, 91, 0.1);
  }

  .programme-details h4 {
    margin: 0 0 16px;
    color: #163f60;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
  }

  .programme-details ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .programme-details li {
    position: relative;
    padding-left: 15px;
    color: #536e82;
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .programme-details li::before {
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: #0b6675;
    content: "";
  }

  .format-list li {
    display: inline-flex;
    width: fit-content;
    padding: 7px 12px;
    border-radius: 999px;
    background: #edf7f5;
    color: #0a5e6d;
  }

  .format-list li::before {
    display: none;
  }

  .process-section {
    background: #082f52;
  }

  .process-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 86px;
  }

  .light-label {
    color: #78d1ca;
  }

  .process-intro h2 {
    color: #ffffff;
  }

  .process-intro > p {
    margin-top: 26px;
    color: #c1d0dc;
  }

  .stage-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stage-list li {
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 18px;
    padding: 23px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
  }

  .stage-list li:first-child {
    border-top: 0;
  }

  .stage-list li > span {
    color: #78d1ca;
    font-size: 0.73rem;
    font-weight: 800;
  }

  .stage-list h3 {
    margin: 0 0 8px;
    color: #ffffff;
    font-size: 1.12rem;
  }

  .stage-list p {
    margin: 0;
    color: #becdd9;
    line-height: 1.7;
  }

  .delivery-section {
    background: #f7fafb;
  }

  .delivery-heading {
    display: grid;
    grid-template-columns: 1fr 0.75fr;
    gap: 70px;
    align-items: end;
    margin-bottom: 48px;
  }

